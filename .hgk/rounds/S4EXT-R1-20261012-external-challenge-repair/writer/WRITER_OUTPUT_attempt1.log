 126:         def _git_tracked(root: Path, *, ceiling: str | None = None) -> tuple[int, int]:
 127:             env = dict(_os.environ)
 128:             if ceiling is not None:
 129:                 env["GIT_CEILING_DIRECTORIES"] = ceiling
 130:             r = sp.run(["git", "-C", str(root), "ls-files"], capture_output=True, text=True, env=env)
 131:             return r.returncode, len([l for l in r.stdout.splitlines() if l.strip()])
 132: 
 133:         def _git_tracked_paths(root: Path) -> list[str]:
 134:             # The raw subject the `.git`-internals guard inspects: the exact tracked path list.
 135:             r = sp.run(["git", "-C", str(root), "ls-files"], capture_output=True, text=True)
 136:             if r.returncode != 0:
 137:                 return []
 138:             return [l for l in r.stdout.splitlines() if l.strip()]
 139: 
 140:         # (a) On a real git checkout the probe must report EXACTLY the git-tracked count, never
