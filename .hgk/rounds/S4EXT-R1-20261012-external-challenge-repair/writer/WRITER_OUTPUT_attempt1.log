 101:     def test_tracked_file_metric_excludes_vcs_internals(self) -> None:
 102:         """Pin the oracle for `_tracked_file_count` in BOTH subjects it must serve (R2-E2).
 103: 
 104:         The shipped probe in `src/pipd_ls_sp/cli.py::_tracked_file_count` is the authoritative
 105:         definition: it returns `git ls-files` when the subject IS a git checkout, and otherwise the
 106:         count of files in the tree EXCLUDING `.git/` and `__pycache__/`. The old test asserted only
 107:         the first branch against an unconditional `git ls-files` literal. That made the oracle
 108:         subject-incorrect: in a non-git fresh copy the walk branch runs, git prints 0, and the test
 109:         FAILED (R2-E2). The oracle is rebound to the probe's own defined behavior for the subject at
 110:         hand, so it holds in both environments. It is not relaxed: each branch is pinned EXACTLY to
 111:         the authoritative count (equality, not inequality), the walk branch is additionally pinned
 112:         to exclude `.git/` internals and `__pycache__/` on a synthetic tree, and no magic constant
 113:         is used.
 114:         """
 115:         import os as _os
 116:         import shutil as _sh
 117:         import subprocess as sp
 118:         import tempfile as _tf
 119:         from pipd_ls_sp.cli import _tracked_file_count
