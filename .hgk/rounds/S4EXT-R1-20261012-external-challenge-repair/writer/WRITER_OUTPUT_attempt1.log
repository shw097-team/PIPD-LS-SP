diff --git a/tests/test_s4ext_artifact_reproducibility.py b/tests/test_s4ext_artifact_reproducibility.py
new file mode 100644
index 0000000000000000000000000000000000000000..c6f4ca0541bae75fc623e15622f182fcbd7f40cd
--- /dev/null
+++ b/tests/test_s4ext_artifact_reproducibility.py
@@ -0,0 +1,113 @@
+"""Guard the reproducible-generation-identity and stay-out-of-the-tree repairs (S4EXT-R1 FAR).
+
+Four read-only invariants:
+
+* T1 the technology-admission artefact can be regenerated byte-for-byte when the generation identity
+  is pinned with ``--for-commit``, and regeneration never rewrites the tracked artefact;
+* T2 the mandated history secret scan can be pointed OUT of the tracked tree with ``--out``;
+* T3 the new digest verifier makes stale recorded digests visible (report-only by default);
+* T4 the ``candidate_head`` recorded in the tracked artefact is an ancestor of HEAD.
+
+Every subprocess writes into a temporary directory so that running the suite leaves the tracked tree
+byte-identical.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT / "src") not in sys.path:
+    sys.path.insert(0, str(ROOT / "src"))
+if str(ROOT / "tools") not in sys.path:
+    sys.path.insert(0, str(ROOT / "tools"))
+
+GENERATOR = ROOT / "tools" / "admit_technologies.py"
+SCANNER = ROOT / "tools" / "history_secret_scan.py"
+VERIFIER = ROOT / "tools" / "verify_evidence_digests.py"
+TRACKED_ADMISSIONS = ROOT / ".hgk" / "artifacts" / "s1" / "TECHNOLOGY_ADMISSIONS.json"
+TRACKED_SCAN = ROOT / ".hgk" / "artifacts" / "history_secret_scan.json"
+TRACKED_MANIFEST = ROOT / ".hgk" / "artifacts" / "evidence_manifest.json"
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+class ArtifactReproducibility(unittest.TestCase):
+    def test_t1_reproducible_generation_identity(self) -> None:
+        """Pinning ``--for-commit`` must make two runs byte-identical and leave the tracked file alone."""
+        before = _sha256(TRACKED_ADMISSIONS)
+        identity = json.loads(TRACKED_ADMISSIONS.read_text(encoding="utf-8"))["candidate_head"]
+        outputs = []
+        with tempfile.TemporaryDirectory() as a, tempfile.TemporaryDirectory() as b:
+            for sandbox in (a, b):
+                tmp_artifact = Path(sandbox) / "TECHNOLOGY_ADMISSIONS.json"
+                tmp_artifact.write_bytes(TRACKED_ADMISSIONS.read_bytes())
+                proc = subprocess.run(
+                    [sys.executable, str(GENERATOR), "--artifact", str(tmp_artifact),
+                     "--for-commit", identity],
+                    capture_output=True, text=True)
+                # The tool exits non-zero because the honest hard gate (G-TECH-SOURCE-PIN) FAILs;
+                # reproducibility is about the emitted bytes, not the exit code.
+                self.assertIn("candidate_head", proc.stdout, proc.stderr[-400:])
+                outputs.append(tmp_artifact.read_bytes())
+        self.assertEqual(outputs[0], outputs[1], "the artefact was not reproducible byte-for-byte")
+        self.assertEqual(json.loads(outputs[0])["candidate_head"], identity)
+        self.assertEqual(_sha256(TRACKED_ADMISSIONS), before,
+                         "the tracked technology-admission artefact was rewritten")
+
+    def test_t2_scanner_stays_out_of_the_tree(self) -> None:
+        """``--out`` must redirect the scan so the tracked scan artefact is never touched."""
+        before = _sha256(TRACKED_SCAN)
+        with tempfile.TemporaryDirectory() as sandbox:
+            out = Path(sandbox) / "hss.json"
+            subprocess.run([sys.executable, str(SCANNER), "--out", str(out)],
+                           capture_output=True, text=True)
+            self.assertTrue(out.is_file(), "the scan artefact was not written to --out")
+            payload = json.loads(out.read_text(encoding="utf-8"))
+            self.assertIn("verdict", payload)
+        self.assertEqual(_sha256(TRACKED_SCAN), before,
+                         "the tracked history-secret-scan artefact was rewritten")
+
+    def test_t3_the_verifier_detects_staleness(self) -> None:
+        """A corrupted recorded digest must surface under ``stale`` (report-only, exit 0)."""
+        entries = json.loads(TRACKED_MANIFEST.read_text(encoding="utf-8"))
+        target = next(rel for rel in sorted(entries) if (ROOT / rel).is_file())
+        with tempfile.TemporaryDirectory() as sandbox:
+            corrupt = Path(sandbox) / "manifest.json"
+            mutated = dict(entries)
+            mutated[target] = "0" * 64
+            corrupt.write_text(json.dumps(mutated), encoding="utf-8")
+            proc = subprocess.run([sys.executable, str(VERIFIER), "--manifest", str(corrupt)],
+                                  capture_output=True, text=True)
+            self.assertEqual(proc.returncode, 0, proc.stderr[-400:])
+            report = json.loads(proc.stdout)
+            self.assertIn(target, report["stale"])
+
+        # The real manifest must NOT be asserted empty -- stale entries are a pre-existing condition
+        # this verifier only makes visible. It must exit 0 without ``--strict``.
+        proc = subprocess.run([sys.executable, str(VERIFIER)], capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 0, proc.stderr[-400:])
+        report = json.loads(proc.stdout)
+        for key in ("checked", "match", "missing", "stale", "identity_checks"):
+            self.assertIn(key, report)
+
+    def test_t4_recorded_identity_is_an_ancestor(self) -> None:
+        if shutil.which("git") is None:
+            self.skipTest("git is unavailable")
+        identity = json.loads(TRACKED_ADMISSIONS.read_text(encoding="utf-8"))["candidate_head"]
+        proc = subprocess.run(["git", "merge-base", "--is-ancestor", identity, "HEAD"],
+                              cwd=str(ROOT), capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 0,
+                         f"recorded candidate_head {identity!r} is not an ancestor of HEAD")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
