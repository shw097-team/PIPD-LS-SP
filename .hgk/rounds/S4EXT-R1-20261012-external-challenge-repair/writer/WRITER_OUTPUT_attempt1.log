+                               "--report", "--artifact", str(tmp_artifact)],
+                              capture_output=True, text=True)
+        return proc.returncode, json.loads(proc.stdout)
+    finally:
+        shutil.rmtree(sandbox, ignore_errors=True)
 
 
 def _report_with_row(mutate) -> dict:
