 121:         def _walk_count(root: Path) -> int:
 122:             # The probe's non-git branch, stated independently of the implementation.
 123:             return sum(1 for p in root.rglob("*") if p.is_file()
 124:                        and ".git" not in p.parts and "__pycache__" not in p.parts)
