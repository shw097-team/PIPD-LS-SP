.hgk\rounds\POSTRELEASE-20261011-s4-narrow-repair\verify\VERIFY2_RECEIPT_gpt61sol.md:16357:    "source": "from harness import *\nimport harness\nharness.DB=S/'phase2checks.json'\nharness.checks=[]\nimport zipfile,copy\nPW='C:/Users/user/.cache/codex-runtimes/codex-primary-runtime/dependencies/native/powershell/pwsh.exe'\nBASH='C:/Program Files/Git/usr/bin/bash.exe'\nreadme=(R/'README.md').read_text(encoding='utf-8')\nfor lang,suffix in [('bash','sh'),('powershell','ps1')]:\n    block=next(b for b in re.findall(r'^```'+lang+r'[^\\n]*\\n(.*?)^```\\s*$',readme,re.M|re.S) if ('Get-FileHash' in b if lang=='powershell' else 'SHA256SUMS' in b))\n    (S/('extracted.'+suffix)).write_text(block,encoding='utf-8')\nprint('Extracted exact fenced blocks',flush=True)\n# Offline dependency wheel cache: inspect only ZIP .body cache entries; no HTTP metadata.\nwh=S/'wheelhouse'; wh.mkdir(exist_ok=True)\nwanted={'attrs','jsonschema','jsonschema_specifications','referencing','rpds_py'}\nfor p in Path('C:/Users/user/AppData/Local/pip/Cache/http-v2').rglob('*.body'):\n    if not zipfile.is_zipfile(p): continue\n    try:\n        with zipfile.ZipFile(p) as z:\n            w=next((n for n in z.namelist() if n.endswith('.dist-info/WHEEL')),None)\n            if not w: continue\n            stem=w.split('/')[0][:-10]; name=stem.rsplit('-',1)[0]\n            if name not in wanted: continue\n            tag=re.search(r'^Tag: (.+)$',z.read(w).decode(),re.M).group(1).strip()\n            if 'cp3' in tag and 'cp311' not in tag: continue\n            target=wh/(stem+'-'+tag+'.whl'); shutil.copyfile(p,target)\n            print('offline wheel',target.name,hashlib.sha256(target.read_bytes()).hexdigest(),flush=True)\n    except Exception as exc: print(type(exc).__name__,flush=True)\n# Genuine pip-less Python runtime cloned into scratch, with ensurepip absent.\nrt=S/'pipless-runtime'; rt.mkdir(exist_ok=True)\nhome=Path(P).parent\nfor p in home.glob('*.dll'): shutil.copyfile(p,rt/p.name)\nshutil.copyfile(home/'python.exe',rt/'python.exe')\nfor d in ['DLLs','Lib']:\n    shutil.copytree(home/d,rt/d,ignore=shutil.ignore_patterns('site-packages','ensurepip','__pycache__','test','tests'),dirs_exist_ok=True)\nrun('pipless_identity',[str(rt/'python.exe'),'-c',\"import sys,importlib.util; print(sys.version); print(sys.base_prefix); print('ensurepip=',importlib.util.find_spec('ensurepip')); print('pip=',importlib.util.find_spec('pip'))\"],cwd=S,env=dict(E,PYTHONPATH=''))\n# bash curl wrapper permits wheel fetch only; checksum response is locally supplied.\nshim=S/'transport'; shim.mkdir(exist_ok=True)\nwheel='pipd_ls_sp-0.1.0-py3-none-any.whl'\nurl='https://github.com/shw097-team/PIPD-LS-SP/releases/download/v0.1.0-preview.2/'+wheel\nsha='d6c3e295f817b50108b1232a120564c18b517864ad1ad19c4f8d915f396d364f'\n(shim/'curl').write_text('#!/usr/bin/env bash\\ncase \"${@: -1}\" in\\n'+url+') /usr/bin/curl \"$@\" ;;\\n*/SHA256SUMS) printf \"'+sha+'  '+wheel+'\\\\n\" > SHA256SUMS; echo \"LOCAL_CHECKSUM_RESPONSE (network restriction)\" ;;\\n*) exit 97 ;;\\nesac\\n',encoding='utf-8')\n# PowerShell bootstrap intercepts just SHA256SUMS, then dot-sources the unmodified extracted block.\npswrap=S/'ps-wrapper.ps1'\npswrap.write_text('''function Invoke-WebRequest {\nparam([string]$Uri,[string]$OutFile)\nif ($Uri -eq \"'''+url+'''\") { Microsoft.PowerShell.Utility\\\\Invoke-WebRequest -Uri $Uri -OutFile $OutFile }\nelseif ($Uri.EndsWith('/SHA256SUMS')) { \"'''+sha+'  '+wheel+'''\" | Set-Content -LiteralPath $OutFile; \"LOCAL_CHECKSUM_RESPONSE (network restriction)\" }\nelse { throw 'Forbidden network URL' }\n}\n. \"'''+str(S/'extracted.ps1')+'\"\\n',encoding='utf-8')\nfor shell in ['bash','ps']:\n    for mode,python_dir in [('pipless',rt),('working',home)]:\n        wd=S/(shell+'-'+mode); wd.mkdir(exist_ok=True)\n        env=dict(E,PYTHONPATH='',PATH=str(shim)+os.pathsep+str(python_dir)+os.pathsep+os.environ['PATH'],PIP_FIND_LINKS=str(wh))\n        args=[BASH,'-x',str(S/'extracted.sh')] if shell=='bash' else [PW,'-NoProfile','-File',str(pswrap)]\n        run(shell+'_'+mode,args,cwd=wd,env=env)\n        vp=wd/'.venv/Scripts/python.exe'\n        if mode=='working' and vp.exists():\n            run(shell+'_install_location',[str(vp),'-c',\"import sys,pipd_ls_sp; print('prefix=',sys.prefix); print('module=',pipd_ls_sp.__file__); assert '.venv' in pipd_ls_sp.__file__\"],cwd=wd,env=dict(env,PYTHONPATH=''))\n# Native-exit minimal proof.\nmini=S/'native-stop.ps1'\nmini.write_text(\"$ErrorActionPreference = 'Stop'\\n\\\"PSVersion=$($PSVersionTable.PSVersion) nativePreference=$PSNativeCommandUseErrorActionPreference\\\"\\n& '\"+P+\"' -c 'import sys; sys.exit(7)'\\n\\\"CONTINUED nativeExit=$LASTEXITCODE\\\"\\n\",encoding='utf-8')\nrun('native_stop_only',[PW,'-NoProfile','-File',str(mini)],cwd=S)\n# Run real self-bootstrap driver exactly three times; capture digest records immediately.\nfor label,rootname in [('same1','sb-a'),('same2','sb-a'),('other','sb-b')]:\n    run('selfbootstrap_'+label,[P,str(R/'examples/self-bootstrap/run_selfbootstrap.py'),'--root',str(S/rootname)])\n    digest=(R/'examples/self-bootstrap/digests.json').read_text(encoding='utf-8')\n    (S/('digests-'+label+'.json')).write_text(digest,encoding='utf-8')\nrun('selfbootstrap_status',['git','status','--porcelain','--','examples/self-bootstrap/digests.json','examples/self-bootstrap/negative_stale_context.txt'])\n\n"
.hgk\rounds\POSTRELEASE-20261011-s4-narrow-repair\verify\VERIFY2_RECEIPT_gpt61sol.md:16392:    "source": "set -e                             # stop at the first failing step; no step fails silently\n# 1. Fetch the published wheel and the checksum list, from the immutable tag.\nBASE=https://github.com/shw097-team/PIPD-LS-SP/releases/download/v0.1.0-preview.2\ncurl -fsSLO \"$BASE/pipd_ls_sp-0.1.0-py3-none-any.whl\"\ncurl -fsSLO \"$BASE/SHA256SUMS\"\n\n# 2. Verify the bytes. Check exactly what step 1 downloaded: SHA256SUMS lists three assets, but\n#    only the wheel is present here, so select its line. This is the ONLY integrity check offered:\n#    there is no install-time or startup cryptographic readback, and no release signature.\n#    Published wheel digest: d6c3e295f817b50108b1232a120564c18b517864ad1ad19c4f8d915f396d364f\ngrep '  pipd_ls_sp-0.1.0-py3-none-any.whl$' SHA256SUMS | sha256sum -c -\n#    expect: pipd_ls_sp-0.1.0-py3-none-any.whl: OK\n#    Alternative, only after fetching EVERY asset SHA256SUMS lists, the whole file checks clean:\n#      curl -fsSLO \"$BASE/pipd-ls-sp-v0.1.0-preview.2-source.zip\"\n#      curl -fsSLO \"$BASE/PREVIEW_NOTES_v0.1.0-preview.2.md\"\n#      sha256sum -c SHA256SUMS       # expect three \": OK\" lines (wheel, source zip, notes)\n\n# 3. Install into a virtual environment.\npython -m venv .venv\n. .venv/bin/activate 2>/dev/null || . .venv/Scripts/activate   # POSIX: .venv/bin/ ; Windows: .venv/Scripts/\npython -m pip install ./pipd_ls_sp-0.1.0-py3-none-any.whl\n\n# 4. Check the install, then use it.\npipd doctor                        # expect: {\"verdict\": \"PASS\", ...}\npipd --help                        # 13 commands\n\n# 5. Start a project. Both of these lines were executed against the published wheel.\npipd --root ./myproject init      # -> exit 0; creates docs/ schemas/ src/ tests/ dist/\npipd doctor                       # -> {\"verdict\": \"PASS\", ...}, and it names the schema source it resolved\n"
