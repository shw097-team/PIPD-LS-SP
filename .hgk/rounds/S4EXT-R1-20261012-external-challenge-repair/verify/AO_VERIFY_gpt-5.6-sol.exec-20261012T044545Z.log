   1: #!/usr/bin/env python3
   2: """WO-S4-TQAEP-004 / F-R5-05: design-time TQAEP is a DESIGN ceiling, never independent acceptance.
   3: 
   4: Before this repair `compile_tqaep()` emitted `acceptance = [{"case": "INDEPENDENT_CASE_PASS", ...}]`
   5: - a *receipt string* presented as if it were independent verification, so the UAT only ever exercised
   6: the refusal path. These tests pin the honest behaviour: a legal design-time call exits 0, carries the
   7: `TQAEP_DESIGNED` ceiling, and never lets a receipt string become an independence token; the three
   8: typed refusals are unchanged.
   9: 
  10: The CLI is driven in-process via `cli.main()` (the same dispatcher, exit code and stdout envelope the
  11: `python3 -B -m pipd_ls_sp.cli compile-tqaep ...` command produces); spawning a fresh interpreter per
  12: case is avoided only because this container's fresh-interpreter startup is pathologically slow.
  13: """
  14: from __future__ import annotations
  15: 
  16: import contextlib
  17: import io
  18: import json
  19: import sys
  20: import unittest
  21: from pathlib import Path
  22: 
  23: ROOT = Path(__file__).resolve().parents[1]
  24: sys.path.insert(0, str(ROOT / "src"))
  25: 
  26: from pipd_ls_sp import cli, pipeline  # noqa: E402
  27: 
  28: GOAL = "Implement the lifecycle compiler and verify it against the source spec."
  29: 
  30: 
  31: def _run_cli(*args: str):
  32:     """Invoke the real CLI dispatcher in-process; return (exit_code, parsed_stdout)."""
  33:     buf = io.StringIO()
  34:     with contextlib.redirect_stdout(buf):
  35:         rc = cli.main(list(args))
  36:     text = buf.getvalue().strip()
  37:     body = json.loads(text) if text else {}
  38:     return rc, body
  39: 
  40: 
  41: class TqaepDesignTime(unittest.TestCase):
  42:     @classmethod
  43:     def setUpClass(cls) -> None:
  44:         # The PI->PD->ECP fixture chain is built once: `bind_pd` runs a live repo probe
  45:         # (52s on this bind mount), so per-test setup would dominate the module.
  46:         card = pipeline.intake(GOAL, sources=[str(ROOT / "docs" / "S0_CONTRACT_SPEC.md")])
  47:         cls.pi = pipeline.compile_pi(card, "STANDARD")
  48:         pd = pipeline.bind_pd(cls.pi, {"root": str(ROOT), "writable_scope": "src/**"})
  49:         cls.ecp = pipeline.compile_ecp(pd, cls.pi)
  50:         cls.tmp = ROOT / ".hgk" / "artifacts" / "tqaep_design_tmp"
  51:         cls.tmp.mkdir(parents=True, exist_ok=True)
  52:         cls.pi_p = cls.tmp / "pi.json"
  53:         cls.ecp_p = cls.tmp / "ecp.json"
  54:         # S4EXT-R1 AO finding: these fixtures live inside the tracked tree, so regenerating them
  55:         # read as a transient candidate mutation during independent verification. Capture the bytes
  56:         # that are on disk BEFORE this module writes anything, and put them back afterwards, so the
  57:         # worktree is byte-identical when the module finishes.
  58:         cls._pre_existing = {p: p.read_bytes() for p in (cls.pi_p, cls.ecp_p) if p.is_file()}
  59:         cls.pi_p.write_text(json.dumps(cls.pi, ensure_ascii=False), encoding="utf-8")
  60:         cls.ecp_p.write_text(json.dumps(cls.ecp, ensure_ascii=False), encoding="utf-8")
  61: 
  62:     @classmethod
  63:     def tearDownClass(cls) -> None:
  64:         for path, original in getattr(cls, "_pre_existing", {}).items():
  65:             if not path.is_file() or path.read_bytes() != original:
  66:                 path.write_bytes(original)
  67: 
  68:     # (a) a legal design-time call exits 0 and is honest about what it established.
  69:     def test_legal_design_time_call_exits_zero_and_declares_design_ceiling(self) -> None:
  70:         rc, art = _run_cli("compile-tqaep", "--pi", str(self.pi_p), "--ecp", str(self.ecp_p),
  71:                            "--maker", "A", "--checker", "B",
  72:                            "--checker-receipt", "lane-B/live.log")
  73:         self.assertEqual(rc, 0)
  74:         acc = art["acceptance"]
  75:         self.assertEqual(art["subject_id"].split("-")[0], "TQAEP")
  76:         # The design-time ceiling is carried, and it is not an independence claim.
  77:         self.assertEqual(acc[0]["claim_ceiling"], pipeline.TQAEP_DESIGN_CEILING)
  78:         self.assertEqual(pipeline.TQAEP_DESIGN_CEILING, "TQAEP_DESIGNED")
  79:         self.assertEqual(acc[0]["independent_acceptance"], "NOT_GRANTED")
  80:         self.assertEqual(acc[0]["independent_proof_requires"], "S5_LIVE_RUNTIME_CHECKER")
