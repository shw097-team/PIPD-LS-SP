d/v0.1.0-preview.2/pipd_ls_sp-0.1.0-py3-none-any.whl\"\n    },\n    {\n      \"url\": \"https://api.github.com/repos/shw097-team/PIPD-LS-SP/releases/assets/629413045\",\n      \"id\": 629413045,\n      \"node_id\": \"RA_kwDOVBPaw84lhBS1\",\n      \"name\": \"PREVIEW_NOTES_v0.1.0-preview.2.md\",\n      \"label\": \"\",\n      \"uploader\": {\n        \"login\": \"shw097\",\n        \"id\": 219498218,\n        \"node_id\": \"U_kgDODRVG6g\",\n        \"avatar_url\": \"https://avatars.githubusercontent.com/u/219498218?v=4\",\n        \"gravatar_id\": \"\",\n        \"url\": \"https://api.github.com/users/shw097\",\n        \"html_url\": \"https://github.com/shw097\",\n        \"followers_url\": \"https://api.github.com/users/shw097/followers\",\n        \"following_url\": \"https://api.github.com/users/shw097/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/shw097/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/shw097/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/shw097/subscriptions\",\n        \"organizations_url\": \"https://api.github.com/users/shw097/orgs\",\n        \"repos_url\": \"https://api.github.com/users/shw097/repos\",\n        \"events_url\": \"https://api.github.com/users/shw097/events{/privacy}\",\n        \"received_events_url\": \"https://api.github.com/users/shw097/received_events\",\n        \"type\": \"User\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      },\n      \"content_type\": \"text/markdown\",\n      \"state\": \"uploaded\",\n      \"size\": 3491,\n      \"digest\": \"sha256:31b6801090932c8ffb13d8b6096a47d272b9e646819ef89d52724f3e09c63adb\",\n      \"download_count\": 4,\n      \"created_at\": \"2026-10-11T01:03:25Z\",\n      \"updated_at\": \"2026-10-11T01:03:25Z\",\n      \"browser_download_url\": \"https://github.com/shw097-team/PIPD-LS-SP/releases/download/v0.1.0-preview.2/PREVIEW_NOTES_v0.1.0-preview.2.md\"\n    },\n    {\n      \"url\": \"https://api.github.com/repos/shw097-team/PIPD-LS-SP/releases/assets/629413024\",\n      \"id\": 629413024,\n      \"node_id\": \"RA_kwDOVBPaw84lhBSg\",\n      \"name\": \"SHA256SUMS\",\n      \"label\": \"\",\n      \"uploader\": {\n        \"login\": \"shw097\",\n        \"id\": 219498218,\n        \"node_id\": \"U_kgDODRVG6g\",\n        \"avatar_url\": \"https://avatars.githubusercontent.com/u/219498218?v=4\",\n        \"gravatar_id\": \"\",\n        \"url\": \"https://api.github.com/users/shw097\",\n        \"html_url\": \"https://github.com/shw097\",\n        \"followers_url\": \"https://api.github.com/users/shw097/followers\",\n        \"following_url\": \"https://api.github.com/users/shw097/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/shw097/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/shw097/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/shw097/subscriptions\",\n        \"organizations_url\": \"https://api.github.com/users/shw097/orgs\",\n        \"repos_url\": \"https://api.github.com/users/shw097/repos\",\n        \"events_url\": \"https://api.github.com/users/shw097/events{/privacy}\",\n        \"received_events_url\": \"https://api.github.com/users/shw097/received_events\",\n        \"type\": \"User\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      },\n      \"content_type\": \"text/plain\",\n      \"state\": \"uploaded\",\n      \"size\": 305,\n      \"digest\": \"sha256:bc3b9be966ff0bb737417e1f3efbdde3423cbe6ee465bda1deed43c3dad2754c\",\n      \"download_count\": 4,\n      \"created_at\": \"2026-10-11T01:03:24Z\",\n      \"updated_at\": \"2026-10-11T01:03:24Z\",\n      \"browser_download_url\": \"https://github.com/shw097-team/PIPD-LS-SP/releases/download/v0.1.0-preview.2/SHA256SUMS\"\n    }\n  ],\n  \"tarball_url\": \"https://api.github.com/repos/shw097-team/PIPD-LS-SP/tarball/v0.1.0-preview.2\",\n  \"zipball_url\": \"https://api.github.com/repos/shw097-team/PIPD-LS-SP/zipball/v0.1.0-preview.2\",\n  \"body\": \"# PIPD-LS-SP v0.1.0-preview.2\\n\\n**This is a repaired successor to `v0.1.0-preview.1`, not a rewrite of it.** `v0.1.0-preview.1` is left\\nexactly as published; this tag supersedes it, as the owner grant requires.\\n\\n## What is in these bytes\\n\\n| | |\\n|---|---|\\n| Wheel | `pipd_ls_sp-0.1.0-py3-none-any.whl` |\\n| Wheel sha256 | `d6c3e295f817b50108b1232a120564c18b517864ad1ad19c4f8d915f396d364f` |\\n| Built from commit | `1ab17d1eac02a86eda0770cb7dcf25b1a4389c6c` |\\n| Licence | Apache-2.0 |\\n\\n## What changed relative to v0.1.0-preview.1\\n\\n`v0.1.0-preview.1` shipped with two defects that made the core chain unusable from an installed wheel\\noutside the source tree. Both are repaired in these bytes:\\n\\n1. **CE-1 - `validate` could not find the schemas it shipped with.** Schema resolution is now\\n   `OVERRIDE -> INSTALLED -> SOURCE`, so a wheel installed into a clean virtual environment resolves\\n   the schemas packaged *inside the wheel* and reports where it found them.\\n2. **CE-2 - the compilers' own stdout was not schema-valid.** A non-record sidecar\\n   (`_profile_meta`) was being emitted into records the schemas reject. The hash-exclusion set and\\n   the stripped-sidecar set are now separate, so the compilers' own stdout validates.\\n3. **CE-CODEX-TRACE-WIDENING** - an undeclared `trace` key was accepted on `PD-PKG`/`ECP`/`TQAEP`.\\n   It is now rejected by `additionalProperties` and named in the findings.\\n\\nThe wheel bytes themselves were unchanged between v0.1.0-preview.1 and this tag for the packaging layer;\\nwhat changed is the library code inside it.\\n\\n## DEL-018 is closed in this tree\\n\\n`RELEASE_MANIFEST@1` had failed since the R3 crosswalk: the publication projection carried no\\ndisposition for every product path in the tree. It now dispositions 252/252 with zero violations and\\n`--check --current` exits 0. The regeneration removed 1085 stale `.hgk/` round-artifact entries and\\n**no product path**; that is asserted mechanically, because a manifest that covers less would also\\npass.\\n\\n## Claim ceiling - read this before quoting anything here\\n\\nPublished capability: `OWNER_AUTHORIZED_OPEN_SOURCE_PREVIEW_BETA_PUBLISHED`.\\n\\nThis is **not** a full gate pass. Not granted, and must not be quoted as granted:\\n`FULL_S0_S4_INDEPENDENT_PASS`, `G_RELEASE_FULL_PASS`, `PRODUCTION_VERIFIED`, `S5_RUNTIME_READY`,\\n`ALL_HOSTS_LIVE_CERTIFIED`. No release signature or build attestation by an external signing\\nidentity is attached, and no host-native (S5-S8) certification has been performed.\\n\\n## Known limitations\\n\\n1. The preview is an S4-stage open-source preview, not a production release.\\n2. DEL-018 is closed in this tree; the superseded tag's failure remains on record against it.\\n3. The default publication attestation sidecar in the tree attests an R3-era subject, not this tag.\\n4. No dependency-vulnerability scan result is claimed for this tag beyond the factory scans below.\\n5. `pip install` from PyPI is not offered; take the wheel from this release and verify its hash.\\n6. Windows-first: the tooling is verified on Windows with CPython 3.11; other hosts are untested.\\n7. The `Doctor`/composition surfaces remain the documented S0-S4 scope, not the full S5-S8 chain.\\n\\n## Factory evidence carried with this tag\\n\\n- history secret scan over 2339 objects and the worktree: 0 hits, CLEAN\\n- deny-list scan: PASS, 0 writer usages inside the R4 scope\\n- full test suite on the release tree: see the round record\\n- licence: Apache-2.0, with the corpus-derived vs agent-authored split kept in `NOTICE`\\n\"\n}\n",
