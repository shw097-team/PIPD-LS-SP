180:def closure_findings(bundle: dict[str, dict[str, Any]]) -> dict[str, Any]:
181:    """Atomic graph closure over the bundle's trace edges (S4EXT-R1 TT-S4EXT-002 / F002).
182:
183:    ``state`` is one of:
184:
185:    * ``SCHEMA_ONLY`` - the bundle carries NO trace edge, so no graph relation exists to close.
186:      This is a legal PARTIAL bundle (e.g. a scoped validate of LITE artifacts). It is labelled
187:      explicitly so a caller can never read a schema-only result as a trace-closed one.
188:    * ``FULL`` - every edge resolved: both endpoints exist inside the bundle and both recorded
189:      hashes equal the real endpoint hashes.
190:    * ``FAILED`` - at least one orphan endpoint or hash mismatch; a finding is emitted per problem.
191:      A bundle in this state can never return PASS.
192:
193:    The closure REUSES ``pipeline.trace_closure`` (the C-10 repair that recomputes both sides of
194:    every edge) rather than introducing a second trace engine.
195:    """
196:    records = {k: v for k, v in bundle.items() if isinstance(v, dict)}
197:    edge_count = sum(len(trace_edges(r)) for r in records.values())
198:    if edge_count == 0:
199:        return {"state": "SCHEMA_ONLY", "edges": 0, "findings": []}
200:    from . import pipeline  # local import: pipeline imports this module for the shared field lists
201:    try:
202:        report = pipeline.trace_closure(records)
203:    except Exception as exc:  # fail closed: an unclosable graph is not a closed graph
204:        return {"state": "FAILED", "edges": edge_count,
205:                "findings": [{"contract": "*", "kind": "CLOSURE",
206:                              "detail": f"trace closure could not be computed: {exc!r}"}]}
207:    problems: list[str] = []
208:    # S4EXT-R1 external-AO finding C3: a syntactically valid endpoint whose declared TYPE
209:    # contradicts the family of the record its id actually resolves to must fail closed. Without
210:    # this, "PD-PKG/from" could point at a PI-PKG record and still be reported as a closed graph.
211:    family_of: dict[str, str] = {}
212:    for name, rec in records.items():
213:        fam = str(rec.get("schema_version") or "").split("@")[0] or name
214:        if rec.get("subject_id"):
215:            family_of[str(rec["subject_id"])] = fam
216:        for atom in (rec.get("stable_semantic_contract", {}) or {}).get("atoms", []) or []:
217:            if isinstance(atom, dict) and atom.get("subject_id"):
218:                # an atom declares its OWN family (RequirementAtom@1), not the parent's
219:                afam = str(atom.get("schema_version") or "").split("@")[0] or fam
220:                family_of[str(atom["subject_id"])] = afam
221:    for _name, rec in records.items():
222:        for edge in trace_edges(rec):
223:            for side in ("from", "to"):
224:                declared = edge.get(f"{side}_type")
225:                resolved = family_of.get(str(edge.get(f"{side}_id") or ""))
226:                if declared and resolved and str(declared) != resolved:
227:                    problems.append(
228:                        "endpoint type contradicts the resolved record family: "
229:                        f"{side}_type={declared} but {side}_id={edge.get(f'{side}_id')} "
230:                        f"resolves to {resolved}")
231:    for orphan in report.get("orphans") or []:
232:        problems.append(f"orphan trace endpoint: {orphan} is not present in the bundle")
233:    for bad in report.get("bad_hashes") or []:
234:        problems.append(f"trace endpoint hash mismatch: {bad}")
235:    if report.get("verdict") != "PASS" and not problems:
236:        problems.append("trace closure did not reach PASS over the bundle")
237:    return {"state": "FULL" if not problems else "FAILED", "edges": int(report.get("edges") or edge_count),
238:            "findings": [{"contract": "*", "kind": "CLOSURE", "detail": p} for p in problems]}
239:
240:
241:def validate_bundle(bundle: dict[str, dict[str, Any]], schemas_dir: Path | None = None) -> dict[str, Any]:
242:    findings: list[dict[str, str]] = []
243:    # C-4 repair: validate_bundle({}) used to return PASS with checked=0. An empty denominator is
244:    # not a verification result.
245:    if not bundle:
246:        return {"verdict": "FAIL", "checked": 0, "closure": "SCHEMA_ONLY",
247:                "findings": [{"contract": "*", "kind": "DENOMINATOR",
248:                              "detail": "empty bundle: zero records checked cannot be a PASS"}]}
249:    for contract, record in bundle.items():
250:        if not isinstance(record, dict):
251:            findings.append({"contract": contract, "kind": "SCHEMA",
252:                             "detail": "record must be an object"})
253:            continue
254:        for f in validate_record(contract, record, schemas_dir):
255:            findings.append({"contract": contract, "kind": "SCHEMA", "detail": f})
256:        for f in semantic_invariants(contract, record):
257:            findings.append({"contract": contract, "kind": "SEMANTIC", "detail": f})
258:    # TT-S4EXT-002: `pipd validate --bundle` used to stop at the per-record schema/semantic checks,
259:    # so a bad endpoint hash, an orphan edge or a missing endpoint could still return PASS even
260:    # though pipeline.trace_closure() already knew how to refuse it. The closure is now part of the
261:    # bundle verdict, and a bundle with no trace edge is labelled SCHEMA_ONLY rather than passed off
262:    # as trace-closed.
263:    closure = closure_findings(bundle)
264:    findings.extend(closure["findings"])
265:    return {"verdict": "PASS" if not findings else "FAIL",
266:            "checked": len(bundle), "closure": closure["state"], "findings": findings}
