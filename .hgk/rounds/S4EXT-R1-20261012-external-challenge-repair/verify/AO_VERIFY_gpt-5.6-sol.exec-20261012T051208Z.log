53:# ---------------------------------------------------------------- authority
54:def freeze_authority(manifest: dict[str, Any]) -> dict[str, Any]:
55:    families = manifest.get("families") if "families" in manifest else manifest
56:    if not families:
57:        raise AuthorityUnknown("no source families in manifest")
58:    bindings = []
59:    for fam, spec in sorted(families.items()):
60:        if not isinstance(spec, dict) or "manifest_sha256" not in spec:
61:            raise AuthorityUnknown(f"family {fam} lacks a manifest digest")
62:        if not spec.get("files"):
63:            raise AuthorityUnknown(f"family {fam} is empty")
64:        loc = spec["files"][0]["rel"]
65:        if not (Path(spec.get("root", "")) / loc).exists() and not Path(loc).exists():
66:            raise AuthorityUnknown(f"authority locator does not resolve on disk: {loc}")
67:        digest = spec["manifest_sha256"]
68:        if not re.match(r"^[0-9a-f]{64}$", str(digest)):
69:            raise AuthorityUnknown(f"family {fam} manifest digest is not a sha256: {digest!r}")
70:        rank = "R1" if fam.startswith(("F1", "F2", "F3", "F5", "F6")) else "R2"
71:        bindings.append(_rec("AuthorityBinding", "AUTH",
72:                             {"fam": fam, "digest": spec["manifest_sha256"]},
73:                             source_id=fam, authority_rank=rank,
74:                             locator=spec["files"][0]["rel"], supersession="CURRENT",
75:                             conflict_state="NONE"))
76:    payload = {"families": sorted(families), "digests": [b["content_hash"] for b in bindings]}
77:    freeze = _rec("SourceFreezeManifest", "SFM", payload,
78:                  families=len(bindings), bindings=bindings)
79:    return {"freeze": freeze, "bindings": bindings}
