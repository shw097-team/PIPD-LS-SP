82:# ---------------------------------------------------------------- intake
83:def intake(goal: str, *, sources: list[str] | None = None,
84:           constraints: list[str] | None = None, non_goals: list[str] | None = None) -> dict[str, Any]:
85:    """Intake compiles clause-bound atomic requirements (R-AUD-005).
86:
87:    The old five-keyword axis route is NO LONGER an authoritative path: atoms come from source
88:    clauses via req_compile.compile_requirements, so compound / negated / no-keyword requirements
89:    survive as distinct atoms instead of collapsing into keyword buckets.
90:    """
91:    if not goal or not goal.strip():
92:        raise IntakeInvalid("empty goal")
93:    sources = list(sources or [])
94:    if not sources:
95:        raise AuthorityUnknown("intake requires at least one source locator")
96:    for s in sources:
97:        if not Path(s).exists():
98:            raise AuthorityUnknown(f"source locator does not exist: {s}")
99:    payload = {"goal": goal.strip(), "sources": sources,
100:               "constraints": list(constraints or []), "non_goals": list(non_goals or [])}
101:    card = dict(payload)
102:    card["subject_id"] = content_id("INTENT", payload)
103:    card["content_hash"] = sha256_text(canonical_json(payload))
104:    card["schema_version"] = "IntentCard@1"
105:    card["atoms"] = req_compile.compile_requirements(goal.strip(), sources)
106:    return card
