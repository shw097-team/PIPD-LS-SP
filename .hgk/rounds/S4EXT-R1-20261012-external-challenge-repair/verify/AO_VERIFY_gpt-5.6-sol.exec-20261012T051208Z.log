168:def trace_edges(record: dict[str, Any]) -> list[dict[str, Any]]:
169:    """The trace edges a single record carries (PI-PKG nests them; TraceLink is one edge)."""
170:    if not isinstance(record, dict):
171:        return []
172:    trace = record.get("trace")
173:    if isinstance(trace, list):
174:        return [e for e in trace if isinstance(e, dict)]
