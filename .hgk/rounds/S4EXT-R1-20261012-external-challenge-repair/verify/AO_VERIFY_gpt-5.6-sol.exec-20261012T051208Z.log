66:def _bundle(repo: Path) -> dict:
67:    card = pipeline.intake(GOAL, sources=[str(repo)], constraints=["c1"], non_goals=["n1"])
68:    pi = pipeline.compile_pi(card, "LITE")
69:    pd = pipeline.bind_pd(pi, {"root": str(repo), "writable_scope": "src/**"})
70:    ecp = pipeline.compile_ecp(pd, pi)
71:    tqaep = pipeline.compile_tqaep(pi, ecp, maker=MAKER, checker=CHECKER,
72:                                   checker_execution_receipt=RECEIPT)
73:    return {"PI-PKG": pi, "PD-PKG": pd, "ECP": ecp, "TQAEP": tqaep}
