          assert mutated != text, "the mutation fixture no longer matches the checked-in document"
          doc.write_text(mutated, encoding="utf-8")
          PY
          set +e
          python -m unittest tests.test_s4ext_release_provenance > mutation-run.log 2>&1
          status=$?
          set -e
          git checkout -- dist/mount
          if [ "$status" -eq 0 ]; then
            echo "MUTATION_ACCEPTED: the provenance gate passed a tampered identity stamp" >&2
            tail -30 mutation-run.log >&2
            exit 1
          fi
          echo "MUTATION_REFUSED_AS_EXPECTED"

      - name: Upload raw logs
        if: always()
        uses: actions/upload-artifact@6f51ac03b9356f520e9adb1b1b7802705f340c2b  # v4.5.0
        with:
          name: ci-raw-logs
          path: |
            resolved-deps.txt
            full-unittest.log
            focused-s4ext.log
            wheel-doctor.log
            wheel-cli-help.log
            mutation-run.log
          if-no-files-found: warn
