#!/usr/bin/env python3
"""Recompute the per-entry sha256 recorded in the evidence manifest, classify every mismatch by the
bytes the digest was actually computed over, and report generation-identity ancestry.

Why this exists: nothing else recomputes the digest each entry of
``.hgk/artifacts/evidence_manifest.json`` claims for its file, and
``tools/build_publication_manifest.py`` folds those digests into ``crosswalk_digest``. A silent class
of drift (a file edited after the manifest was sealed) therefore stays invisible.

The gate (v2 -- a hash match against *some* basis is NOT sufficient). For each entry with path ``p``,
recorded digest ``r`` and on-disk bytes ``d``::

    normalize_eol(b) = b.replace(b"\\r\\n", b"\\n")               # CRLF -> LF

    basis digests, first match wins:
        disk                 sha256(d)
        crlf_disk            sha256(crlf(d)) or sha256(lf(d))
        head_blob            sha256(blob(p)@HEAD)
        crlf_head_blob       sha256(crlf(blob@HEAD)) or sha256(lf(blob@HEAD))
        candidate_blob       sha256(blob(p)@sealed_candidate)
        crlf_candidate_blob  sha256(crlf(blob@cand)) or sha256(lf(blob@cand))

    MATCH_RAW          sha256(d) == r.
    BENIGN_EOL         some basis ``x`` hashes to ``r`` AND normalize_eol(x) == normalize_eol(d):
                       a pure checkout / line-ending difference, never a failure.
    UNEXPLAINED_DRIFT  otherwise: ``p`` is missing, no basis hashes to ``r``, or a basis hashes to
                       ``r`` but its content is not EOL-equivalent to ``d`` -- the recorded digest
                       describes bytes that no longer describe the file, which is genuine drift.

The content-equality clause is MANDATORY. Accepting ``blob@candidate`` (or any crlf variant) on a
hash match alone would rubber-stamp a real post-seal content edit: the old snapshot still hashes to
the recorded digest even though the file has genuinely changed.

Byte transformations implemented, exactly (both directions; a ``crlf_*`` basis matches either)::

    crlf(b) = b.replace(b"\\r\\n", b"\\x00").replace(b"\\n", b"\\r\\n").replace(b"\\x00", b"\\r\\n")
              (lone LF -> CRLF)
    lf(b)   = b.replace(b"\\r\\n", b"\\n")                        (CRLF -> LF)

A file with no CRLF and no lone LF is unchanged by both, so ``disk`` wins for it.

The sealed candidate revision is read from the sibling seal (``<manifest stem>.seal.json`` ->
``candidate.candidate_tree_sha`` then ``candidate.repo_commit_sha``); it is never hard-coded. With no
sibling seal the candidate bases are simply unavailable.

Generation identity is REPORT-ONLY: for every JSON payload carrying ``candidate_head`` the report
records whether that revision is an ancestor of HEAD. A non-ancestor is named in the report and the
run still exits 0 without ``--strict`` (making it fatal was adjudicated a no-op / downgrade).

Writes nothing except the optional ``--json`` output path. The default run prints the full report and
exits 0; ``--strict`` exits 1 iff the unexplained set is non-empty; ``--json`` prints the compact
summary ``{"checked","match_raw","benign_eol","unexplained","basis_counts"}``. The full report keeps
the keys the existing in-tree test reads (``checked``, ``match``, ``missing``, ``stale``,
``identity_checks``).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MANIFEST = ROOT / ".hgk" / "artifacts" / "evidence_manifest.json"

# Ordered basis labels; the first one whose digest matches the recorded value names the bytes.
BASIS_LABELS = ("disk", "crlf_disk", "head_blob", "crlf_head_blob",
                "candidate_blob", "crlf_candidate_blob")


def _digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _crlf(data: bytes) -> bytes:
    """Expand every lone LF to CRLF (an existing CRLF is left alone)."""
    return data.replace(b"\r\n", b"\x00").replace(b"\n", b"\r\n").replace(b"\x00", b"\r\n")


def _lf(data: bytes) -> bytes:
    """Collapse every CRLF to LF."""
    return data.replace(b"\r\n", b"\n")


def _normalize_eol(data: bytes) -> bytes:
    return data.replace(b"\r\n", b"\n")


def _eol_variants(data: bytes) -> tuple[bytes, bytes]:
    return _crlf(data), _lf(data)


def _git(root: Path, *args: str, data: bytes | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(root), *args], input=data, capture_output=True)


def _read_blobs(root: Path, specs: list[str]) -> dict[str, bytes]:
    """Resolve many ``<rev>:<path>`` blob specs with ONE ``git cat-file --batch`` call.

    Only specs whose object exists are returned; a missing path is simply absent. When ``git`` is
    unavailable or the rev cannot be resolved the map is empty and the blob bases do not match.
    """
    if not specs:
        return {}
    proc = _git(root, "cat-file", "--batch",
                data="".join(f"{spec}\n" for spec in specs).encode("utf-8"))
    if proc.returncode != 0:
        return {}
    blobs: dict[str, bytes] = {}
    data, pos = proc.stdout, 0
    for spec in specs:
        try:
            end = data.index(b"\n", pos)
        except ValueError:
            break
        header = data[pos:end]
        if header.endswith(b" missing"):
            pos = end + 1
            continue
        fields = header.rsplit(b" ", 1)
        if len(fields) != 2:
            break
        size = int(fields[1])
        blobs[spec] = data[end + 1:end + 1 + size]
        pos = end + 1 + size + 1
    return blobs


def _sealed_revision(manifest_path: Path) -> str | None:
    """The sealed candidate tree (preferred) or commit from the manifest's sibling seal, if any."""
    seal = manifest_path.with_name(manifest_path.stem + ".seal.json")
    if not seal.is_file():
        return None
    try:
        payload = json.loads(seal.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, ValueError):
        return None
    candidate = payload.get("candidate") if isinstance(payload, dict) else None
    if not isinstance(candidate, dict):
        return None
    for key in ("candidate_tree_sha", "repo_commit_sha"):
        value = candidate.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def _verdict(basis_bytes: bytes, disk_bytes: bytes) -> str:
    """``benign_eol`` when a matching basis is EOL-equivalent to the disk bytes, else drift."""
    if _normalize_eol(basis_bytes) == _normalize_eol(disk_bytes):
        return "benign_eol"
    return "unexplained"


def _classify(rel: str, digest: str, root: Path, candidate_rev: str | None,
              blobs: dict[str, bytes]) -> tuple[str, str]:
    """Return ``(basis, verdict)`` for one manifest entry (see the module docstring's gate)."""
    target = root / rel
    if not target.is_file():
        return "unexplained", "unexplained"
    raw = target.read_bytes()
    if _digest(raw) == digest:
        return "disk", "match_raw"
    for variant in _eol_variants(raw):
        if _digest(variant) == digest:
            return "crlf_disk", _verdict(variant, raw)
    repo_bases = (("head_blob", "crlf_head_blob", f"HEAD:{rel}"),
                  ("candidate_blob", "crlf_candidate_blob",
                   f"{candidate_rev}:{rel}" if candidate_rev else None))
    for raw_label, eol_label, spec in repo_bases:
        if spec is None:
            continue
        blob = blobs.get(spec)
        if blob is None:
            continue
        if _digest(blob) == digest:
            return raw_label, _verdict(blob, raw)
        for variant in _eol_variants(blob):
            if _digest(variant) == digest:
                return eol_label, _verdict(variant, raw)
    return "unexplained", "unexplained"


def _identity_check(root: Path, rel: str, value: object) -> dict:
    """Report whether a recorded ``candidate_head`` is an ancestor of HEAD. Never raises."""
    rec: dict = {"path": rel, "candidate_head": value, "is_ancestor": False, "error": None}
    commit = value.strip() if isinstance(value, str) else ""
    if not commit:
        rec["error"] = "candidate_head is empty or not a string"
        return rec
    try:
        resolved = _git(root, "rev-parse", "--verify", "--quiet", f"{commit}^{{commit}}")
    except OSError:
        rec["error"] = "git unavailable"
        return rec
    if resolved.returncode != 0:
        rec["error"] = "candidate_head does not resolve to a commit"
        return rec
    ancestor = _git(root, "merge-base", "--is-ancestor", commit, "HEAD")
    if ancestor.returncode == 0:
        rec["is_ancestor"] = True
    elif ancestor.returncode == 1:
        rec["is_ancestor"] = False
    else:
        rec["error"] = (ancestor.stderr or b"git merge-base --is-ancestor failed").decode(
            "utf-8", "replace").strip()
    return rec


def build_report(manifest_path: Path, root: Path | None = None) -> dict:
    """Recompute every recorded digest, classify each mismatch by basis, and collect identity checks."""
    repo = Path(root) if root is not None else ROOT
    entries = json.loads(manifest_path.read_text(encoding="utf-8"))
    candidate_rev = _sealed_revision(manifest_path)

    basis: dict[str, str] = {}
    verdict: dict[str, str] = {}
    stale: list[str] = []
    missing: list[str] = []
    pending: list[str] = []

    for rel in sorted(entries):
        target = repo / rel
        if not target.is_file():
            missing.append(rel)
            basis[rel], verdict[rel] = "unexplained", "unexplained"
            continue
        if _digest(target.read_bytes()) == entries[rel]:
            basis[rel], verdict[rel] = "disk", "match_raw"
            continue
        stale.append(rel)
        pending.append(rel)

    # Only the entries the disk bytes cannot explain need a repository readback.
    specs: list[str] = []
    for rel in pending:
        specs.append(f"HEAD:{rel}")
        if candidate_rev:
            specs.append(f"{candidate_rev}:{rel}")
    blobs = _read_blobs(repo, specs)
    for rel in pending:
        basis[rel], verdict[rel] = _classify(rel, entries[rel], repo, candidate_rev, blobs)

    identity_checks: list[dict] = []
    for rel in sorted(entries):
        target = repo / rel
        if not target.is_file():
            continue
        try:
            payload = json.loads(target.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, ValueError):
            continue
        if isinstance(payload, dict) and "candidate_head" in payload:
            identity_checks.append(_identity_check(repo, rel, payload["candidate_head"]))

    counts = {label: 0 for label in (*BASIS_LABELS, "unexplained")}
    for rel in entries:
        counts[basis.get(rel, "unexplained")] += 1
    match_raw = sum(1 for rel in entries if verdict[rel] == "match_raw")
    benign_eol = sum(1 for rel in entries if verdict[rel] == "benign_eol")
    unexplained = [rel for rel in sorted(entries) if verdict[rel] == "unexplained"]
    return {
        "checked": len(entries),
        "match": match_raw,          # back-compat name for the raw-disk match count
        "match_raw": match_raw,
        "benign_eol": benign_eol,
        "explained": match_raw + benign_eol,
        "missing": len(missing),
        "stale": stale,
        "unexplained": unexplained,
        "basis_counts": counts,
        "candidate_revision": candidate_rev,
        "identity_checks": identity_checks,
    }


def _summary(report: dict) -> dict:
    return {
        "checked": report["checked"],
        "match_raw": report["match_raw"],
        "benign_eol": report["benign_eol"],
        "unexplained": len(report["unexplained"]),
        "basis_counts": report["basis_counts"],
    }


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        description="Recompute evidence-manifest digests, classify every mismatch by basis, and "
                    "report generation-identity ancestry.")
    ap.add_argument("--manifest", metavar="PATH", default=None,
                    help=f"manifest to verify (default: {DEFAULT_MANIFEST})")
    ap.add_argument("--root", metavar="PATH", default=None,
                    help="repository root the manifest paths are relative to "
                         "(default: the checkout this tool lives in)")
    ap.add_argument("--json", metavar="PATH", nargs="?", const="", default=None,
                    help="print the compact summary and, when PATH is given, write it there too "
                         "(the only file ever written)")
    ap.add_argument("--strict", action="store_true",
                    help="exit 1 when the unexplained set is non-empty (opt-in; report-only otherwise)")
    args = ap.parse_args(argv)

    root = Path(args.root).resolve() if args.root else ROOT
    manifest = (Path(args.manifest) if args.manifest
                else root / ".hgk" / "artifacts" / DEFAULT_MANIFEST.name)
    report = build_report(manifest, root)

    if args.json is not None:
        text = json.dumps(_summary(report), ensure_ascii=False, separators=(",", ":"))
        if args.json:
            Path(args.json).write_text(text + "\n", encoding="utf-8", newline="")
        print(text)
    else:
        print(json.dumps(report, ensure_ascii=False, indent=1))
    return 1 if (args.strict and report["unexplained"]) else 0


if __name__ == "__main__":
    raise SystemExit(main())
"""Pin the basis-aware digest gate in ``tools/verify_evidence_digests.py``.

The gate must (a) name the bytes a recorded digest was computed over, (b) accept an EOL-only
difference as benign, and (c) still classify an entry as unexplained when the digest matches an old
snapshot whose *content* genuinely changed -- the false-pass the v2 brief forbids (a rubber stamp
that reports zero unexplained on a genuinely drifted tree is a task failure).

It also pins that generation-identity ancestry stays REPORT-ONLY: a non-ancestor ``candidate_head``
is named in the report and the run still exits 0 without ``--strict`` (and even with it).

Hermetic: every classification case builds its own throwaway git repository under ``tempfile``; no
network is used. Expected digests are computed from explicit byte literals (an independent oracle),
not by importing the tool's own transforms. The final test additionally checks the acceptance
property on THIS checkout: ``--strict`` exits non-zero whenever the unexplained set is non-empty.
"""
from __future__ import annotations

import hashlib
import json
import shutil
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT / "src") not in sys.path:
    sys.path.insert(0, str(ROOT / "src"))

TOOL = ROOT / "tools" / "verify_evidence_digests.py"
GIT = shutil.which("git")

# Deterministic git identity and line-ending policy so the fixture is byte-exact on any host.
_GIT_ID = ["-c", "user.email=t@example.invalid", "-c", "user.name=probe",
           "-c", "commit.gpgsign=false", "-c", "init.defaultBranch=main",
           "-c", "core.autocrlf=false", "-c", "core.eol=lf"]


def _sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _crlf(data: bytes) -> bytes:
    """Lone LF -> CRLF (the expansion the tool documents); an independent oracle."""
    return data.replace(b"\r\n", b"\x00").replace(b"\n", b"\r\n").replace(b"\x00", b"\r\n")


def _run(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run([sys.executable, str(TOOL), *args], capture_output=True, text=True)


class _FixtureRepo:
    """A throwaway git checkout with a manifest (+ seal) that exercises every basis."""

    def __init__(self) -> None:
        self._tmp = tempfile.TemporaryDirectory()
        self.root = Path(self._tmp.name) / "repo"
        (self.root / "docs").mkdir(parents=True)

    def close(self) -> None:
        self._tmp.cleanup()

    def git(self, *args: str) -> str:
        return subprocess.run([GIT, *_GIT_ID, *args], cwd=self.root, check=True,
                              capture_output=True, text=True).stdout.strip()

    def write(self, rel: str, data: bytes) -> None:
        (self.root / rel).write_bytes(data)


@unittest.skipUnless(GIT, "git is required to build the fixture repository")
class BasisClassification(unittest.TestCase):
    """Every case builds the fixture tree, runs the real CLI, and reads its report."""

    # byte literals shared between the fixture and the expected digests
    DISK = b"disk-line\n"
    CRLF_ON_DISK = b"a\nb\n"
    HEAD_DRIFT_A = b"old head content\nsecond\n"
    HEADCRLF_A = b"alpha\r\nbeta\n"
    MIXED_HEAD = b"x\r\ny\n"
    CAND_HEAD = b"candidate content v1\n"
    CANDCRLF_HEAD = b"gamma\ndelta\n"
    CAND_BRANCH = b"cand-only payload\n"
    CANDCRLF_BRANCH = b"cand-only\r\nalpha\n"
    NO_BASIS = b"no basis carries these bytes\n"

    def setUp(self) -> None:
        self.fx = _FixtureRepo()
        self.addCleanup(self.fx.close)
        root = self.fx.root
        self.fx.git("init", "-q")
        # commit 1 (main): the "v1" content of every fixture file
        for rel, data in (("docs/disk.txt", self.DISK), ("docs/crlf.txt", self.CRLF_ON_DISK),
                          ("docs/head.txt", self.HEAD_DRIFT_A), ("docs/headcrlf.txt", self.HEADCRLF_A),
                          ("docs/mixed.txt", self.MIXED_HEAD), ("docs/cand.txt", self.CAND_HEAD),
                          ("docs/candcrlf.txt", self.CANDCRLF_HEAD),
                          ("docs/unknown.txt", b"whatever\n")):
            self.fx.write(rel, data)
        self.fx.git("add", "-A")
        self.fx.git("commit", "-qm", "base")
        # commit 2 (branch cand): different candidate blobs, diverging from main
        self.fx.git("checkout", "-q", "-b", "cand")
        self.fx.write("docs/cand.txt", self.CAND_BRANCH)
        self.fx.write("docs/candcrlf.txt", self.CANDCRLF_BRANCH)
        self.fx.git("add", "-A")
        self.fx.git("commit", "-qm", "candidate")
        self.cand_commit = self.fx.git("rev-parse", "HEAD")
        self.cand_tree = self.fx.git("rev-parse", "HEAD^{tree}")
        # commit 3 (main) so main and cand are genuinely divergent
        self.fx.git("checkout", "-q", "main")
        self.fx.write("docs/notes.txt", b"note\n")
        self.fx.git("add", "-A")
        self.fx.git("commit", "-qm", "advance main")
        # uncommitted working-tree edits: the drift each basis must classify
        self.fx.write("docs/head.txt", b"NEW head content\nsecond changed\n")
        self.fx.write("docs/headcrlf.txt", b"alpha\nbeta\nGAMMA\n")
        self.fx.write("docs/mixed.txt", b"x\ny\r\n")
        self.fx.write("docs/cand.txt", b"candidate content v2 changed\n")
        self.fx.write("docs/candcrlf.txt", b"cand-only\nalpha\nDELTA\n")

        self.manifest = {
            "docs/disk.txt": _sha(self.DISK),
            "docs/crlf.txt": _sha(_crlf(self.CRLF_ON_DISK)),
            "docs/head.txt": _sha(self.HEAD_DRIFT_A),
            "docs/headcrlf.txt": _sha(_crlf(self.HEADCRLF_A)),
            "docs/mixed.txt": _sha(self.MIXED_HEAD),
            "docs/cand.txt": _sha(self.CAND_BRANCH),
            "docs/candcrlf.txt": _sha(_crlf(self.CANDCRLF_BRANCH)),
            "docs/unknown.txt": _sha(self.NO_BASIS),
        }
        self.manifest_path = root / "evidence_manifest.json"
        self.manifest_path.write_text(json.dumps(self.manifest, indent=1), encoding="utf-8")
        (root / "evidence_manifest.seal.json").write_text(
            json.dumps({"schema": "PIPD-EVIDENCE-MANIFEST-SEAL/1",
                        "candidate": {"repo_commit_sha": self.cand_commit,
                                      "candidate_tree_sha": self.cand_tree}}), encoding="utf-8")
        self.expected_basis = {"disk": 1, "crlf_disk": 1, "head_blob": 2, "crlf_head_blob": 1,
                               "candidate_blob": 1, "crlf_candidate_blob": 1, "unexplained": 1}
        self.expected_unexplained = ["docs/cand.txt", "docs/candcrlf.txt", "docs/head.txt",
                                     "docs/headcrlf.txt", "docs/unknown.txt"]

    def _report(self) -> dict:
        proc = _run("--root", str(self.fx.root), "--manifest", str(self.manifest_path))
        self.assertEqual(proc.returncode, 0, proc.stderr[-600:])
        return json.loads(proc.stdout)

    def test_every_basis_is_named_and_the_content_clause_is_applied(self) -> None:
        """The first matching basis names the bytes, and EOL-equivalence decides benign vs drift."""
        report = self._report()
        self.assertEqual(report["checked"], 8)
        self.assertEqual(report["candidate_revision"], self.cand_tree)
        self.assertEqual(report["basis_counts"], self.expected_basis)
        self.assertEqual(report["match_raw"], 1)          # docs/disk.txt
        self.assertEqual(report["benign_eol"], 2)         # docs/crlf.txt + docs/mixed.txt
        self.assertEqual(report["unexplained"], self.expected_unexplained)
        # Back-compat keys the existing in-tree test reads must still be present.
        for key in ("checked", "match", "missing", "stale", "identity_checks"):
            self.assertIn(key, report)

    def test_json_summary_is_exactly_the_compact_contract(self) -> None:
        proc = _run("--root", str(self.fx.root), "--manifest", str(self.manifest_path), "--json")
        self.assertEqual(proc.returncode, 0, proc.stderr[-600:])
        self.assertTrue(proc.stdout.startswith('{"checked"'), proc.stdout[:80])
        summary = json.loads(proc.stdout)
        self.assertEqual(list(summary.keys()),
                         ["checked", "match_raw", "benign_eol", "unexplained", "basis_counts"])
        self.assertEqual(summary, {"checked": 8, "match_raw": 1, "benign_eol": 2, "unexplained": 5,
                                   "basis_counts": self.expected_basis})

    def test_strict_exits_only_when_the_unexplained_set_is_non_empty(self) -> None:
        default = _run("--root", str(self.fx.root), "--manifest", str(self.manifest_path))
        self.assertEqual(default.returncode, 0, "the default run must stay report-only")
        strict = _run("--root", str(self.fx.root), "--manifest", str(self.manifest_path), "--strict")
        self.assertEqual(strict.returncode, 1, "genuine drift must fail --strict")

        # A manifest whose every entry is explained must pass --strict (no over-failing).
        clean = {"docs/disk.txt": _sha(self.DISK), "docs/crlf.txt": _sha(_crlf(self.CRLF_ON_DISK))}
        clean_path = self.fx.root / "clean_manifest.json"
        clean_path.write_text(json.dumps(clean), encoding="utf-8")
        clean_run = _run("--root", str(self.fx.root), "--manifest", str(clean_path), "--strict")
        self.assertEqual(clean_run.returncode, 0, clean_run.stdout + clean_run.stderr)


@unittest.skipUnless(GIT, "git is required to build the fixture repository")
class AncestryStaysReportOnly(unittest.TestCase):
    def test_non_ancestor_candidate_head_is_named_but_never_fatal(self) -> None:
        fx = _FixtureRepo()
        self.addCleanup(fx.close)
        fx.git("init", "-q")
        fx.write("docs/placeholder.txt", b"x\n")
        fx.git("add", "-A")
        fx.git("commit", "-qm", "base")
        # A parentless (root) commit is resolvable but can never be an ancestor of HEAD.
        tree = fx.git("rev-parse", "HEAD^{tree}")
        other = fx.git("commit-tree", tree, "-m", "divergent root")
        self.assertEqual(
            subprocess.run([GIT, *_GIT_ID, "merge-base", "--is-ancestor", other, "HEAD"],
                           cwd=fx.root, capture_output=True).returncode, 1,
            "fixture invariant: the divergent commit must NOT be an ancestor of HEAD")
        fx.write("docs/identity.json", b'{\n "candidate_head": "' + other.encode() + b'"\n}\n')
        manifest = {"docs/identity.json": _sha((fx.root / "docs" / "identity.json").read_bytes())}
        manifest_path = fx.root / "evidence_manifest.json"
        manifest_path.write_text(json.dumps(manifest), encoding="utf-8")

        proc = _run("--root", str(fx.root), "--manifest", str(manifest_path))  # no --strict
        self.assertEqual(proc.returncode, 0, "a non-ancestor candidate must not fail the run")
        self.assertIn(other, proc.stdout, "the report must still name the non-ancestor value")
        report = json.loads(proc.stdout)
        self.assertEqual(report["unexplained"], [])
        checks = [c for c in report["identity_checks"] if c["path"] == "docs/identity.json"]
        self.assertEqual(len(checks), 1)
        self.assertEqual(checks[0]["candidate_head"], other)
        self.assertIs(checks[0]["is_ancestor"], False)
        self.assertIsNone(checks[0]["error"])
        # Even --strict must not escalate an ancestry finding (report-only by adjudication).
        strict = _run("--root", str(fx.root), "--manifest", str(manifest_path), "--strict")
        self.assertEqual(strict.returncode, 0, strict.stdout + strict.stderr)


class StrictGuardOnThisCheckout(unittest.TestCase):
    """The acceptance property on the real tree -- not a count, a gate behaviour."""

    def test_strict_exit_is_nonzero_exactly_when_unexplained_is_non_empty(self) -> None:
        manifest = ROOT / ".hgk" / "artifacts" / "evidence_manifest.json"
        if not manifest.is_file():
            self.skipTest("this checkout carries no evidence manifest to verify")
        default = _run()
        self.assertEqual(default.returncode, 0, "the default run is report-only, always exit 0")
        report = json.loads(default.stdout)
        unexplained = len(report["unexplained"])
        self.assertEqual(report["checked"],
                         report["match_raw"] + report["benign_eol"] + unexplained)
        strict = _run("--strict")
        expected = 1 if unexplained > 0 else 0
        self.assertEqual(
            strict.returncode, expected,
            f"--strict exit {strict.returncode} disagrees with unexplained={unexplained}")


if __name__ == "__main__":
    unittest.main(verbosity=2)
"""Drive ``tools/model_eligibility_probe.py`` against an in-process ``http.server`` stub.

No real host is contacted: the stub binds ``127.0.0.1:0`` (an ephemeral port) and the only network
failure exercised is a refused connection to a local port that is known to be closed. There are no
sleeps, and the whole module is expected to finish in a couple of seconds.

Cases:
  (a) both turns healthy            -> exit 0 and ``eligible: true``;
  (b) second turn HTTP 400 with a ``reasoning_content`` error body -> exit 3 and the typed reason
      recorded (``reasoning_content_not_echoed``);
  (c) connection refused            -> exit 2 with the typed ``transport_error`` reason.

It also pins that the second turn CONTINUES the tool-call conversation and that a credential present
in the environment is never echoed to stdout/stderr or written into the receipt.
"""
from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
import tempfile
import threading
import unittest
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT / "src") not in sys.path:
    sys.path.insert(0, str(ROOT / "src"))

PROBE = ROOT / "tools" / "model_eligibility_probe.py"
DECLARED = "declared-model-under-test"
OBSERVED = "stub-observed-model"
SECRET = "sk-sentinel-must-never-appear"


class _StubEndpoint:
    """A minimal OpenAI-compatible stub; ``mode`` selects the second-turn behaviour."""

    def __init__(self, mode: str) -> None:
        self.mode = mode
        self.requests: list[dict] = []
        outer = self

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *args) -> None:  # keep the test output clean
                pass

            def do_POST(self) -> None:
                length = int(self.headers.get("Content-Length") or 0)
                body = json.loads(self.rfile.read(length) or b"{}")
                outer.requests.append({"path": self.path, "body": body})
                status, payload = outer._respond(len(outer.requests))
                raw = json.dumps(payload).encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)

        self._server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.base_url = f"http://127.0.0.1:{self._server.server_address[1]}/v1"
        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
        self._thread.start()

    def _respond(self, turn: int) -> tuple[int, dict]:
        if self.mode == "reasoning_content" and turn >= 2:
            return 400, {"error": {
                "message": "Provider error 400: Upstream request failed: [invalid_request_error] "
                           "The `reasoning_content` in the thinking mode must be passed back to "
                           "the API.",
                "type": "invalid_request_error"}}
        if turn == 1:
            return 200, {"model": OBSERVED, "choices": [{
                "index": 0, "finish_reason": "tool_calls", "message": {
                    "role": "assistant", "content": None,
                    "tool_calls": [{"id": "call_stub_1", "type": "function", "function": {
                        "name": "probe_echo", "arguments": "{\"text\": \"ping\"}"}}]}}]}
        return 200, {"model": OBSERVED, "choices": [{
            "index": 0, "finish_reason": "stop",
            "message": {"role": "assistant", "content": "pong"}}]}

    def close(self) -> None:
        self._server.shutdown()
        self._server.server_close()
        self._thread.join(timeout=5)


def _free_port() -> int:
    """A 127.0.0.1 port that was just released, so a connection to it is refused."""
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return port


class ModelEligibilityProbe(unittest.TestCase):
    def _run(self, base_url: str, out: Path, *,
             api_key: str | None = None) -> subprocess.CompletedProcess:
        env = dict(os.environ)
        if api_key is None:
            env.pop("OPENAI_API_KEY", None)
        else:
            env["OPENAI_API_KEY"] = api_key
        return subprocess.run(
            [sys.executable, str(PROBE), "--base-url", base_url, "--model", DECLARED,
             "--out", str(out), "--timeout", "3"],
            capture_output=True, text=True, env=env)

    def test_healthy_two_turns_is_eligible(self) -> None:
        stub = _StubEndpoint("healthy")
        self.addCleanup(stub.close)
        with tempfile.TemporaryDirectory() as td:
            out = Path(td) / "receipt.json"
            proc = self._run(stub.base_url, out, api_key=SECRET)
            self.assertEqual(proc.returncode, 0, proc.stderr[-600:])
            receipt = json.loads(out.read_text(encoding="utf-8"))
        self.assertEqual(receipt["declared_model"], DECLARED)
        self.assertEqual(receipt["observed_model"], OBSERVED)
        self.assertEqual((receipt["turn1"], receipt["turn2"]), ("PASS", "PASS"))
        self.assertIs(receipt["eligible"], True)
        self.assertIsNone(receipt["typed_reason"])
        # The second turn must CONTINUE the conversation: assistant tool call + tool result.
        self.assertGreaterEqual(len(stub.requests), 2)
        roles = [m.get("role") for m in stub.requests[1]["body"]["messages"]]
        self.assertIn("assistant", roles)
        self.assertIn("tool", roles)
        # A credential in the environment must never be printed or stored.
        self.assertNotIn(SECRET, proc.stdout + proc.stderr)
        self.assertNotIn(SECRET, json.dumps(receipt))

    def test_second_turn_reasoning_content_is_typed_refusal(self) -> None:
        stub = _StubEndpoint("reasoning_content")
        self.addCleanup(stub.close)
        with tempfile.TemporaryDirectory() as td:
            out = Path(td) / "receipt.json"
            proc = self._run(stub.base_url, out)
            self.assertEqual(proc.returncode, 3, proc.stderr[-600:])
            receipt = json.loads(out.read_text(encoding="utf-8"))
        self.assertEqual(receipt["turn1"], "PASS")
        self.assertEqual(receipt["turn2"], "FAIL")
        self.assertIs(receipt["eligible"], False)
        self.assertEqual(receipt["typed_reason"], "reasoning_content_not_echoed")

    def test_connection_refused_is_a_transport_error(self) -> None:
        with tempfile.TemporaryDirectory() as td:
            out = Path(td) / "receipt.json"
            proc = self._run(f"http://127.0.0.1:{_free_port()}/v1", out)
            self.assertEqual(proc.returncode, 2, proc.stdout + proc.stderr)
            receipt = json.loads(out.read_text(encoding="utf-8"))
        self.assertIs(receipt["eligible"], False)
        self.assertEqual(receipt["typed_reason"], "transport_error")
        self.assertEqual(receipt["turn1"], "FAIL")


if __name__ == "__main__":
    unittest.main(verbosity=2)
#!/usr/bin/env python3
"""Two-turn tool-call eligibility probe for an OpenAI-compatible endpoint.

Why this exists: a governed long run can die on the SECOND provider turn with
``Provider error 400: Upstream request failed: [invalid_request_error] The `reasoning_content` in
the thinking mode must be passed back to the API.`` By then the run has already done work. This
probe establishes the entitlement *before* the long run: turn 1 asks the endpoint for a tool call,
turn 2 continues that same conversation (assistant tool call + tool result), which is exactly where
the adapter defect bites. The result is recorded as a receipt carrying the DECLARED and the OBSERVED
model, so a model substitution is disclosed, never silent.

Exit status:
    0  both turns passed (``eligible`` is true);
    3  a typed refusal -- the probe reached the endpoint but a turn failed. For the known
       ``reasoning_content`` class the typed reason is ``reasoning_content_not_echoed``; other
       failures get a typed ``turnN_...``/``turnN_http_<status>`` reason;
    2  a transport / connection error (nothing was reachable, so no entitlement was established).

The receipt is printed to stdout and, when ``--out`` is given, also written there. Secrets: an
``Authorization`` header is added only when ``OPENAI_API_KEY`` is set in the environment; the value
is never printed, echoed, logged or written into the receipt.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

REASONING_CONTENT_CODE = "reasoning_content_not_echoed"
TRANSPORT_CODE = "transport_error"

TOOLS = [{
    "type": "function",
    "function": {
        "name": "probe_echo",
        "description": "Echo text back so the follow-up turn has a tool result to continue from.",
        "parameters": {"type": "object", "properties": {"text": {"type": "string"}},
                       "required": ["text"]},
    },
}]


class TransportError(Exception):
    """The endpoint could not be reached, or the connection failed mid-flight (exit code 2)."""


def _endpoint(base_url: str) -> str:
    """Accept either a base URL (``.../v1``) or a full completions URL."""
    base = base_url.rstrip("/")
    return base if base.endswith("/chat/completions") else base + "/chat/completions"


def _decode(raw: bytes) -> dict:
    if not raw:
        return {}
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return {"raw": raw.decode("utf-8", "replace")}
    return payload if isinstance(payload, dict) else {"raw": raw.decode("utf-8", "replace")}


def _post(url: str, payload: dict, headers: dict, timeout: float) -> tuple[int, dict]:
    """POST JSON and return ``(status, decoded_body)``. Never raises for an HTTP status."""
    request = urllib.request.Request(
        url, data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", **headers}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, _decode(response.read())
    except urllib.error.HTTPError as exc:
        return exc.code, _decode(exc.read())
    except (urllib.error.URLError, OSError) as exc:
        raise TransportError(str(getattr(exc, "reason", exc))) from exc


def _first_message(body: dict) -> dict:
    choices = body.get("choices")
    if isinstance(choices, list) and choices and isinstance(choices[0], dict):
        message = choices[0].get("message")
        if isinstance(message, dict):
            return message
    return {}


def _note_model(receipt: dict, body: dict) -> None:
    """Record the model the endpoint says it served (declared-vs-observed disclosure)."""
    model = body.get("model")
    if isinstance(model, str) and model.strip():
        receipt["observed_model"] = model.strip()


def probe(base_url: str, model: str, *, api_key: str | None = None,
          timeout: float = 10.0) -> tuple[dict, int]:
    """Run the two-turn probe and return ``(receipt, exit_code)`` (see the module docstring)."""
    url = _endpoint(base_url)
    headers = {"Authorization": f"Bearer {api_key}"} if api_key else {}
    receipt = {
        "schema": "PIPD-MODEL-ELIGIBILITY-RECEIPT/1",
        "declared_model": model,
        "observed_model": model,
        "turn1": "FAIL",
        "turn2": "FAIL",
        "eligible": False,
        "typed_reason": None,
        "endpoint": url,
        "checked_at": datetime.now(timezone.utc).isoformat(),
    }
    messages = [{"role": "user",
                 "content": "Call the probe_echo tool with text=ping, then report the result."}]

    try:  # turn 1 -- ask for a tool call
        status, body = _post(url, {"model": model, "messages": messages, "tools": TOOLS,
                                   "tool_choice": "auto"}, headers, timeout)
    except TransportError:
        receipt["typed_reason"] = TRANSPORT_CODE
        return receipt, 2
    _note_model(receipt, body)
    if status != 200:
        receipt["typed_reason"] = f"turn1_http_{status}"
        return receipt, 3
    message = _first_message(body)
    tool_calls = message.get("tool_calls")
    if not tool_calls:
        receipt["typed_reason"] = "turn1_no_tool_call"
        return receipt, 3
    receipt["turn1"] = "PASS"
    messages = messages + [
        {"role": "assistant", "content": message.get("content"), "tool_calls": tool_calls},
        {"role": "tool", "tool_call_id": tool_calls[0].get("id") or "call_probe_1",
         "content": "ping"},
    ]

    try:  # turn 2 -- continue the conversation, which is where the adapter defect bites
        status2, body2 = _post(url, {"model": model, "messages": messages, "tools": TOOLS},
                               headers, timeout)
    except TransportError:
        receipt["typed_reason"] = TRANSPORT_CODE
        return receipt, 2
    _note_model(receipt, body2)
    if status2 != 200:
        blob = json.dumps(body2).lower()
        receipt["typed_reason"] = (REASONING_CONTENT_CODE if "reasoning_content" in blob
                                   else f"turn2_http_{status2}")
        return receipt, 3
    receipt["turn2"] = "PASS"
    receipt["eligible"] = True
    return receipt, 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        description="Two-turn tool-call eligibility probe for an OpenAI-compatible endpoint.")
    ap.add_argument("--base-url", required=True,
                    help="OpenAI-compatible base URL, e.g. http://127.0.0.1:1234/v1")
    ap.add_argument("--model", required=True, help="the DECLARED model to probe")
    ap.add_argument("--out", metavar="PATH", default=None,
                    help="also write the receipt JSON to this path")
    ap.add_argument("--timeout", type=float, default=10.0, help="per-request timeout in seconds")
    args = ap.parse_args(argv)

    # The credential is read from the environment and used only as a header value. It is never
    # printed and never placed in the receipt.
    api_key = os.environ.get("OPENAI_API_KEY") or None
    receipt, code = probe(args.base_url, args.model, api_key=api_key, timeout=args.timeout)
    text = json.dumps(receipt, ensure_ascii=False, indent=1)
    if args.out:
        Path(args.out).write_text(text + "\n", encoding="utf-8", newline="")
    print(text)
    print(f"declared={receipt['declared_model']} observed={receipt['observed_model']} "
          f"turn1={receipt['turn1']} turn2={receipt['turn2']} eligible={receipt['eligible']} "
          f"typed_reason={receipt['typed_reason']}", file=sys.stderr)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
