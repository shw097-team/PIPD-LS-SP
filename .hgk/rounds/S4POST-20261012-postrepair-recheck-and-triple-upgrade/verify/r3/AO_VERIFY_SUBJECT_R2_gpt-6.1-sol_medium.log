name: public-plugin-verify

# Read-only verification of the S4POST Stage B upgrade (the public-plugin projection, the web
# fallback and the install routes). It grants nothing: a green run here is NOT a portal approval,
# NOT a publication, NOT a host qualification and NOT an S4 acceptance — see
# docs/install/README.md, "States that are NOT the same".
#
# Triggers are pull_request and workflow_dispatch only. There is deliberately no privileged
# pull-request trigger (the token for `pull_request` from a fork is read-only, which is the point),
# no configured secret is read, no repository write, no tag and no publish step. The name of the
# forbidden privileged trigger is intentionally not written anywhere in this file, so a plain grep
# for it returns nothing.
# The PR path filter also lists pre-existing paths this job happens to touch (docs/RELEASE_TUPLE.json,
# dist/mount/**); that filter decides WHEN the job runs, it is NOT the write-set allowlist - the
# allowlist is enforced by the "wrote only inside its allowed set" step below.

on:
  pull_request:
    paths:
      - ".github/workflows/public-plugin-verify.yml"
      - "README.md"
      - "docs/install/**"
      - "docs/RELEASE_TUPLE.json"
      - "packaging/public-plugin/**"
      - "tools/freeze_public_plugin_source.py"
      - "tools/build_public_plugin.py"
      - "tools/build_web_fallback.py"
      - "tests/test_public_plugin_packaging.py"
      - "tests/test_web_fallback.py"
      - "dist/mount/**"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: public-plugin-verify-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Check out the frozen subject
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683  # v4.2.2
        with:
          persist-credentials: false
          # full history + tags: the release-identity gate re-derives the release tags with
          # `git rev-parse <tag>^{commit}`, and the "wrote no frozen path" step needs the base sha.
          fetch-depth: 0

      - name: Set up Python 3.11
        uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b  # v5.3.0
        with:
          python-version: "3.11"

      - name: Prove the upgrade wrote only inside its allowed set
        # Positive allowlist, not a frozen-path blacklist: a change outside the set fails even if it
        # is harmless, and dist/ is denied explicitly. Measured as AO-03 of the round's independent
        # acceptance challenge, which showed the earlier blacklist-only guard let dist/ and arbitrary
        # non-frozen paths through.
        env:
          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          # The fixed Stage-A tip this Stage-B branch is stacked on. Used only when the event does not
          # carry a PR base (workflow_dispatch), so the whole stacked write set is examined.
          STACKED_BASE_SHA: 52542c395a0f91dc2ba4bd6123acd4cdecd780dc
        run: |
          set -euo pipefail
          BASE="${PR_BASE_SHA:-${STACKED_BASE_SHA}}"
          if ! git cat-file -e "${BASE}^{commit}" 2>/dev/null; then
            echo "BASE_UNRESOLVED: ${BASE} is not present in this checkout; refusing to guess" >&2
            exit 1
          fi
          git merge-base --is-ancestor "$BASE" HEAD
          CHANGED="$(git diff --name-only "${BASE}...HEAD")"
          printf '%s\n' "$CHANGED"
          ALLOWED='^(packaging/public-plugin/|tools/freeze_public_plugin_source\.py$|tools/build_public_plugin\.py$|tools/build_web_fallback\.py$|tests/test_public_plugin_packaging\.py$|tests/test_web_fallback\.py$|docs/install/|docs/adr/|openspec/changes/s4post-triple-upgrade/|\.github/workflows/public-plugin-verify\.yml$|README\.md$|\.hgk/rounds/S4POST-20261012)'
          DENIED='^(skills/|src/|schemas/|dist/)'
          bad=0
          while IFS= read -r path; do
            [ -n "$path" ] || continue
            if printf '%s' "$path" | grep -Eq "$DENIED"; then
              echo "UPGRADE_WROTE_FROZEN_PATH: $path" >&2
              bad=1
            elif ! printf '%s' "$path" | grep -Eq "$ALLOWED"; then
              echo "UPGRADE_WROTE_OUTSIDE_ALLOWED_SET: $path" >&2
              bad=1
            fi
          done <<< "$CHANGED"
          if [ "$bad" -ne 0 ]; then
            echo "WRITE_SET_VIOLATION (base ${BASE})" >&2
            exit 1
          fi
          echo "WRITE_SET_CLEAN_AGAINST_${BASE}"

      - name: Compile the three upgrade tools
        # Nothing is installed for this step: the three tools import the standard library only.
        run: |
          python -m py_compile \
            tools/freeze_public_plugin_source.py \
            tools/build_public_plugin.py \
            tools/build_web_fallback.py
          echo "PY_COMPILE_OK"

      - name: Assert the upgrade is stdlib-only (no third-party import)
        # WHY THERE IS NO `pip install -r <file>` FOR THE UPGRADE IN THIS WORKFLOW: the three tools
        # and the two new test modules import the standard library only, so there is no requirements
        # file for them to pull — none exists. This step enforces that claim fail-closed, so a later
        # third-party import fails the gate instead of silently needing a dependency.
        run: |
          python - <<'PY'
          import ast
          import sys
          from pathlib import Path

          TARGETS = (
              "tools/freeze_public_plugin_source.py",
              "tools/build_public_plugin.py",
              "tools/build_web_fallback.py",
              "tests/test_public_plugin_packaging.py",
              "tests/test_web_fallback.py",
          )
          # The repository's own modules plus its package/test roots are not third-party.
          OWN = {
              "tools", "tests",
              "freeze_public_plugin_source", "build_public_plugin", "build_web_fallback",
              "pipd_ls_sp",
          }
          stdlib = set(sys.stdlib_module_names)
          offenders = []
          for rel in TARGETS:
              path = Path(rel)
              if not path.is_file():
                  offenders.append(f"{rel}: MISSING (the upgrade is incomplete)")
                  continue
              tree = ast.parse(path.read_text(encoding="utf-8"), filename=rel)
              for node in ast.walk(tree):
                  if isinstance(node, ast.Import):
                      roots = [alias.name.split(".")[0] for alias in node.names]
                  elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
                      roots = [node.module.split(".")[0]]
                  else:
                      continue
                  for root in roots:
                      if root not in stdlib and root not in OWN:
                          offenders.append(f"{rel}: {root}")
          if offenders:
              print("NON_STDLIB_IMPORT:")
              for entry in offenders:
                  print(f"  {entry}")
              raise SystemExit(1)
          print("STDLIB_ONLY_OK")
          PY

      - name: The two new test modules pass with no third-party dependency installed
        # Almost the strictest form of "the upgrade pulls no requirement": this runs BEFORE anything
        # is installed, so a third-party import in either module fails here rather than being masked
        # by an environment that happens to have the package.
        run: |
          python -m unittest tests.test_public_plugin_packaging tests.test_web_fallback -v \
            2>&1 | tee upgrade-tests.log

      - name: Install the project's own declared runtime dependency only
        # The ONLY installation in this workflow, and it exists for the pre-existing suite, not for
        # the upgrade. It resolves the project's own declared closure from pyproject metadata; no
        # ad-hoc requirements file is pulled, and `requirements.lock` (which records the closure as
        # installed, is NOT hash-pinned, and is therefore not an install recipe) is not used here.
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e .
          python -m pip freeze | tee resolved-deps.txt

      - name: Full unittest suite (raw log)
        run: python -m unittest discover -s tests -t . -v 2>&1 | tee full-unittest.log

      - name: Negative — a mutated pack document must fail the identity binding
        # FAIL-CLOSED: the failure MOTIVE must be the identity binding, not merely a non-zero exit.
        # (a) the gate is green first, (b) a pack document is mutated, (c) the re-run must contain a
        # real `FAIL:` line whose motive names the release-identity fields. A deleted module, an
        # import error or a collection error exits non-zero too, and must NOT satisfy this step.
        env:
          PACK: dist/mount/pipd-ls-sp-s4-chatgpt-mount-v0.1.1-preview.3
        run: |
          set -euo pipefail

          # (a) green first — a gate that is already red must not be read as "the mutation was caught".
          python -m unittest tests.test_s4ext_release_provenance 2>&1 | tee pre-mutation.log
          grep -qE "^OK" pre-mutation.log

          # (b) mutate the pack DOCUMENT: replace the release identity it stamps with a wrong one.
          python - <<'PY'
          from pathlib import Path
          doc = Path("dist/mount/pipd-ls-sp-s4-chatgpt-mount-v0.1.1-preview.3/README_MOUNT.md")
          text = doc.read_text(encoding="utf-8")
          mutated = text.replace("cbf69756d7fc90fc1cdfb3a45a1cc42cc603cb0a", "0" * 40)
          assert mutated != text, "the mutation fixture no longer matches the checked-in document"
          doc.write_text(mutated, encoding="utf-8")
          PY

          set +e
          python -m unittest tests.test_s4ext_release_provenance > mutation-run.log 2>&1
          status=$?
          set -e
          git checkout -- "$PACK"
          if [ -n "$(git status --porcelain "$PACK")" ]; then
            echo "RESTORE_FAILED: the mutated pack document was not restored" >&2
            exit 1
          fi

          # (c) fail closed on every way this step could "pass" without exercising the binding.
          if [ "$status" -eq 0 ]; then
            echo "MUTATION_ACCEPTED: the identity binding passed a tampered pack document" >&2
            tail -30 mutation-run.log >&2
            exit 1
          fi
          if ! grep -qE "^FAIL:" mutation-run.log; then
            echo "GATE_NOT_EXERCISED: no real test failure (deleted module, import error or collection error)" >&2
            tail -30 mutation-run.log >&2
            exit 1
          fi
          if grep -qE "ModuleNotFoundError|ImportError|No module named" mutation-run.log; then
            echo "GATE_NOT_EXERCISED: the run failed on an import/collection error, not on the binding" >&2
            tail -30 mutation-run.log >&2
            exit 1
          fi
          if ! grep -qE "does not carry|foreign release object" mutation-run.log; then
            echo "MUTATION_REFUSAL_MOTIVE_UNEXPECTED: the failure is not the identity binding" >&2
            tail -30 mutation-run.log >&2
            exit 1
          fi
          if ! grep -qE "release_tag_target|build_source_commit" mutation-run.log; then
            echo "MUTATION_REFUSAL_MOTIVE_UNEXPECTED: the failure does not name the identity fields" >&2
            tail -30 mutation-run.log >&2
            exit 1
          fi
          echo "MUTATION_REFUSED_ON_IDENTITY_BINDING"

      - name: Negative — the fallback builder must refuse a pack whose bytes drifted from MANIFEST.sha256
        # Second half of the same binding, exercised through the upgrade's OWN tool: the byte
        # binding (a member's bytes against MANIFEST.sha256) and the identity stamp it embeds.
        env:
          RELEASE_ID: v0.1.1-preview.3
          RELEASE_COMMIT: cbf69756d7fc90fc1cdfb3a45a1cc42cc603cb0a
          PACK: dist/mount/pipd-ls-sp-s4-chatgpt-mount-v0.1.1-preview.3
        run: |
          set -euo pipefail
          # A RELATIVE work dir under the workspace, so the shell and the tool resolve the SAME
          # directory on any runner (no dependence on /tmp being shared).
          WORK=".public-plugin-verify-work"
          rm -rf "$WORK"
          mkdir -p "$WORK"
          trap 'rm -rf "$WORK"' EXIT

          # green first: the untouched frozen pack must project into ONE DOC_MOUNT_ONLY document.
          python tools/build_web_fallback.py \
            --mount-pack "$PACK" \
            --release-id "$RELEASE_ID" \
            --release-commit "$RELEASE_COMMIT" \
            --out "$WORK/fallback.md" 2>&1 | tee fallback-green.log
          grep -q "DOC_MOUNT_ONLY" fallback-green.log

          # mutate a COPY's member bytes so they no longer match the pack's own MANIFEST.sha256.
          mkdir -p "$WORK/evil"
          cp -r "$PACK/." "$WORK/evil/"
          printf '\n<!-- tampered: these bytes no longer match MANIFEST.sha256 -->\n' >> "$WORK/evil/SKILL.md"

          set +e
          python tools/build_web_fallback.py \
            --mount-pack "$WORK/evil" \
            --release-id "$RELEASE_ID" \
            --release-commit "$RELEASE_COMMIT" \
            --out "$WORK/evil-fallback.md" > fallback-refusal.log 2>&1
          status=$?
          set -e
          cat fallback-refusal.log

          if [ "$status" -eq 0 ]; then
            echo "MUTATION_ACCEPTED: the fallback builder accepted a pack whose bytes drifted" >&2
            exit 1
          fi
          if ! grep -q "REFUSED MANIFEST_DIGEST_MISMATCH" fallback-refusal.log; then
            echo "MUTATION_REFUSAL_MOTIVE_UNEXPECTED: the refusal is not the byte binding (MANIFEST.sha256)" >&2
            exit 1
          fi
          echo "BYTE_DRIFT_REFUSED_ON_MANIFEST_BINDING"

      - name: Upload raw logs
        if: always()
        uses: actions/upload-artifact@6f51ac03b9356f520e9adb1b1b7802705f340c2b  # v4.5.0
        with:
          name: public-plugin-verify-raw-logs
          path: |
            resolved-deps.txt
            upgrade-tests.log
            full-unittest.log
            pre-mutation.log
            mutation-run.log
            fallback-green.log
            fallback-refusal.log
          if-no-files-found: warn
#!/usr/bin/env python3
"""check_evidence_locators.py - FAR R6: can a third party re-run this bundle's locators?

A finding whose locator resolves only inside the REVIEWER's private temp root, or only inside an
out-of-tree skill/contract copy, is NOT independently re-runnable even when the report itself is
readable (measured: AO10/AO11/AO12 staged evidence under %LOCALAPPDATA%\\Temp\\<lane>-* roots the maker
identity cannot list, and the canonical challenge-review lane lives in ~/.agents/skills/**, outside the repo).

Classification (per locator):
  RESOLVES_IN_TREE  - a real path under --root (or under a --search-dir)
  EXTERNAL_ONLY     - an existing path OUTSIDE --root   [OFFENDER]
  UNRESOLVABLE      - a path-shaped locator with no file behind it anywhere searched [OFFENDER]
  SHORTHAND_BARE_NAME - a bare `name.ext` with no path separator; not a locator, counted only

Usage: check_evidence_locators.py --root <tree> [--search-dir D]... [--json-out F] <file-or-dir>...
Exit: 0 = no offenders; 2 = offenders; 1 = usage error.
"""
import argparse, json, os, re, sys

# path-shaped: MUST contain a separator (so a bare `plugin.json` is a shorthand, not a locator)
ABS = re.compile(r'([A-Za-z]:[\\/][^\s"\'`<>|)*\]]*)')
REL = re.compile(r'([\w.\-]+(?:[\\/][\w.\-]+)+\.(?:py|ipynb|md|json|jsonl|sh|ps1|txt|log|yml|yaml|js|html|css|whl|png|toml|cfg|ini))')
BARE = re.compile(r'([\w.\-]+\.(?:py|md|json|sh|txt|log|yml|yaml))')
SKIP = re.compile(r'^(mailto:|git@)', re.I)
URL = re.compile(r'\bhttps?://[^\s"\'`<>|)\]*]+', re.I)

def iter_text(p):
    if os.path.isdir(p):
        for r, _d, fs in os.walk(p):
            for f in fs:
                if f.endswith(('.md','.json','.txt','.log','.yml','.yaml')):
                    yield os.path.join(r, f)
    else:
        yield p

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--root', required=True)
    ap.add_argument('--search-dir', action='append', default=[])
    ap.add_argument('--json-out')
    ap.add_argument('inputs', nargs='+')
    a = ap.parse_args()
    root = os.path.realpath(a.root)
    searches = [root] + [os.path.realpath(d) for d in a.search_dir]
    counts = {k:0 for k in ('RESOLVES_IN_TREE','EXTERNAL_ONLY','UNRESOLVABLE','SHORTHAND_BARE_NAME')}
    rows = []
    for src in a.inputs:
        for f in iter_text(src):
            try: txt = open(f, encoding='utf-8', errors='replace').read()
            except OSError: continue
            # A URL is not an in-tree locator. The previous form anchored SKIP at '^', so a URL
            # inside prose (e.g. `https://host/a/b.json`) was never skipped and got fragmented into
            # a relative-token candidate ('s://host/a/b.json'). Mask URLs before tokenising.
            txt = URL.sub(' ', txt)
            seen = set()
            toks = [(m.group(1).strip().rstrip('.,;:'), 'path') for m in ABS.finditer(txt)]
            toks += [(m.group(1).strip().rstrip('.,;:'), 'rel') for m in REL.finditer(txt)]
            bare = {m.group(1).strip().rstrip('.,;:') for m in BARE.finditer(txt)}
            for tok, kind in toks:
                if not tok or tok in seen or SKIP.match(tok) or len(tok) < 5: continue
                seen.add(tok)
                if os.path.isabs(tok):
                    rp = os.path.realpath(tok)
                    cls = ('RESOLVES_IN_TREE' if rp.startswith(root)
                           else ('EXTERNAL_ONLY' if os.path.exists(rp) else 'UNRESOLVABLE'))
                else:
                    cands = [os.path.join(os.path.dirname(f), tok)] + [os.path.join(s, tok) for s in searches]
                    cls = 'RESOLVES_IN_TREE' if any(os.path.exists(c) for c in cands) else 'UNRESOLVABLE'
                counts[cls] += 1
                if cls in ('EXTERNAL_ONLY','UNRESOLVABLE'):
                    rows.append({'file': os.path.relpath(f, root), 'locator': tok, 'class': cls})
            for b in bare:
                if b not in seen and '/' not in b and '\\' not in b:
                    counts['SHORTHAND_BARE_NAME'] += 1
    bad = counts['EXTERNAL_ONLY'] + counts['UNRESOLVABLE']
    verdict = 'PASS_LOCATORS_IN_TREE' if bad == 0 else 'FAIL_LOCATORS_NOT_RERUNNABLE'
    out = {'schema':'HGK-EVIDENCE-LOCATOR-CHECK/1','root':root,'search_dirs':searches,
           'verdict':verdict,'counts':counts,'offenders':rows}
    if a.json_out: open(a.json_out,'w',encoding='utf-8').write(json.dumps(out, ensure_ascii=False, indent=1))
    print(json.dumps({'verdict':verdict,'counts':counts}, ensure_ascii=False))
    for r in rows[:14]: print(f"  {r['class']:14} {r['locator'][:100]}")
    return 2 if bad else 0

if __name__ == '__main__': sys.exit(main())
