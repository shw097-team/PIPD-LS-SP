+++ b/string_utils.py
@@ -0,0 +1,17 @@
+"""Small string helpers."""
+
+
+def reverse_string(s: str) -> str:
+    """Return *s* with its characters in reverse order.
+
+    Uses slicing, which is O(n) and handles empty strings, Unicode
+    text, and combining characters the same way Python indexing does.
+
+    >>> reverse_string("abc")
+    'cba'
+    >>> reverse_string("")
+    ''
+    """
+    if not isinstance(s, str):
+        raise TypeError(f"expected str, got {type(s).__name__}")
+    return s[::-1]
diff --git a/test_string_utils.py b/test_string_utils.py
new file mode 100644
index 0000000000000000000000000000000000000000..ef94663c501b7748b0e3e14c1dfa807141ecb9a9
--- /dev/null
+++ b/test_string_utils.py
@@ -0,0 +1,42 @@
+"""Tests for string_utils.reverse_string."""
+
+import unittest
+
+from string_utils import reverse_string
+
+
+class TestReverseString(unittest.TestCase):
+    def test_reverses_simple_string(self):
+        self.assertEqual(reverse_string("abc"), "cba")
+
+    def test_empty_string(self):
+        self.assertEqual(reverse_string(""), "")
+
+    def test_single_character(self):
+        self.assertEqual(reverse_string("a"), "a")
+
+    def test_palindrome_is_unchanged(self):
+        self.assertEqual(reverse_string("racecar"), "racecar")
+
+    def test_reverses_punctuation_and_spaces(self):
+        self.assertEqual(reverse_string("ab cd."), ".dc ba")
+
+    def test_double_reverse_returns_original(self):
+        original = "Hello, world!"
+        self.assertEqual(reverse_string(reverse_string(original)), original)
+
+    def test_reverses_unicode(self):
+        self.assertEqual(reverse_string("caf\u00e9"), "\u00e9fac")
+
+    def test_does_not_mutate_input(self):
+        original = "keep"
+        reverse_string(original)
+        self.assertEqual(original, "keep")
+
+    def test_rejects_non_string(self):
+        with self.assertRaises(TypeError):
+            reverse_string(["a", "b"])
+
+
+if __name__ == "__main__":
+    unittest.main()

