+                         blob(p)@HEAD,              crlf_eol(...), normalize_eol(...),
+                         blob(p)@sealed_candidate,  crlf_eol(...), normalize_eol(...) }
+
+* ``MATCH_RAW``         the raw disk bytes hash to ``r``.
+* ``BENIGN_EOL``        some basis ``x`` hashes to ``r`` *and* ``normalize_eol(x) == normalize_eol(d)``
+                        -- a pure checkout / line-ending normalisation, never a failure.
+* ``UNEXPLAINED_DRIFT`` otherwise: the path is missing, no basis hashes to ``r``, or a basis hashes
+                        to ``r`` but its EOL-normalised content differs from the disk content, i.e.
+                        the bytes genuinely changed after the digest was taken.
+
+The content-equality clause is mandatory. Accepting ``blob@candidate`` (or a ``crlf`` variant) on a
+hash match alone is exactly the false pass this gate exists to prevent: on this tree most mismatching
+entries do hash-match the sealed candidate revision, yet 42 of them are real content drift, not a
+checkout artefact. The sealed candidate commit/tree is read from the sibling seal
+(``evidence_manifest.seal.json`` next to the manifest); no candidate is ever hard-coded.
+
+Generation identity: for every manifest entry that is a JSON payload carrying ``candidate_head``, the
+tool records whether that revision is an ancestor of HEAD. This is REPORT-ONLY (never fatal) -- a
+non-ancestor is named in the report but never changes the exit status (a prior adjudication rejected
+making it fatal as a no-op/downgrade).
+
+Exit status: ``0`` by default; with ``--strict``, non-zero iff at least one entry is
+``UNEXPLAINED_DRIFT``. ``--json`` prints exactly
+``{"checked":N,"match_raw":M,"benign_eol":B,"unexplained":K,"basis_counts":{...}}``.
 """
 from __future__ import annotations
 
@@ -27,12 +50,150 @@
 ROOT = Path(__file__).resolve().parents[1]
 DEFAULT_MANIFEST = ROOT / ".hgk" / "artifacts" / "evidence_manifest.json"
 
+CRLF = b"\r\n"
+LF = b"\n"
+
+#: Every basis label ``basis_counts`` can carry, in the order of the ``basis_set`` above. ``disk``
+#: itself is not listed: a hash match on the raw disk bytes is ``MATCH_RAW`` and is not a mismatch.
+BASIS_LABELS = (
+    "disk_crlf",
+    "disk_lf",
+    "head_blob",
+    "head_crlf_blob",
+    "head_lf_blob",
+    "candidate_blob",
+    "candidate_crlf_blob",
+    "candidate_lf_blob",
+    "no_basis",
+    "missing",
+)
+
+
+def normalize_eol(b: bytes) -> bytes:
+    """CRLF -> LF (the EOL normalisation)."""
+    return b.replace(CRLF, LF)
+
+
+def crlf_eol(b: bytes) -> bytes:
+    """Collapse every line ending to CRLF (LF and CRLF alike)."""
+    return normalize_eol(b).replace(LF, CRLF)
+
+
+def _sha256_bytes(b: bytes) -> str:
+    return hashlib.sha256(b).hexdigest()
+
+
+def _git(root: Path, *args: str, input_bytes: bytes | None = None) -> subprocess.CompletedProcess:
+    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, input=input_bytes)
+
+
+def _tree_blobs(root: Path, rev: str) -> dict[str, str]:
+    """Map repo-relative path -> blob sha for a commit or tree revision. Empty on any failure."""
+    if not rev:
+        return {}
+    proc = _git(root, "ls-tree", "-r", "-z", "--full-tree", f"{rev}^{{tree}}")
+    if proc.returncode != 0:
+        return {}
+    blobs: dict[str, str] = {}
+    for record in proc.stdout.split(b"\x00"):
+        if not record:
+            continue
+        meta, _, path = record.partition(b"\t")
+        fields = meta.split(b" ")
+        if len(fields) >= 3:
+            blobs[path.decode("utf-8", "surrogateescape")] = fields[2].decode("ascii")
+    return blobs
+
+
+def _batch_blobs(root: Path, shas: set[str]) -> dict[str, bytes]:
+    """Read blob bodies for ``shas`` in a single ``git cat-file --batch`` pass."""
+    if not shas:
+        return {}
+    payload = "".join(f"{sha}\n" for sha in sorted(shas)).encode("ascii")
+    proc = _git(root, "cat-file", "--batch", input_bytes=payload)
+    if proc.returncode != 0:
+        return {}
+    data = proc.stdout
