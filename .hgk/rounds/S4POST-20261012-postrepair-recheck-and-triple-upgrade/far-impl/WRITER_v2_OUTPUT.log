+CRLF = b"\r\n"
+LF = b"\n"
+
+#: Every basis label ``basis_counts`` can carry, in the order of the ``basis_set`` above. ``disk``
+#: itself is not listed: a hash match on the raw disk bytes is ``MATCH_RAW`` and is not a mismatch.
+BASIS_LABELS = (
+    "disk_crlf",
+    "disk_lf",
+    "head_blob",
+    "head_crlf_blob",
+    "head_lf_blob",
+    "candidate_blob",
+    "candidate_crlf_blob",
+    "candidate_lf_blob",
+    "no_basis",
+    "missing",
+)
+
+
+def normalize_eol(b: bytes) -> bytes:
+    """CRLF -> LF (the EOL normalisation)."""
+    return b.replace(CRLF, LF)
+
+
+def crlf_eol(b: bytes) -> bytes:
+    """Collapse every line ending to CRLF (LF and CRLF alike)."""
+    return normalize_eol(b).replace(LF, CRLF)
+
+
+def _sha256_bytes(b: bytes) -> str:
+    return hashlib.sha256(b).hexdigest()
+
+
+def _git(root: Path, *args: str, input_bytes: bytes | None = None) -> subprocess.CompletedProcess:
+    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, input=input_bytes)
+
+
+def _tree_blobs(root: Path, rev: str) -> dict[str, str]:
+    """Map repo-relative path -> blob sha for a commit or tree revision. Empty on any failure."""
+    if not rev:
+        return {}
+    proc = _git(root, "ls-tree", "-r", "-z", "--full-tree", f"{rev}^{{tree}}")
+    if proc.returncode != 0:
+        return {}
+    blobs: dict[str, str] = {}
+    for record in proc.stdout.split(b"\x00"):
+        if not record:
+            continue
+        meta, _, path = record.partition(b"\t")
+        fields = meta.split(b" ")
+        if len(fields) >= 3:
+            blobs[path.decode("utf-8", "surrogateescape")] = fields[2].decode("ascii")
+    return blobs
+
+
+def _batch_blobs(root: Path, shas: set[str]) -> dict[str, bytes]:
+    """Read blob bodies for ``shas`` in a single ``git cat-file --batch`` pass."""
+    if not shas:
+        return {}
+    payload = "".join(f"{sha}\n" for sha in sorted(shas)).encode("ascii")
+    proc = _git(root, "cat-file", "--batch", input_bytes=payload)
+    if proc.returncode != 0:
+        return {}
+    data = proc.stdout
+    out: dict[str, bytes] = {}
+    pos = 0
+    while pos < len(data):
+        nl = data.find(b"\n", pos)
+        if nl < 0:
+            break
+        fields = data[pos:nl].split(b" ")
+        if len(fields) < 3:  # "<name> missing" -- nothing to record
+            pos = nl + 1
+            continue
+        sha = fields[0].decode("ascii")
+        size = int(fields[2])
+        start = nl + 1
+        out[sha] = data[start:start + size]
+        pos = start + size + 1
+    return out
+
+
+def _read_seal(manifest_path: Path) -> tuple[str, str]:
+    """Read the sealed candidate commit/tree from the sibling seal, if one exists.
+
+    The seal for ``<stem>.json`` is ``<stem>.seal.json`` in the same directory. Returns
+    ``("", "")`` when there is no seal or it cannot be parsed -- the candidate basis is then simply
+    absent rather than substituted with a hard-coded value.
+    """
+    seal_path = manifest_path.with_name(manifest_path.stem + ".seal.json")
+    try:
+        seal = json.loads(seal_path.read_text(encoding="utf-8"))
+        candidate = seal.get("candidate", {})
+    except (OSError, UnicodeDecodeError, ValueError):
+        return "", ""
+    if not isinstance(candidate, dict):
+        return "", ""
+    commit = candidate.get("repo_commit_sha") or ""
+    tree = candidate.get("candidate_tree_sha") or ""
+    return (commit if isinstance(commit, str) else "",
+            tree if isinstance(tree, str) else "")
+
+
+def _basis_values(disk: bytes, head: bytes | None, candidate: bytes | None) -> list[tuple[str, bytes]]:
+    """The basis set in spec order, de-duplicated so each distinct byte value keeps its first label."""
+    items: list[tuple[str, bytes]] = []
+    seen: set[bytes] = set()
+
+    def add(label: str, value: bytes | None) -> None:
+        if value is None or value in seen:
+            return
+        seen.add(value)
+        items.append((label, value))
 
