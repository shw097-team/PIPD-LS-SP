index 0000000000000000000000000000000000000000..e15ff21dff8b59c8fcec16411f293c1ee4d9d449
--- /dev/null
+++ b/tools/model_eligibility_probe.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Two-turn tool-call eligibility probe for an OpenAI-compatible chat endpoint.
+
+Why this exists (FAR F-023-A): an execute lane must establish, before a long run, that the model it
+is about to drive can actually complete a multi-turn tool-call conversation through the configured
+endpoint. A prior round lost a run to an adapter defect (D-03/D-04): the upstream provider returns
+``400 invalid_request_error`` on the second turn because the ``reasoning_content`` of the first
+turn's thinking mode was not echoed back to the API. The probe reproduces that class in two turns
+and records it as a TYPED reason instead of a retry loop.
+
+Turn 1: ask the model to call a tiny ``ping`` tool. Pass iff the response is HTTP 200 and carries a
+``tool_calls`` list. The response's ``model`` field becomes ``observed_model``.
+
+Turn 2: continue the conversation with the assistant message (including ``tool_calls`` and, when the
+first response carried one, the ``reasoning_content``) plus a ``tool`` result message. Pass iff the
+endpoint answers HTTP 200.
+
+Exit contract:
+* ``0`` both turns pass (``eligible: true``);
+* ``3`` the second turn fails with HTTP 400 whose body names ``reasoning_content`` -- the known
+  thinking-mode adapter failure class, recorded as ``REASONING_CONTENT_NOT_ECHOED``;
+* ``2`` any transport / connection / other-endpoint failure (typed reason still recorded).
+
+No credential is ever accepted, printed or stored: the probe sends no ``Authorization`` header and
+the receipt contains only the fields below.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+REASONING_CONTENT_REASON = "REASONING_CONTENT_NOT_ECHOED"
+TRANSPORT_REASON = "TRANSPORT_ERROR"
+NO_TOOL_CALL_REASON = "NO_TOOL_CALL"
+
+
+class ProbeTransportError(Exception):
+    """Raised when the endpoint cannot be reached at all (including timeouts)."""
+
+
+_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # never route via a proxy
+
+
+def _post(url: str, payload: dict, timeout: float) -> tuple[int, str]:
+    """POST JSON; returns ``(http_status, body_text)``; raises ``ProbeTransportError``."""
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data,
+                                 headers={"Content-Type": "application/json"}, method="POST")
+    try:
+        with _OPENER.open(req, timeout=timeout) as resp:  # type: ignore[arg-type]
+            return resp.status, resp.read().decode("utf-8", "replace")
+    except urllib.error.HTTPError as exc:
+        return exc.code, exc.read().decode("utf-8", "replace")
+    except (urllib.error.URLError, OSError, TimeoutError) as exc:
+        raise ProbeTransportError(f"{type(exc).__name__}: {exc}") from exc
+
+
+def _error_message(body: str) -> str:
+    """Best-effort short excerpt of the endpoint's error message (never a credential)."""
+    try:
+        message = json.loads(body).get("error", {}).get("message")
+    except (ValueError, AttributeError):
+        message = None
+    if not isinstance(message, str):
+        message = body
+    return message.strip()[:200]
+
+
+def run_probe(base_url: str, model: str, timeout: float = 15.0) -> tuple[dict, int]:
+    """Execute the two-turn probe. Returns ``(receipt, exit_code)``."""
+    endpoint = base_url.rstrip("/") + "/chat/completions"
+    receipt = {
+        "declared_model": model,
+        "observed_model": None,
+        "turn1": "FAIL",
+        "turn2": "FAIL",
+        "eligible": False,
+        "typed_reason": None,
+        "turn1_error": None,
+        "turn2_error": None,
+    }
+
+    tool = {
+        "type": "function",
+        "function": {
+            "name": "ping",
+            "description": "Echo back the given word.",
+            "parameters": {"type": "object", "properties": {"word": {"type": "string"}},
+                           "required": ["word"]},
+        },
+    }
+    first_messages = [
+        {"role": "user",
+         "content": "Call the ping tool with word='pong' and report its result. "
+                    "Make exactly one tool call."},
+    ]
+    payload1 = {"model": model, "messages": first_messages,
+                "tools": [tool], "tool_choice": "auto"}
+
+    # ---- turn 1 ---------------------------------------------------------------
+    try:
+        status1, body1 = _post(endpoint, payload1, timeout)
+    except ProbeTransportError as exc:
+        receipt["typed_reason"] = TRANSPORT_REASON
+        receipt["turn1_error"] = str(exc)
+        return receipt, 2
+    if status1 != 200:
+        receipt["typed_reason"] = TRANSPORT_REASON
+        receipt["turn1_error"] = f"HTTP {status1}: {_error_message(body1)}"
+        return receipt, 2
+    try:
+        data1 = json.loads(body1)
+        message1 = data1["choices"][0]["message"]
+    except (ValueError, KeyError, IndexError, TypeError):
+        receipt["typed_reason"] = TRANSPORT_REASON
+        receipt["turn1_error"] = "turn-1 body is not a chat completion"
+        return receipt, 2
+    observed = data1.get("model")
+    if isinstance(observed, str):
+        receipt["observed_model"] = observed
+    tool_calls = message1.get("tool_calls") or []
+    reasoning_content = message1.get("reasoning_content")
+    if not isinstance(tool_calls, list) or not tool_calls:
+        receipt["typed_reason"] = NO_TOOL_CALL_REASON
+        receipt["turn1_error"] = "no tool_calls returned in turn 1"
+        return receipt, 2
+    receipt["turn1"] = "PASS"
+
+    # ---- turn 2 ---------------------------------------------------------------
+    assistant: dict = {"role": "assistant", "content": message1.get("content")}
+    if reasoning_content is not None:  # echo the thinking-mode payload, as the provider requires
+        assistant["reasoning_content"] = reasoning_content
+    assistant["tool_calls"] = tool_calls
+    tool_result = {"role": "tool",
+                   "tool_call_id": tool_calls[0].get("id", "call_1"),
+                   "content": json.dumps({"word": "pong", "echo": "pong"})}
+    payload2 = {"model": model, "messages": first_messages + [assistant, tool_result]}
+    try:
+        status2, body2 = _post(endpoint, payload2, timeout)
+    except ProbeTransportError as exc:
+        receipt["typed_reason"] = TRANSPORT_REASON
+        receipt["turn2_error"] = str(exc)
+        return receipt, 2
+    if status2 == 200:
+        receipt["turn2"] = "PASS"
+        receipt["eligible"] = True
+        receipt["typed_reason"] = None
+        return receipt, 0
+    if status2 == 400 and "reasoning_content" in body2.lower():
+        receipt["typed_reason"] = REASONING_CONTENT_REASON
+        receipt["turn2_error"] = f"HTTP 400: {_error_message(body2)}"
+        return receipt, 3
+    receipt["typed_reason"] = TRANSPORT_REASON
+    receipt["turn2_error"] = f"HTTP {status2}: {_error_message(body2)}"
+    return receipt, 2
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(
+        description="Two-turn tool-call eligibility probe for an OpenAI-compatible endpoint.")
+    ap.add_argument("--base-url", required=True, metavar="URL",
+                    help="endpoint root, e.g. http://127.0.0.1:8000/v1")
+    ap.add_argument("--model", required=True, metavar="NAME",
+                    help="model id to probe (recorded as declared_model)")
+    ap.add_argument("--receipt", metavar="PATH", default=None,
+                    help="also write the receipt JSON to this path")
+    ap.add_argument("--timeout", type=float, default=15.0, metavar="SECONDS",
+                    help="per-request timeout (default: 15)")
+    args = ap.parse_args(argv)
+
+    receipt, code = run_probe(args.base_url, args.model, timeout=args.timeout)
+    text = json.dumps(receipt, ensure_ascii=False, indent=1)
+    if args.receipt:
+        Path(args.receipt).write_text(text, encoding="utf-8", newline="")
+    print(text)
+    return code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
