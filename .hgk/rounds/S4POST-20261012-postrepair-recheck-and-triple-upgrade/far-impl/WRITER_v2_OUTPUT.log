diff --git a/tests/test_model_eligibility_probe.py b/tests/test_model_eligibility_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..55b90211e2de7e0fa8a5509410225079bea12940
--- /dev/null
+++ b/tests/test_model_eligibility_probe.py
@@ -0,0 +1,175 @@
+"""Guard the two-turn tool-call eligibility probe (``tools/model_eligibility_probe.py``).
+
+Everything runs against an in-process stub built with the standard library only: no real host is
+contacted, nothing sleeps for more than a second, and the whole module finishes in well under 20s.
+
+The three cases the adjudication item requires:
+
+* both turns healthy                -> exit 0 and ``eligible: true``;
+* second turn HTTP 400 naming ``reasoning_content`` -> exit 3 and the typed reason recorded;
+* connection refused               -> exit 2.
+"""
+from __future__ import annotations
+
+import json
+import socket
+import subprocess
+import sys
+import tempfile
+import threading
+import unittest
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+sys.path.insert(0, str(ROOT / "tools"))
+
+PROBE = ROOT / "tools" / "model_eligibility_probe.py"
+
+
+def _turn1_body() -> dict:
+    return {
+        "id": "chatcmpl-turn1", "object": "chat.completion", "model": "stub-model",
+        "choices": [{"index": 0, "finish_reason": "tool_calls", "message": {
+            "role": "assistant", "content": None,
+            "tool_calls": [{"id": "call_1", "type": "function",
+                            "function": {"name": "ping", "arguments": "{\"word\": \"pong\"}"}}],
+        }}],
+    }
+
+
+def _turn2_body() -> dict:
+    return {
+        "id": "chatcmpl-turn2", "object": "chat.completion", "model": "stub-model",
+        "choices": [{"index": 0, "finish_reason": "stop",
+                     "message": {"role": "assistant", "content": "pong"}}],
+    }
+
+
+def _start_stub(mode: str) -> tuple[ThreadingHTTPServer, dict]:
+    """Start a stub endpoint; ``mode`` selects the second-turn behaviour."""
+    state: dict = {"calls": 0, "lock": threading.Lock()}
+
+    class Handler(BaseHTTPRequestHandler):
+        protocol_version = "HTTP/1.1"
+
+        def log_message(self, *args: object) -> None:  # keep the test output clean
+            return
+
+        def _send(self, status: int, payload: dict) -> None:
+            body = json.dumps(payload).encode("utf-8")
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def do_POST(self) -> None:
+            length = int(self.headers.get("Content-Length") or 0)
+            if length:
+                self.rfile.read(length)
+            if self.path != "/v1/chat/completions":
+                self._send(404, {"error": {"message": "unexpected path"}})
+                return
+            with state["lock"]:
+                state["calls"] += 1
+                call = state["calls"]
+            if call == 1:
+                self._send(200, _turn1_body())
+            elif mode == "healthy":
+                self._send(200, _turn2_body())
+            else:
+                self._send(400, {"error": {
+                    "message": "The `reasoning_content` in the thinking mode must be passed "
+                               "back to the API.",
+                    "type": "invalid_request_error", "code": None}})
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    return server, state
+
+
+def _run_probe(base_url: str, receipt: Path) -> subprocess.CompletedProcess:
+    return subprocess.run([sys.executable, str(PROBE),
+                           "--base-url", base_url, "--model", "stub-model",
+                           "--receipt", str(receipt)],
+                          capture_output=True, text=True, timeout=30)
+
+
+class ModelEligibilityProbe(unittest.TestCase):
+    def test_both_turns_healthy(self) -> None:
+        server, state = _start_stub("healthy")
+        try:
+            port = server.server_address[1]
+            with tempfile.TemporaryDirectory() as sandbox:
+                receipt_path = Path(sandbox) / "receipt.json"
+                proc = _run_probe(f"http://127.0.0.1:{port}/v1", receipt_path)
+                self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+                receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
+        finally:
+            server.shutdown()
+            server.server_close()
+        self.assertEqual(state["calls"], 2, "the probe must make exactly two turns")
+        self.assertEqual(receipt["turn1"], "PASS")
+        self.assertEqual(receipt["turn2"], "PASS")
+        self.assertTrue(receipt["eligible"])
+        self.assertIsNone(receipt["typed_reason"])
+        self.assertEqual(receipt["declared_model"], "stub-model")
+        self.assertEqual(receipt["observed_model"], "stub-model")
+        for key in ("declared_model", "observed_model", "turn1", "turn2", "eligible",
+                    "typed_reason"):
+            self.assertIn(key, receipt)
+
+    def test_second_turn_reasoning_content_refusal(self) -> None:
+        server, _ = _start_stub("reasoning")
+        try:
+            port = server.server_address[1]
+            with tempfile.TemporaryDirectory() as sandbox:
+                receipt_path = Path(sandbox) / "receipt.json"
+                proc = _run_probe(f"http://127.0.0.1:{port}/v1", receipt_path)
+                self.assertEqual(proc.returncode, 3, proc.stdout + proc.stderr)
+                receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
+                self.assertEqual(json.loads(proc.stdout)["typed_reason"], receipt["typed_reason"])
+        finally:
+            server.shutdown()
+            server.server_close()
+        self.assertEqual(receipt["turn1"], "PASS")
+        self.assertEqual(receipt["turn2"], "FAIL")
+        self.assertFalse(receipt["eligible"])
+        self.assertEqual(receipt["typed_reason"], "REASONING_CONTENT_NOT_ECHOED")
+
+    def test_connection_refused_is_a_transport_error(self) -> None:
+        binder = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+        binder.bind(("127.0.0.1", 0))  # bound but never listening -> connection refused
+        port = binder.getsockname()[1]
+        try:
+            with tempfile.TemporaryDirectory() as sandbox:
+                receipt_path = Path(sandbox) / "receipt.json"
+                proc = _run_probe(f"http://127.0.0.1:{port}/v1", receipt_path)
+                self.assertEqual(proc.returncode, 2, proc.stdout + proc.stderr)
+                receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
+        finally:
+            binder.close()
+        self.assertFalse(receipt["eligible"])
+        self.assertEqual(receipt["turn1"], "FAIL")
+        self.assertEqual(receipt["typed_reason"], "TRANSPORT_ERROR")
+
+    def test_receipt_never_carries_a_credential_field(self) -> None:
+        server, _ = _start_stub("healthy")
+        try:
+            port = server.server_address[1]
+            with tempfile.TemporaryDirectory() as sandbox:
+                receipt_path = Path(sandbox) / "receipt.json"
+                proc = _run_probe(f"http://127.0.0.1:{port}/v1", receipt_path)
+                raw = receipt_path.read_text(encoding="utf-8") + proc.stdout
+        finally:
+            server.shutdown()
+            server.server_close()
+        lowered = raw.lower()
+        for banned in ("authorization", "api_key", "api-key", "bearer ", "token"):
+            self.assertNotIn(banned, lowered, f"the receipt or output carries {banned!r}")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/tests/test_verify_evidence_digests_basis.py b/tests/test_verify_evidence_digests_basis.py
new file mode 100644
index 0000000000000000000000000000000000000000..c61e12f66d615f9c1afcf099f47d99e8cc58f43a
--- /dev/null
+++ b/tests/test_verify_evidence_digests_basis.py
@@ -0,0 +1,240 @@
+"""Guard the v2 basis-aware digest gate in ``tools/verify_evidence_digests.py``.
+
+What this file pins, in order of importance:
+
+* the content-equality clause -- a hash match on a non-disk basis (``blob@HEAD`` /
+  ``blob@candidate``) is NOT enough: the EOL-normalised content must still be equal, or the entry
+  is ``UNEXPLAINED_DRIFT``. Without this clause the tool is a rubber stamp for post-seal edits;
+* the CLI contract -- default run exits 0, ``--json`` prints exactly the compact summary object,
+  ``--strict`` exits non-zero iff ``unexplained > 0``;
+* the sealed candidate is read from the sibling seal, never hard-coded;
+* generation-identity ancestry stays report-only: a non-ancestor candidate is named but is never
+  fatal (a prior adjudication rejected making it a hard failure as a no-op/downgrade).
+
+Every subprocess writes only into a temporary directory, so the suite leaves the tracked tree
+byte-identical.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+sys.path.insert(0, str(ROOT / "tools"))
+
+import verify_evidence_digests as ved  # noqa: E402  (after the sys.path bootstrap)
+
+VERIFIER = ROOT / "tools" / "verify_evidence_digests.py"
+DEFAULT_MANIFEST = ROOT / ".hgk" / "artifacts" / "evidence_manifest.json"
+
+_GIT_ENV = {"GIT_AUTHOR_NAME": "probe", "GIT_AUTHOR_EMAIL": "probe@example.invalid",
+            "GIT_COMMITTER_NAME": "probe", "GIT_COMMITTER_EMAIL": "probe@example.invalid"}
+
+
+def _sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _run(tool: Path, *args: str) -> subprocess.CompletedProcess:
+    return subprocess.run([sys.executable, str(tool), *args], capture_output=True, text=True)
+
+
+def _git(root: Path, *args: str) -> subprocess.CompletedProcess:
+    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True,
+                          env={**os.environ, **_GIT_ENV})
+
+
+def _install_tool(root: Path) -> Path:
+    """Copy the verifier under ``<root>/tools`` so its ``parents[1]`` ROOT becomes ``root``."""
+    target = root / "tools" / "verify_evidence_digests.py"
+    target.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(VERIFIER, target)
+    return target
+
+
+class ContentEqualityClause(unittest.TestCase):
+    """The clause that stops the tool from rubber-stamping a post-seal content edit."""
+
+    def test_benign_eol_matches_are_not_failures(self) -> None:
+        lf = b"line one\nline two\n"
+        status, label = ved.classify(_sha256_bytes(ved.crlf_eol(lf)), lf, None, None)
+        self.assertEqual((status, label), ("benign_eol", "disk_crlf"))
+
+        crlf = b"line one\r\nline two\r\n"
+        status, label = ved.classify(_sha256_bytes(ved.normalize_eol(crlf)), crlf, None, None)
+        self.assertEqual((status, label), ("benign_eol", "disk_lf"))
+
+    def test_basis_hash_match_with_changed_content_is_drift(self) -> None:
+        disk = b"alpha\nbeta\n"
+        candidate = b"alpha\nGAMMA\n"          # genuine edit after the digest was taken
+        recorded = _sha256_bytes(candidate)    # only the sealed candidate hashes to it
+        # The candidate basis DOES hash to the recorded digest -- and must still be a failure.
+        status, label = ved.classify(recorded, disk, None, candidate)
+        self.assertEqual((status, label), ("unexplained", "candidate_blob"))
+        # The same trap through a HEAD blob.
+        status, label = ved.classify(recorded, disk, candidate, None)
+        self.assertEqual((status, label), ("unexplained", "head_blob"))
+
+    def test_no_basis_match_is_drift(self) -> None:
+        status, label = ved.classify(_sha256_bytes(b"nowhere\n"), b"disk\n", b"head\n", b"cand\n")
+        self.assertEqual((status, label), ("unexplained", "no_basis"))
+
+    def test_eol_only_candidate_difference_is_benign(self) -> None:
+        disk = b"alpha\nbeta\n"
+        candidate = b"alpha\r\nbeta\r\n"       # same content, different line endings
+        status, label = ved.classify(_sha256_bytes(candidate), disk, None, candidate)
+        self.assertEqual((status, label), ("benign_eol", "candidate_blob"))
+
+
+class CliContract(unittest.TestCase):
+    def test_default_run_is_json_and_exits_zero(self) -> None:
+        proc = _run(VERIFIER)
+        self.assertEqual(proc.returncode, 0, proc.stderr[-400:])
+        report = json.loads(proc.stdout)
+        for key in ("checked", "match", "match_raw", "benign_eol", "unexplained",
+                    "missing", "stale", "basis_counts", "identity_checks"):
+            self.assertIn(key, report)
+
+    def test_json_summary_is_exact(self) -> None:
+        proc = _run(VERIFIER, "--json")
+        self.assertEqual(proc.returncode, 0, proc.stderr[-400:])
+        summary = json.loads(proc.stdout)
+        self.assertEqual(list(summary), ["checked", "match_raw", "benign_eol",
+                                         "unexplained", "basis_counts"])
+        self.assertEqual(proc.stdout.strip(),
+                         json.dumps(summary, ensure_ascii=False, separators=(",", ":")))
+        # ``unexplained`` already includes missing paths; the three classes partition all entries.
+        self.assertEqual(summary["match_raw"] + summary["benign_eol"] + summary["unexplained"],
+                         summary["checked"])
+
+    def test_strict_contract_on_this_tree(self) -> None:
+        """``--strict`` exits non-zero exactly when ``unexplained > 0``."""
+        proc = _run(VERIFIER, "--json", "--strict")
+        summary = json.loads(proc.stdout)
+        if summary["unexplained"] > 0:
+            self.assertNotEqual(proc.returncode, 0,
+                                "strict must fail when the unexplained set is non-empty")
+        else:
+            self.assertEqual(proc.returncode, 0)
+
+    def test_corrupted_digest_is_unexplained_and_strict_fails(self) -> None:
+        entries = json.loads(DEFAULT_MANIFEST.read_text(encoding="utf-8"))
+        target = next(rel for rel in sorted(entries) if (ROOT / rel).is_file())
+        with tempfile.TemporaryDirectory() as sandbox:
+            corrupt = Path(sandbox) / "manifest.json"
+            mutated = dict(entries)
+            mutated[target] = "0" * 64
+            corrupt.write_text(json.dumps(mutated), encoding="utf-8")
+            proc = _run(VERIFIER, "--manifest", str(corrupt))
+            self.assertEqual(proc.returncode, 0, proc.stderr[-400:])
+            self.assertIn(target, json.loads(proc.stdout)["stale"])
+            strict = _run(VERIFIER, "--manifest", str(corrupt), "--strict")
+            self.assertNotEqual(strict.returncode, 0)
+            self.assertIn(target, json.loads(strict.stdout)["stale"])
+
+
+class SiblingSeal(unittest.TestCase):
+    """The candidate basis is read from the sibling seal -- never hard-coded."""
+
+    def _git_repo(self, root: Path) -> tuple[str, str]:
+        """Commit ``f.txt`` as 'old' then 'new'; returns (candidate_commit, candidate_tree)."""
+        _git(root, "init", "-q")
+        (root / "f.txt").write_text("old\n", encoding="utf-8")
+        _git(root, "add", "f.txt")
+        candidate = _git(root, "commit", "-q", "-m", "old")
+        self.assertEqual(candidate.returncode, 0, candidate.stderr)
+        candidate_commit = _git(root, "rev-parse", "HEAD").stdout.strip()
+        candidate_tree = _git(root, "rev-parse", "HEAD^{tree}").stdout.strip()
+        (root / "f.txt").write_text("new\n", encoding="utf-8")
+        _git(root, "add", "f.txt")
+        _git(root, "commit", "-q", "-m", "new")
+        return candidate_commit, candidate_tree
+
+    def test_read_seal_round_trip(self) -> None:
+        with tempfile.TemporaryDirectory() as sandbox:
+            manifest = Path(sandbox) / "evidence_manifest.json"
+            (Path(sandbox) / "evidence_manifest.seal.json").write_text(json.dumps({
+                "schema": "PIPD-EVIDENCE-MANIFEST-SEAL/1",
+                "candidate": {"repo_commit_sha": "a" * 40, "candidate_tree_sha": "b" * 40},
+            }), encoding="utf-8")
+            self.assertEqual(ved._read_seal(manifest), ("a" * 40, "b" * 40))
+            (Path(sandbox) / "evidence_manifest.seal.json").unlink()
+            self.assertEqual(ved._read_seal(manifest), ("", ""))
+
+    @unittest.skipIf(shutil.which("git") is None, "git is unavailable")
+    def test_candidate_basis_comes_from_the_seal(self) -> None:
+        with tempfile.TemporaryDirectory() as sandbox:
+            root = Path(sandbox)
+            candidate_commit, candidate_tree = self._git_repo(root)
+            tool = _install_tool(root)
+            manifest = root / "evidence_manifest.json"
+            manifest.write_text(json.dumps({"f.txt": _sha256_bytes(b"old\n")}), encoding="utf-8")
+
+            without = _run(tool, "--manifest", str(manifest), "--json")
+            self.assertEqual(without.returncode, 0, without.stderr[-400:])
+            no_seal = json.loads(without.stdout)
+            self.assertEqual(no_seal["basis_counts"]["candidate_blob"], 0)
+            self.assertEqual(no_seal["unexplained"], 1)
+
+            (root / "evidence_manifest.seal.json").write_text(json.dumps({
+                "schema": "PIPD-EVIDENCE-MANIFEST-SEAL/1",
+                "candidate": {"repo_commit_sha": candidate_commit,
+                              "candidate_tree_sha": candidate_tree},
+            }), encoding="utf-8")
+            with_seal = _run(tool, "--manifest", str(manifest), "--json")
+            sealed = json.loads(with_seal.stdout)
+            self.assertEqual(sealed["basis_counts"]["candidate_blob"], 1,
+                             "the sealed candidate blob must be consulted")
+            self.assertEqual(sealed["unexplained"], 1,
+                             "a candidate hash match with different content is still drift")
+
+
+class AncestryReportOnly(unittest.TestCase):
+    @unittest.skipIf(shutil.which("git") is None, "git is unavailable")
+    def test_non_ancestor_candidate_is_named_but_not_fatal(self) -> None:
+        with tempfile.TemporaryDirectory() as sandbox:
+            root = Path(sandbox)
+            _git(root, "init", "-q")
+            (root / "f.txt").write_text("x\n", encoding="utf-8")
+            _git(root, "add", "f.txt")
+            _git(root, "commit", "-q", "-m", "base")
+            tree = _git(root, "rev-parse", "HEAD^{tree}").stdout.strip()
+            # A dangling commit object: reachable from no ref, and NOT an ancestor of HEAD.
+            made = _git(root, "commit-tree", tree, "-m", "non-ancestor")
+            self.assertEqual(made.returncode, 0, made.stderr)
+            non_ancestor = made.stdout.strip()
+            self.assertNotEqual(non_ancestor, _git(root, "rev-parse", "HEAD").stdout.strip())
+
+            tool = _install_tool(root)
+            (root / "receipt.json").write_text(
+                json.dumps({"candidate_head": non_ancestor}), encoding="utf-8")
+            manifest = root / "evidence_manifest.json"
+            manifest.write_text(
+                json.dumps({"receipt.json": _sha256_bytes((root / "receipt.json").read_bytes())}),
+                encoding="utf-8")
+
+            proc = _run(tool, "--manifest", str(manifest))
+            self.assertEqual(proc.returncode, 0, proc.stderr[-400:])
+            report = json.loads(proc.stdout)
+            checks = [c for c in report["identity_checks"] if c["path"] == "receipt.json"]
+            self.assertEqual(len(checks), 1, "the candidate_head payload was not checked")
+            self.assertEqual(checks[0]["candidate_head"], non_ancestor)
+            self.assertFalse(checks[0]["is_ancestor"])
+            self.assertIsNone(checks[0]["error"])
+
+            # Even with --strict this stays exit 0: ancestry is report-only, and nothing drifted.
+            strict = _run(tool, "--manifest", str(manifest), "--strict")
+            self.assertEqual(strict.returncode, 0, strict.stderr[-400:])
+            self.assertIn(non_ancestor, json.loads(strict.stdout)["identity_checks"][0]["candidate_head"])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/tools/model_eligibility_probe.py b/tools/model_eligibility_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..e15ff21dff8b59c8fcec16411f293c1ee4d9d449
--- /dev/null
+++ b/tools/model_eligibility_probe.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Two-turn tool-call eligibility probe for an OpenAI-compatible chat endpoint.
+
+Why this exists (FAR F-023-A): an execute lane must establish, before a long run, that the model it
+is about to drive can actually complete a multi-turn tool-call conversation through the configured
+endpoint. A prior round lost a run to an adapter defect (D-03/D-04): the upstream provider returns
+``400 invalid_request_error`` on the second turn because the ``reasoning_content`` of the first
+turn's thinking mode was not echoed back to the API. The probe reproduces that class in two turns
+and records it as a TYPED reason instead of a retry loop.
+
+Turn 1: ask the model to call a tiny ``ping`` tool. Pass iff the response is HTTP 200 and carries a
+``tool_calls`` list. The response's ``model`` field becomes ``observed_model``.
+
+Turn 2: continue the conversation with the assistant message (including ``tool_calls`` and, when the
+first response carried one, the ``reasoning_content``) plus a ``tool`` result message. Pass iff the
+endpoint answers HTTP 200.
+
+Exit contract:
+* ``0`` both turns pass (``eligible: true``);
+* ``3`` the second turn fails with HTTP 400 whose body names ``reasoning_content`` -- the known
+  thinking-mode adapter failure class, recorded as ``REASONING_CONTENT_NOT_ECHOED``;
+* ``2`` any transport / connection / other-endpoint failure (typed reason still recorded).
+
+No credential is ever accepted, printed or stored: the probe sends no ``Authorization`` header and
+the receipt contains only the fields below.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+REASONING_CONTENT_REASON = "REASONING_CONTENT_NOT_ECHOED"
+TRANSPORT_REASON = "TRANSPORT_ERROR"
+NO_TOOL_CALL_REASON = "NO_TOOL_CALL"
+
+
+class ProbeTransportError(Exception):
+    """Raised when the endpoint cannot be reached at all (including timeouts)."""
+
+
+_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # never route via a proxy
+
+
+def _post(url: str, payload: dict, timeout: float) -> tuple[int, str]:
