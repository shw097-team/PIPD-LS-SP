import { AsyncLocalStorage } from 'node:async_hooks';

// The installed adapter predates GO's mandatory conversation header. Preserve
// each incoming conversation id in asynchronous request scope, including when
// several desktop chats stream concurrently. Never use the OpenAI bearer token
// as a GO session id or credential.
const conversation = new AsyncLocalStorage<string>();
const originalFetch = globalThis.fetch;
globalThis.fetch = async (input: any, init?: RequestInit) => {
  const destination = new URL(input instanceof Request ? input.url : String(input));
  if (destination.origin === 'https://opencode.ai' && destination.pathname.startsWith('/zen/go/v1/')) {
    const headers = new Headers(init?.headers ?? (input instanceof Request ? input.headers : undefined));
    const id = conversation.getStore();
    if (id) headers.set('x-opencode-session', id);
    headers.set('user-agent', 'codex-desktop-model-router/1.0');
    init = { ...init, headers };
  }
  return originalFetch(input, init);
};
const originalServe = Bun.serve;
Bun.serve = ((options: any) => {
  const handler = options.fetch;
  return originalServe({ ...options, fetch: async (request: Request, server: any) => {
    let id = request.headers.get('session_id') ?? request.headers.get('x-opencode-session') ?? request.headers.get('x-codex-thread-id');
    if (!id && request.method === 'POST') {
      try { const body = await request.clone().json(); id = body.prompt_cache_key ?? body.metadata?.session_id; } catch {}
    }
    return conversation.run(id || crypto.randomUUID(), () => handler(request, server));
  }});
}) as typeof Bun.serve;

// Start the installed protocol adapter without its CLI's global config injection.
// Configuration and credentials belong to this isolated desktop router only.
const gate = createReadinessGate();
const server = startServer(10102, { readinessGate: gate });
Bun.serve = originalServe;
console.log(`Desktop model router listening on 127.0.0.1:${server.port}`);
// No Codex config/catalog synchronization runs in this standalone adapter host.
gate.markReady();
process.on('SIGTERM', () => { server.stop(true); process.exit(0); });
