4: # aborts with "The `reasoning_content` in the thinking mode must be passed back to the API"
5: # (HTTP 400, upstream) once the transcript grows; measured 3/3 lanes in attempt 2 of this round.
6: # The backup opencode-go/deepseek-v4-flash was probed healthy with a one-line echo before this run.
7: set -u
8: WT=C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt
9: W="$WT/.hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade/stage-b"
