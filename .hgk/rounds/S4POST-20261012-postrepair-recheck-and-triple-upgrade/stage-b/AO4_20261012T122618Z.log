20:       -c model_reasoning_effort='"none"' \
21:       -c openai_base_url='http://127.0.0.1:10102/v1' \
22:       -c model_catalog_json='C:/Users/user/.codex/desktop-model-catalog.json' \
23:       exec --cd "$WT" --skip-git-repo-check -s danger-full-access - \
24:       < "$W/WRITER_${L}_BRIEF_v2.md" > "$W/${L}_attempt3_${STAMP}.log" 2>&1
25:     echo "$?" > "$W/${L}_attempt3_${STAMP}.exit"
26:   ) &
27: done
28: wait
29: for L in "$@"; do echo "$L exit=$(cat "$W/${L}_attempt3_${STAMP}.exit" 2>/dev/null) log=$W/${L}_attempt3_${STAMP}.log"; done
30: echo "LANES_DONE"


