209:     for rel, _digest, data in listed:
210:         if rel.endswith(".md") and release_commit not in data.decode("utf-8", "replace"):
211:             raise Refusal("RELEASE_STAMP_MISSING",
212:                           f"{rel} does not stamp the release commit {release_commit}")
213:     return listed
214: 
215: 
216: def compose_document(release_id: str, release_commit: str,
217:                      members: list[tuple[str, str, bytes]], size_cap: int) -> bytes:
218:     """Compose the single bounded markdown document (no truncation anywhere)."""
219:     lines: list[str] = [
220:         f"<!-- {FALLBACK_SCHEMA} DOC_MOUNT_ONLY -->",
221:         "# PIPD-LS-SP S4 Web fallback — single-document mount (DOC_MOUNT_ONLY)",
222:         "",
223:         f"- release_id: {release_id}",
224:         f"- release_commit: {release_commit}",
225:         "- doc_mount_only: true",
226:         f"- member_count: {len(members)}",
227:         f"- size_cap_bytes: {size_cap}",
228:         "",
229:         "> DOC_MOUNT_ONLY: this is a document drop, not an installed plugin, not a host-registered",
230:         "> skill and not a public directory listing (none exists yet). It executes nothing. Verify a",
231:         "> member against the inventory below before you rely on it.",
232:         "",
233:         "## Member inventory",
234:         "",
235:         "| member | sha256 |",
236:         "| --- | --- |",
237:     ]
238:     for rel, digest, _data in members:
239:         lines.append(f"| {rel} | {digest} |")
240:     for rel, _digest, data in members:
241:         lines += ["", f"## Member: {rel}", "", f"<!-- BEGIN MEMBER {rel} -->"]
242:         lines.append(data.decode("utf-8", "replace"))
243:         lines.append(f"<!-- END MEMBER {rel} -->")
244:     text = "\n".join(lines)
245:     if not text.endswith("\n"):
246:         text += "\n"
247:     return text.encode("utf-8")
248: 
249: 
250: def write_exclusive(out_path: Path, data: bytes) -> None:
251:     out_path = Path(out_path)
252:     if _path_is_symlink(out_path):
253:         raise Refusal("DESTINATION_SYMLINK", f"destination {out_path} is a symlink")
254:     out_path.parent.mkdir(parents=True, exist_ok=True)
255:     flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
256:     try:
257:         fd = os.open(out_path, flags, 0o644)
258:     except FileExistsError as exc:
259:         raise Refusal("DESTINATION_EXISTS",
260:                       f"destination {out_path} already exists; refusing to overwrite") from exc
261:     try:
262:         with os.fdopen(fd, "wb") as handle:
263:             handle.write(data)
264:     except BaseException:
265:         if out_path.exists() and not _path_is_symlink(out_path):
266:             out_path.unlink()
267:         raise
268: 
269: 
270: def build_fallback(*, mount_pack: Path, release_id: str, release_commit: str, out_path: Path,
271:                    size_cap: int = DEFAULT_SIZE_CAP) -> dict:
272:     if not HEX40.match(str(release_commit)):
273:         raise Refusal("RELEASE_COMMIT_INVALID",
274:                       f"release commit is not 40 hex chars: {release_commit!r}")
275:     if size_cap <= 0:
276:         raise Refusal("SIZE_CAP_INVALID", f"size cap must be positive: {size_cap!r}")
277:     members = load_and_verify_pack(mount_pack, release_commit)
278:     document = compose_document(release_id, release_commit, members, size_cap)
279:     if len(document) > size_cap:
280:         raise Refusal("SIZE_CAP_EXCEEDED",
281:                       f"composed document is {len(document)} bytes > cap {size_cap}; "
282:                       "refusing to truncate")
283:     write_exclusive(Path(out_path), document)
284:     return {
285:         "verdict": "BUILT",
286:         "out": str(out_path),
287:         "bytes": len(document),
288:         "sha256": _sha256(document),
289:         "member_count": len(members),
290:         "doc_mount_only": True,
291:     }
292: 
293: 
294: def main(argv: list[str] | None = None) -> int:
295:     ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
296:     ap.add_argument("--mount-pack", required=True)
297:     ap.add_argument("--release-id", required=True)
298:     ap.add_argument("--release-commit", required=True)
299:     ap.add_argument("--size-cap", type=int, default=DEFAULT_SIZE_CAP)
300:     ap.add_argument("--out", required=True)
301:     args = ap.parse_args(argv)
302:     try:
303:         report = build_fallback(
304:             mount_pack=Path(args.mount_pack),
305:             release_id=args.release_id,
306:             release_commit=args.release_commit,
307:             out_path=Path(args.out),
308:             size_cap=args.size_cap,
309:         )
310:     except Refusal as exc:
311:         print(str(exc))
312:         return 2
313:     print(f"BUILT {report['out']} bytes={report['bytes']} sha256={report['sha256']} "
314:           f"members={report['member_count']} DOC_MOUNT_ONLY")
315:     return 0
316: 
317: 
318: if __name__ == "__main__":
319:     raise SystemExit(main())
