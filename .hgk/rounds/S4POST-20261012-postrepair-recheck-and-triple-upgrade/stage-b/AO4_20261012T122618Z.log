    29	STAMP=$(date -u +%Y%m%dT%H%M%SZ)
    30	LOGDIR="${TMPDIR:-$LOCALAPPDATA/Temp}/hgk-lanes"
    31	LOGOUT="$LOGDIR/${LANE}_${STAMP}.log"
    32	
    33	cd "$WT" || exit 1
    34	mkdir -p "$LOGDIR"
    35	
    36	# --- 1/2. preflight: commit harness artifacts, then require a clean worktree -------------------
    37	git add -A -- "$RELROUND" >/dev/null 2>&1
    38	if ! git diff --cached --quiet; then
    39	  git -c core.safecrlf=false commit -q \
    40	    -m "chore(s4post-b): commit harness artifacts before the ${LANE} lane handover" \
