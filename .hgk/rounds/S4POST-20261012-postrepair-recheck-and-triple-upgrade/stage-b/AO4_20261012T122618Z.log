510: #!/usr/bin/env python3
511: """WO-S4-WEB-02: build and verify the one versioned Web/ChatGPT mount pack.
512: 
513: This tool is the *only* writer for ``dist/mount/**``. It does three determinism-critical things,
514: and nothing else:
515: 
516: 1. It derives ``MANIFEST.sha256`` **from the actual pack files** (relative POSIX paths, sorted,
517:    ``"<sha256>  <relpath>"`` one per line) and rewrites it into the pack root.
518: 2. It builds the ZIP byte-identically on every run with the same inputs: entries rooted at the pack
519:    directory name, fixed ``ZipInfo.date_time`` (the 1980 ZIP epoch), fixed permission bits, fixed
520:    compression. ``MANIFEST.sha256`` is written **last** (the first manifest entry is therefore the
521:    last archive entry).
522: 3. ``--verify`` recomputes the digest of every manifest-listed member from the ZIP bytes themselves
523:    and refuses, by name, any mutation, missing member, unmanifested member, or path that escapes the
524:    pack root. It never writes.
525: 
526: The tool declares no runtime authority: it is a stdlib-only build/verify utility, candidate-only.
527: 
528: CLI
529: ---
530: ``--pack-root DIR --out-zip FILE``   rebuild MANIFEST.sha256, then the ZIP (+ ``.sha256`` sidecar).
531: ``--verify FILE``                    recompute and compare; exit 0 on PASS, non-zero on any refusal.
532: """
533: from __future__ import annotations
534: 
535: import argparse
536: import hashlib
537: import sys
538: import zipfile
539: from pathlib import Path
540: 
541: MANIFEST_NAME = "MANIFEST.sha256"
542: # The ZIP epoch. A constant date_time makes the archive reproducible across runs (zips otherwise
543: # embed the wall-clock mtime of each member).
544: FIXED_DATE_TIME = (1980, 1, 1, 0, 0, 0)
545: COMPRESS_LEVEL = 9
546: 
547: 
548: def _sha256_bytes(data: bytes) -> str:
549:     return hashlib.sha256(data).hexdigest()
550: 
551: 
552: def _member_bytes(path: Path) -> bytes:
553:     """The CANONICAL bytes of a pack member (EOL-normalised for text).
554: 
555:     S4EXT-R1 (F-S4EXT-008, found while repairing F001): the ZIP published as
556:     ``v0.1.1-preview.3`` captured CRLF member bytes -- it was built from a CRLF checkout, before
557:     ``.gitattributes`` pinned ``* text=auto eol=lf`` -- so its 8 members (and the manifest it
558:     embeds) do not match the same members in the LF-normalised tree, and the published bytes were
559:     NOT reproducible from the repository. Canonicalising text members to LF here means the
560:     manifest and the archive members are derived from ONE byte sequence, so a rebuild of the same
561:     source is byte-identical on any platform. Binary members (NUL byte / non-UTF-8) are never
562:     rewritten. ``verify_pack`` is deliberately NOT changed: it must keep re-deriving a member's
563:     digest from the bytes actually inside the ZIP.
564:     """
565:     data = path.read_bytes()
566:     if b"\x00" in data:
567:         return data
568:     try:
569:         data.decode("utf-8")
570:     except UnicodeDecodeError:
571:         return data
572:     return data.replace(b"\r\n", b"\n").replace(b"\r", b"\n")
573: 
574: 
575: def _content_files(pack_root: Path) -> list[Path]:
576:     """Every real file under the pack root except the manifest itself, sorted by rela. POSIX path."""
577:     files = [
578:         p for p in pack_root.rglob("*")
579:         if p.is_file() and p.name != MANIFEST_NAME
580:     ]
581:     return sorted(files, key=lambda p: p.relative_to(pack_root).as_posix())
582: 
583: 
584: def _manifest_text(pack_root: Path, files: list[Path]) -> str:
585:     lines = [
586:         f"{_sha256_bytes(_member_bytes(f))}  {f.relative_to(pack_root).as_posix()}"
587:         for f in files
588:     ]
589:     return ("\n".join(lines) + "\n") if lines else ""
590: 
591: 
592: def _write_member(zf: zipfile.ZipFile, arcname: str, data: bytes) -> None:
593:     info = zipfile.ZipInfo(arcname, date_time=FIXED_DATE_TIME)
594:     info.compress_type = zipfile.ZIP_DEFLATED
595:     info.external_attr = 0o644 << 16  # fixed permission bits, no host-specific metadata
596:     info.create_system = 0            # fixed "creator" so the header bytes are stable
597:     zf.writestr(info, data, compress_type=zipfile.ZIP_DEFLATED, compresslevel=COMPRESS_LEVEL)
598: 
599: 
600: def build_pack(pack_root: Path, out_zip: Path) -> dict:
601:     """Rebuild MANIFEST.sha256 from the pack files, then the ZIP. Returns a small report."""
602:     pack_root = Path(pack_root).resolve()
603:     out_zip = Path(out_zip).resolve()
604:     if not pack_root.is_dir():
605:         raise FileNotFoundError(f"pack root is not a directory: {pack_root}")
606: 
607:     files = _content_files(pack_root)
608:     manifest_text = _manifest_text(pack_root, files)
609:     manifest_bytes = manifest_text.encode("utf-8")
610:     (pack_root / MANIFEST_NAME).write_bytes(manifest_bytes)
611: 
612:     root_name = pack_root.name
613:     out_zip.parent.mkdir(parents=True, exist_ok=True)
614:     with zipfile.ZipFile(out_zip, "w", zipfile.ZIP_DEFLATED, compresslevel=COMPRESS_LEVEL) as zf:
615:         for f in files:
616:             rel = f.relative_to(pack_root).as_posix()
617:             _write_member(zf, f"{root_name}/{rel}", _member_bytes(f))
618:         # MANIFEST.sha256 is the LAST archive entry (its first content line is written last).
619:         _write_member(zf, f"{root_name}/{MANIFEST_NAME}", manifest_bytes)
620: 
621:     digest = _sha256_bytes(out_zip.read_bytes())
622:     sidecar = out_zip.with_name(out_zip.name + ".sha256")
623:     sidecar.write_bytes(f"{digest}  {out_zip.name}\n".encode("utf-8"))
624:     return {
625:         "pack_root": str(pack_root),
626:         "out_zip": str(out_zip),
627:         "members": len(files) + 1,  # content files + the manifest
628:         "zip_sha256": digest,
629:         "sidecar": str(sidecar),
630:     }
631: 
632: 
633: def _parse_manifest(text: str) -> list[tuple[str, str]]:
634:     """Parse ``"<sha256>  <relpath>"`` lines. Returns [(digest, relpath), ...]."""
635:     entries: list[tuple[str, str]] = []
636:     for raw in text.splitlines():
637:         line = raw.rstrip("\n")
638:         if not line.strip():
639:             continue
640:         if "  " not in line:
641:             raise ValueError(f"malformed manifest line (no two-space separator): {line!r}")
642:         digest, rel = line.split("  ", 1)
643:         entries.append((digest.strip(), rel.strip()))
644:     return entries
645: 
646: 
647: def verify_pack(zip_path: Path) -> tuple[bool, list[str]]:
648:     """Recompute the manifest from the ZIP bytes. Returns (ok, problems)."""
649:     zip_path = Path(zip_path).resolve()
650:     problems: list[str] = []
651:     if not zip_path.is_file():
652:         return False, [f"ZIP_NOT_FOUND: {zip_path}"]
653: 
654:     with zipfile.ZipFile(zip_path) as zf:
655:         names = zf.namelist()
656: 
657:         # 1. No member may escape the pack root (no absolute path, no '..', no backslash).
658:         for name in names:
659:             parts = name.split("/")
660:             if (name.startswith("/") or ".." in parts or "\\" in name
661:                     or parts[0] in ("", ".")):
662:                 problems.append(f"ESCAPES_PACK_ROOT: {name}")
663: 
664:         if not names:
665:             return False, ["EMPTY_ZIP"]
666:         root_name = names[0].split("/")[0]
