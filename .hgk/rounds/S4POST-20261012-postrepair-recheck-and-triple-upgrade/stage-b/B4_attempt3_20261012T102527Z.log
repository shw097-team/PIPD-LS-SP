diff --git a/tools/build_public_plugin.py b/tools/build_public_plugin.py
index 29b372558921746663530bac431b2b919db30fb0..c032f7ce157879c0c47f9876a02f50d66cfcbf5f
--- a/tools/build_public_plugin.py
