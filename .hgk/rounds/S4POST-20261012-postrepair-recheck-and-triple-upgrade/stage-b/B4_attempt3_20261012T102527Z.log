 214|def validate_subset(instance, schema, path: str = "$") -> list[dict]:
 215|    """A tiny, dependency-free validator for the local plugin.schema.json subset."""
 216|    errors: list[dict] = []
 217|    if not isinstance(schema, dict):
 218|        return errors
 219|    if "type" in schema:
 220|        types = schema["type"] if isinstance(schema["type"], list) else [schema["type"]]
 221|        if not any(_type_ok(instance, t) for t in types):
 222|            return [{"path": path, "keyword": "type", "message": f"expected one of {types}"}]
 223|    if "const" in schema and instance != schema["const"]:
 224|        errors.append({"path": path, "keyword": "const",
 225|                       "message": f"expected const {schema['const']!r}"})
 226|    if "enum" in schema and instance not in schema["enum"]:
 227|        errors.append({"path": path, "keyword": "enum",
 228|                       "message": f"expected one of {schema['enum']!r}"})
 229|    if isinstance(instance, str):
 230|        if "minLength" in schema and len(instance) < schema["minLength"]:
 231|            errors.append({"path": path, "keyword": "minLength", "message": "too short"})
 232|        if "maxLength" in schema and len(instance) > schema["maxLength"]:
 233|            errors.append({"path": path, "keyword": "maxLength", "message": "too long"})
 234|        if "pattern" in schema and re.search(schema["pattern"], instance) is None:
 235|            errors.append({"path": path, "keyword": "pattern",
 236|                           "message": f"does not match {schema['pattern']!r}"})
 237|    if isinstance(instance, int) and not isinstance(instance, bool):
 238|        if "minimum" in schema and instance < schema["minimum"]:
 239|            errors.append({"path": path, "keyword": "minimum", "message": "below minimum"})
 240|        if "maximum" in schema and instance > schema["maximum"]:
 241|            errors.append({"path": path, "keyword": "maximum", "message": "above maximum"})
 242|    if isinstance(instance, list):
 243|        if "minItems" in schema and len(instance) < schema["minItems"]:
 244|            errors.append({"path": path, "keyword": "minItems", "message": "too few items"})
 245|        if "maxItems" in schema and len(instance) > schema["maxItems"]:
 246|            errors.append({"path": path, "keyword": "maxItems", "message": "too many items"})
 247|        if schema.get("uniqueItems"):
 248|            seen = {json.dumps(item, sort_keys=True) for item in instance}
 249|            if len(seen) != len(instance):
 250|                errors.append({"path": path, "keyword": "uniqueItems", "message": "duplicates"})
 251|        items = schema.get("items")
 252|        if isinstance(items, dict):
 253|            for i, item in enumerate(instance):
 254|                errors += validate_subset(item, items, f"{path}[{i}]")
 255|    if isinstance(instance, dict):
 256|        for required_key in schema.get("required", []):
 257|            if required_key not in instance:
 258|                errors.append({"path": f"{path}.{required_key}", "keyword": "required",
 259|                               "message": "required property is absent"})
 260|        props = schema.get("properties", {})

