 195|# --------------------------------------------------------------------------- JSON-schema subset
 196|def _type_ok(value, typ: str) -> bool:
 197|    if typ == "object":
 198|        return isinstance(value, dict)
 199|    if typ == "array":
 200|        return isinstance(value, list)
 201|    if typ == "string":
 202|        return isinstance(value, str)
 203|    if typ == "integer":
 204|        return isinstance(value, int) and not isinstance(value, bool)
 205|    if typ == "number":
 206|        return isinstance(value, (int, float)) and not isinstance(value, bool)
 207|    if typ == "boolean":
 208|        return isinstance(value, bool)
 209|    if typ == "null":
 210|        return value is None
 211|    return True
