+
+    # ------------------------------------------------ 18. the vendor name pattern
+    def test_18_official_name_violating_the_vendor_pattern_is_refused(self) -> None:
+        bad_names = ("PIPD Public Skills", "pipd--ls--sp", "pipd..ls", "-pipd", "pipd-", "PIPD_LS")
