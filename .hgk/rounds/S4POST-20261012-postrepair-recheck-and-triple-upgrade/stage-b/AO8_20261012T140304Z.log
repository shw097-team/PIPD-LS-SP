+ print(name,p.returncode,p.stdout,flush=True)
+ return p
+delivery('delivery-end-head',['git','-c',safe,'rev-parse','HEAD','HEAD^{tree}'])
+delivery('delivery-end-status',['git','-c',safe,'status','--porcelain'])
