+case('N-prefix-rename','mkdir -p "prefix/$REL"; git mv README.md "prefix/$REL/moved.md"\n'+lane('RENAME'))
+case('N-prefix-quoted','mkdir -p "prefix/$REL"; echo outside > "prefix/$REL/space name.txt"; git add prefix\n'+lane('QUOTED'))
