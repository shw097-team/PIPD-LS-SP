+ENV['PATH']='C:/Program Files/Git/usr/bin;C:/Program Files/Git/mingw64/bin;'+str(pathlib.Path(sys.executable).parent)+';'+ENV['PATH']
+BASH='C:/Program Files/Git/usr/bin/bash.exe'
