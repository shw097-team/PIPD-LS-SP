#!/usr/bin/env bash
# Governed lane launcher (v3) - fail-closed, with the round-5 fail-open counterexamples closed.
#
# v1 (round 3): commit harness artifacts before handover; refuse a dirty worktree; log outside the tree.
# v2 (round 4): D1 no fail-open on a missing brief or a failed main-log copy; D2 reject postflight dirt;
#               D3 round-relative output only; F refuse a log dir inside the worktree.
# v3 (round 5) closes five counterexamples an independent officer demonstrated against v2:
#   R1 a failed receipt copy still returned 0                     -> receipt copy is checked and fatal
#   R2 a FAILED git status was read as "clean" (empty output)     -> a nonzero status query is fatal
#   R3 an already staged outside-round file got committed        -> staged paths outside the round are refused
#   R4 (gate-side) see run_lanes_gated.sh
#   R5 (gate-side) see run_lanes_gated.sh
#   A  the manifest was written inside the tree after the clean check, so the handover was dirtied by the
#      launcher itself; it is now written outside the tree and copied in at postflight, like the lane log.
#
# Exit: child's code on full success; 2 dirty/unverifiable preflight; 3 refused input/logdir;
#       4 lane log missing or uncopyable; 5 postflight dirty or unverifiable; 6 receipt or commit failed.
set -u

# round-6 M7 hygiene: this script must not depend on shell start-up files a caller can seed.
unset BASH_ENV ENV

LANE="${1:-}"; BRIEF="${2:-}"; OUTSUB="${3:-}"
[ -n "$LANE" ] && [ -n "$BRIEF" ] && [ -n "$OUTSUB" ] || { echo "REFUSED[3] usage: run_lane.sh <LANE> <brief> <round-relative-outsub>" >&2; exit 3; }

WT="${LANE_WT:-C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt}"
RELROUND=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"
R="$WT/$RELROUND"; S="$R/stage-b"
EMAIL="lane-harness@local.invalid"; NAME="hgk lane harness"
CODEX="${CODEX_BIN:-/c/Users/user/AppData/Local/OpenAI/Codex/bin/2e5e00daee91c61d/codex.exe}"

die() { echo "REFUSED[$1] $2" >&2; echo "REFUSED_${LANE}_DONE"; exit "$1"; }

# R2: a status query that FAILS must never be read as "clean". Counts, or the literal ERR.
status_count() {
  local out rc
  out="$(git status --porcelain 2>/dev/null)"; rc=$?
  [ "$rc" -eq 0 ] || { echo ERR; return; }
  printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' '
}
# R3 + round-6 M2/M3. The old form was
#   git diff --cached --name-only | grep -v "^${RELROUND}/"
# which had two fail-open holes an independent officer demonstrated:
#   * the "." in ".hgk" is a REGEX WILDCARD there, so a staged "Xhgk/rounds/.../outside.txt"
#     read as inside the round and was committed;
#   * a FAILED "git diff --cached --name-only" produced empty output, which read as "nothing
#     is staged outside the round".
# Fixed-string prefix matching via case, and the query's own exit status is checked.
staged_outside() {
  local out rc
  out="$(git diff --cached --name-only 2>/dev/null)"; rc=$?
  [ "$rc" -eq 0 ] || { echo "__STAGED_QUERY_FAILED__"; return; }
  # -F is the fix for the regex-wildcard hole: the round prefix is matched as a literal.
  # NOTE, a measured trap on this host: "git diff --cached --name-only -z" captured into a
  # shell variable loses its NUL separators and its final newline, so "while read" never ran
  # its body once and every staged path - including outside ones - read as none. Plain
  # newline output is used here instead. Names containing a newline are not handled, which
  # is a stated limit of this check.
  printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | grep -v -F -- "${RELROUND}/"
}
commit_all() {
  git add -A -- "$RELROUND" 2>/dev/null || { echo "GIT_ADD_FAILED" >&2; return 1; }
  local outside; outside="$(staged_outside)"
  case "$outside" in
    *__STAGED_QUERY_FAILED__*) echo "STAGED_QUERY_FAILED_REFUSED: the index could not be enumerated" >&2; return 1 ;;
  esac
  if [ -n "$outside" ]; then
    echo "STAGED_OUTSIDE_ROUND_REFUSED: $(printf '%s' "$outside" | tr '\n' ' ')" >&2
    return 1
  fi
  if ! git diff --cached --quiet 2>/dev/null; then
    git -c user.email="$EMAIL" -c user.name="$NAME" commit -q -m "$1" >/dev/null 2>&1 || { echo "GIT_COMMIT_FAILED" >&2; return 1; }
  fi
  return 0
}

[ -f "$S/$BRIEF" ] || die 3 "brief not found: stage-b/$BRIEF"
case "$OUTSUB" in /*|*..*) die 3 "OUTSUB must stay inside the round: $OUTSUB" ;; esac
[ -d "$R" ] || die 3 "round directory not found: $RELROUND"

LOGDIR="${TMPDIR:-$LOCALAPPDATA/Temp}/hgk-lanes"
mkdir -p "$LOGDIR" || die 3 "cannot create lane log directory: $LOGDIR"
nrm() { { cd "$1" && pwd -P; } 2>/dev/null | tr 'A-Z' 'a-z'; }
WTRES=$(nrm "$WT"); LGRES=$(nrm "$LOGDIR")
[ -n "$WTRES" ] && [ -n "$LGRES" ] || die 3 "cannot resolve worktree/log paths for the containment check"
case "$LGRES" in "$WTRES"|"$WTRES"/*) die 3 "lane log dir resolves inside the worktree: $LGRES" ;; esac

cd "$WT" || die 3 "cannot enter worktree"

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
TOKEN="${LANE_TOKEN:-$STAMP}"
commit_all "chore(s4post-b): commit harness artifacts before the ${LANE} lane handover" \
  || die 6 "harness preflight commit failed; refusing to hand over"
DIRTY="$(status_count)"
[ "$DIRTY" != "ERR" ] || die 2 "git status failed; cleanliness cannot be established, refusing to launch ${LANE}"
[ "$DIRTY" -eq 0 ] || die 2 "worktree not clean before handover: $DIRTY path(s); refusing to launch ${LANE}"
echo "PREFLIGHT_CLEAN HEAD=$(git rev-parse --short HEAD)"

mkdir -p "$R/$OUTSUB" || die 3 "cannot create round-relative output dir: $OUTSUB"

# round-6 M7: the route must not be trusted from an environment a caller can seed (BASH_ENV).
# When a role is given, the child derives the expected model/effort/route from the assignment
# file itself and refuses any mismatch, so a startup-file override cannot restore the
# "qualified one route, launched another" defect.
LANE_ROLE="${LANE_ROLE:-}"
if [ -n "$LANE_ROLE" ]; then
  AEXP="$(python -c "import json,sys;r=json.load(open(sys.argv[1],encoding='utf-8'))['roles'][sys.argv[2]];print(r['model'],r['reasoning_effort'],r.get('route',{}).get('style','openai'))" "$S/ROUND_ASSIGNMENT.json" "$LANE_ROLE" 2>/dev/null)" \
    || die 3 "cannot read the assignment for role $LANE_ROLE"
  [ -n "$AEXP" ] || die 3 "role $LANE_ROLE is not in the assignment"
  read -r A_MODEL A_EFF A_STYLE <<< "$AEXP"
fi

case "$LANE" in
  AO*) DEF_MODEL="gpt-6.1-sol"; DEF_PROV="openai"; DEF_EFF="medium" ;;
  *)   DEF_MODEL="opencode-go/deepseek-v4.1-flash"; DEF_PROV="opencode-go"; DEF_EFF="high" ;;
esac
MODEL="${LANE_MODEL:-$DEF_MODEL}"; PROV="${LANE_PROVIDER:-$DEF_PROV}"; EFF="${LANE_EFFORT:-$DEF_EFF}"
SANDBOX_MODE="${LANE_SANDBOX:-workspace-write}"

# R5: a slug like "opencode-go/deepseek-v4.1-flash" is a CATALOG ENTRY, not a provider id. The caller
# must state the route; the gate passes the role's route so a writer can never be launched through a
# route the qualification did not exercise.
if [ -n "$LANE_ROLE" ]; then
  # The child must not simply be told what to use; it derives the expected values and refuses a
  # mismatch. An exception is allowed only when the owner-decision record itself names the exact
  # deviating model or effort, so the gate's authorisation and the child's check cannot disagree.
  OWNERF="$S/OWNER_DECISION_MODEL_DEVIATION.md"
  if [ "$MODEL" = "$A_MODEL" ]; then
    :
  elif [ -f "$OWNERF" ] && grep -qx "authorizes: $MODEL" "$OWNERF"; then
    echo "CHILD_OWNER_AUTHORISED_DEVIATION model=$MODEL assignment=$A_MODEL"
  else
    die 6 "model mismatch with the assignment and not owner-authorised: env=$MODEL assignment=$A_MODEL"
  fi
  if [ "$EFF" = "$A_EFF" ]; then
    :
  elif [ -f "$OWNERF" ] && grep -qx "authorizes_effort: $EFF" "$OWNERF"; then
    echo "CHILD_OWNER_AUTHORISED_EFFORT effort=$EFF assignment_effort=$A_EFF"
  else
    die 6 "effort mismatch with the assignment and not owner-authorised: env=$EFF assignment=$A_EFF"
  fi
  [ "${ROUTE_STYLE:-openai}" = "$A_STYLE" ] || die 6 "route mismatch with the assignment: env=${ROUTE_STYLE:-openai} assignment=$A_STYLE"
fi
if [ "${ROUTE_STYLE:-openai}" = "catalog" ]; then
  INV=(-c "model=$MODEL" -c "model_reasoning_effort=\"$EFF\""
       -c "openai_base_url=${ROUTE_BASE_URL:-http://127.0.0.1:10102/v1}"
       -c "model_catalog_json=${ROUTE_CATALOG:?catalog route needs ROUTE_CATALOG}")
else
  INV=(-m "$MODEL" -c "model_provider=\"$PROV\"" -c "model_reasoning_effort=\"$EFF\"")
fi

# A: the manifest is written OUTSIDE the worktree and copied in at postflight.
LOG="$LOGDIR/${LANE}_${STAMP}.log"; LOGEXIT="$LOG.exit"; MAN="$LOGDIR/${LANE}_${STAMP}.manifest"
echo "${LANE}_LANE=${STAMP} MODEL=${MODEL} provider=${PROV} reasoning=${EFF} route=${ROUTE_STYLE:-openai} (declared)"
printf 'LANE=%s\nMODEL=%s\nPROVIDER=%s\nEFFORT=%s\nSTAMP=%s\nTOKEN=%s\nWT=%s\nROUTE_STYLE=%s\nSANDBOX=%s\n' \
  "$LANE" "$MODEL" "$PROV" "$EFF" "$STAMP" "$TOKEN" "$WT" "${ROUTE_STYLE:-openai}" "$SANDBOX_MODE" > "$MAN"

timeout 5400 "$CODEX" "${INV[@]}" exec --cd "$WT" --sandbox "$SANDBOX_MODE" --skip-git-repo-check \
  - < "$S/$BRIEF" > "$LOG" 2>&1
CODE=$?
{ [ -f "$LOG" ] && printf 'child_exit=%s\n' "$CODE" > "$LOGEXIT"; } || printf 'child_exit=%s\n' "$CODE" > "$LOGEXIT"
echo "${LANE} exit=${CODE} log=${LOG}"

# D1/R1: never claim or accept a copy that did not happen; a failed receipt copy is fatal.
COPY_OK=0; RECEIPT_OK=0; MAN_OK=0
if [ -f "$LOG" ]; then
  if cp "$LOG" "$S/${LANE}_${STAMP}.log"; then
    COPY_OK=1
    if cp "$LOGEXIT" "$S/${LANE}_${STAMP}.exit" 2>/dev/null; then RECEIPT_OK=1; fi
  fi
fi
if [ "$COPY_OK" -eq 1 ]; then
  MSG="evidence(s4post-b): ${LANE} lane output ${STAMP} (lane log copied in from outside the worktree; child exit ${CODE})"
else
  MSG="evidence(s4post-b): ${LANE} lane METADATA ONLY ${STAMP} - no lane log was copied into the tree (child exit ${CODE}); do not read this as a completed lane"
  echo "POSTFLIGHT_LOG_COPY_FAILED log=$LOG" >&2
fi
[ "$RECEIPT_OK" -eq 1 ] || echo "POSTFLIGHT_RECEIPT_COPY_FAILED receipt=$LOGEXIT" >&2

# round-6 M1: the previous version wrote the manifest outside the worktree and then never
# copied it in, while its documentation claimed a postflight copy. Copy it, and fail if not.
if cp "$MAN" "$S/${LANE}_${STAMP}.manifest" 2>/dev/null; then MAN_OK=1; fi
[ "$MAN_OK" -eq 1 ] || echo "POSTFLIGHT_MANIFEST_COPY_FAILED manifest=$MAN" >&2

POSTFAIL=0
commit_all "$MSG" || POSTFAIL=1

# round-6 M5: a receipt whose write silently failed (for example the destination exists as a
# DIRECTORY) was still announced as written, and round-6 M6 showed the gate must also validate
# the receipt's CONTENT, so this writes a token-tagged body only when the write is verified.
REC="$S/${LANE}_${TOKEN}.receipt"; RECEIPT_WRITE=0
if [ "$COPY_OK" -eq 1 ] && [ "$RECEIPT_OK" -eq 1 ] && [ "$MAN_OK" -eq 1 ]; then
  if [ -e "$REC" ]; then
    echo "RECEIPT_ALREADY_EXISTS_REFUSED $REC" >&2
  elif printf 'lane=%s\nstamp=%s\ntoken=%s\nchild_exit=%s\nmodel=%s\nroute=%s\nqualified=%s\n' \
        "$LANE" "$STAMP" "$TOKEN" "$CODE" "$MODEL" "${ROUTE_STYLE:-openai}" "${QUALIFIED:-yes}" > "$REC" \
       && [ -f "$REC" ] && [ -s "$REC" ]; then
    RECEIPT_WRITE=1
    commit_all "evidence(s4post-b): ${LANE} lane receipt ${TOKEN} (child exit ${CODE})" \
      || { echo "RECEIPT_COMMIT_FAILED" >&2; POSTFAIL=1; }
  else
    echo "RECEIPT_WRITE_FAILED $REC" >&2
  fi
fi
[ "$RECEIPT_WRITE" -eq 1 ] || echo "NO_RECEIPT_WRITTEN" >&2

# round-6 M4: the FINAL status query happens AFTER the receipt commit, and only this result is
# reported. Previously the query ran before that commit, so a post-commit hook could leave dirt
# while the wrapper still printed the earlier "dirty=0" and returned 0.
DIRTY2="$(status_count)"
[ "$DIRTY2" != "ERR" ] || { echo "POSTFLIGHT_STATUS_FAILED" >&2; POSTFAIL=1; }
if [ "$DIRTY2" != "ERR" ] && [ "$DIRTY2" -ne 0 ]; then
  echo "POSTFLIGHT_DIRTY_REJECTED: $DIRTY2 path(s) still untracked after every commit" >&2; POSTFAIL=1
fi
echo "POSTFLIGHT:dirty=$DIRTY2 HEAD=$(git rev-parse --short HEAD)"
echo "${LANE}_LANE_DONE"

[ "$COPY_OK" -eq 1 ] || exit 4
[ "$RECEIPT_OK" -eq 1 ] || exit 6
[ "$MAN_OK" -eq 1 ] || exit 6
[ "$RECEIPT_WRITE" -eq 1 ] || exit 6
[ "$POSTFAIL" -eq 0 ] || exit 5
exit "$CODE"
#!/usr/bin/env bash
# Governed lane-set launcher with a fail-closed model/effort admission gate (v2).
#
# Prevention for the FAR finding: the EXECUTE lanes produced candidates on a model other than the
# assigned one, and nothing in the harness refused it.
#   1. the per-role model AND effort assignment is immutable (ROUND_ASSIGNMENT.json);
#   2. a differing model/effort is REFUSED unless an owner-decision record names that exact model;
#   3. the lane must survive GATE_QUALIFY_RUNS consecutive two-tool round trips through the SAME route,
#      model and effort the writers will use - a single pass proves little when the fault is intermittent;
#   4. child exits and per-launch receipts are aggregated; any failure fails the lane set.
#
# Round-5 repairs (independent officer, ADJUDICATION B "still fails open"):
#   R4 GATE_QUALIFY_RUNS=0 printed QUALIFICATION_PASSED with zero attempts -> the count must be a
#      positive integer or the gate refuses;
#   R5 the gate qualified EXECUTE through the catalog route but launched the writers through the default
#      route, i.e. it validated one lane and started another -> the role's route is now exported to the
#      children, and a test asserts the child's argv.
#
# Exit: 3 refused usage/input; 6 model deviation without an owner decision; 7 qualification failed;
#       8 the lane set had a failing child or a missing/failed receipt.
set -u

unset BASH_ENV ENV   # round-6 M7: do not inherit a caller-seeded shell start-up file

ROLE="${1:-}"; [ -n "$ROLE" ] || { echo "REFUSED[3] usage: run_lanes_gated.sh <EXECUTE|VERIFY> <brief>..." >&2; exit 3; }
shift
[ "$#" -ge 1 ] || { echo "REFUSED[3] no briefs given" >&2; exit 3; }

WT="${LANE_WT:-C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt}"
RELROUND=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"
R="$WT/$RELROUND"; S="$R/stage-b"
ASSIGN="$S/ROUND_ASSIGNMENT.json"; OWNERFILE="$S/OWNER_DECISION_MODEL_DEVIATION.md"
LOGDIR="${TMPDIR:-$LOCALAPPDATA/Temp}/hgk-lanes"; mkdir -p "$LOGDIR"
OUTSUB="${GATE_OUTSUB:-verify/gate}"
PDF="${GATE_PY:-python}"

[ -f "$ASSIGN" ] || { echo "REFUSED[3] assignment missing: ROUND_ASSIGNMENT.json" >&2; exit 3; }
read_role() { "$PDF" -c "import json,sys;r=json.load(open(sys.argv[1],encoding='utf-8'))['roles'][sys.argv[2]];print($1)" "$ASSIGN" "$ROLE" 2>/dev/null; }
READ="$( "$PDF" -c "import json,sys;r=json.load(open(sys.argv[1],encoding='utf-8'))['roles'][sys.argv[2]];print(r['model'],r['provider'],r['reasoning_effort'])" "$ASSIGN" "$ROLE" 2>/dev/null )"
[ -n "$READ" ] || { echo "REFUSED[3] role $ROLE is not in the assignment" >&2; exit 3; }
read -r A_MODEL A_PROV A_EFF <<< "$READ"
ROLE_STYLE="$(read_role "r.get('route',{}).get('style','openai')")"; ROLE_STYLE="${ROLE_STYLE:-openai}"
ROUTE_CATALOG="$(read_role "r.get('route',{}).get('catalog','C:/Users/user/.codex/desktop-model-catalog.json')")"
ROUTE_BASE_URL="$(read_role "r.get('route',{}).get('base_url','http://127.0.0.1:10102/v1')")"
echo "ASSIGNMENT role=$ROLE model=$A_MODEL provider=$A_PROV effort=$A_EFF route=$ROLE_STYLE"

REQ_MODEL="${LANE_MODEL:-$A_MODEL}"; REQ_PROV="${LANE_PROVIDER:-$A_PROV}"; REQ_EFF="${LANE_EFFORT:-$A_EFF}"
DEVIATED=0
[ "$REQ_MODEL" = "$A_MODEL" ] || DEVIATED=1
[ "$REQ_EFF" = "$A_EFF" ] || DEVIATED=1
if [ "$DEVIATED" -eq 1 ]; then
  if [ ! -f "$OWNERFILE" ]; then
    echo "MODEL_DEVIATION_REQUIRES_OWNER_DECISION requested=$REQ_MODEL/$REQ_EFF assigned=$A_MODEL/$A_EFF owner_record=MISSING"
    echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 6
  fi
  if ! grep -qx "authorizes: $REQ_MODEL" "$OWNERFILE"; then
    echo "MODEL_DEVIATION_REQUIRES_OWNER_DECISION requested=$REQ_MODEL is not named in the owner decision record"
    echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 6
  fi
  echo "OWNER_AUTHORISED_DEVIATION model=$REQ_MODEL effort=$REQ_EFF assigned=$A_MODEL/$A_EFF record=OWNER_DECISION_MODEL_DEVIATION.md"
fi

BIN="${GATE_BIN:-${CODEX_BIN:-/c/Users/user/AppData/Local/OpenAI/Codex/bin/2e5e00daee91c61d/codex.exe}}"
route_inv() {
  if [ "$ROLE_STYLE" = "catalog" ]; then
    printf '%s\n' -c "model=$REQ_MODEL" -c "model_reasoning_effort=\"$REQ_EFF\"" \
      -c "openai_base_url=$ROUTE_BASE_URL" -c "model_catalog_json=$ROUTE_CATALOG"
  else
    printf '%s\n' -m "$REQ_MODEL" -c "model_provider=\"$REQ_PROV\"" -c "model_reasoning_effort=\"$REQ_EFF\""
  fi
}
mapfile -t QINV < <(route_inv)

SKIP_ACK="$S/GATE_SKIP_QUALIFY_ACK.md"
if [ "${GATE_SKIP_QUALIFY:-0}" = "1" ]; then
  # round-6 M8: this was an exposed bypass - any caller could set it and admit a writer with no
  # qualification at all. It now needs an owner-visible acknowledgement file, and every lane
  # admitted this way is recorded as unqualified.
  if [ ! -f "$SKIP_ACK" ] || ! grep -q "^authorizes_skip_qualification: $ROLE$" "$SKIP_ACK"; then
    echo "QUALIFICATION_SKIP_UNAUTHORISED: GATE_SKIP_QUALIFY=1 needs GATE_SKIP_QUALIFY_ACK.md naming role $ROLE"
    echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 6
  fi
  QUALIFIED="no"
  echo "QUALIFICATION_SKIPPED_BY_ENV (authorised testing switch; a lane admitted this way is NOT qualified and the receipt records qualified=$QUALIFIED)"
else
  # R4: a configurable count is an input and must be validated.
  RUNS="${GATE_QUALIFY_RUNS:-3}"
  case "$RUNS" in ''|*[!0-9]*) echo "REFUSED[3] GATE_QUALIFY_RUNS must be a positive integer, got: $RUNS"; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3 ;; esac
  [ "$RUNS" -ge 1 ] || { echo "REFUSED[3] GATE_QUALIFY_RUNS must be >= 1, got: $RUNS"; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3; }
  QSAFE="$(printf %s "$REQ_MODEL" | tr -c 'A-Za-z0-9._-' '_')"
  echo "QUALIFICATION_ROUTE style=$ROLE_STYLE model=$REQ_MODEL effort=$REQ_EFF consecutive_runs_required=$RUNS"
  k=0
  while [ "$k" -lt "$RUNS" ]; do
    QLOG="$LOGDIR/qual-$(date -u +%Y%m%dT%H%M%SZ)-$$-${ROLE}-r$((k+1))-${QSAFE}.log"
    timeout 900 "$BIN" "${QINV[@]}" exec --cd "$WT" --sandbox read-only --skip-git-repo-check \
      - < "$S/GATE_QUALIFICATION_BRIEF.md" > "$QLOG" 2>&1
    QC=$?
    # round-6 M9: the sentinels alone are just strings - a stub that prints them passed the
    # gate without performing a single tool call. Require the CLI header and at least TWO
    # successful tool executions as well. Ceiling, stated plainly: any transcript-based check
    # can still be produced by a stub, so this raises the bar and does not prove provenance.
    TOOLLINES="$(grep -c ' succeeded in ' "$QLOG" 2>/dev/null | tr -d ' ')"
    if [ "$QC" -ne 0 ] || ! grep -q 'Q1_OK' "$QLOG" || ! grep -q 'Q2_OK' "$QLOG" \
       || ! grep -q 'OpenAI Codex v' "$QLOG" || [ "${TOOLLINES:-0}" -lt 2 ]; then
      echo "QUALIFICATION_FAILED model=$REQ_MODEL effort=$REQ_EFF attempt=$((k+1))/$RUNS exit=$QC tool_execs=${TOOLLINES:-0} log=$QLOG"
      echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 7
    fi
    echo "  qualification attempt $((k+1))/$RUNS PASS"
    k=$((k+1))
  done
  QUALIFIED="yes"
  echo "QUALIFICATION_PASSED model=$REQ_MODEL effort=$REQ_EFF consecutive_runs=$RUNS route=$ROLE_STYLE"
fi

if [ "${GATE_QUALIFY_ONLY:-0}" = "1" ]; then
  echo "GATE_QUALIFICATION_ONLY_OK role=$ROLE model=$REQ_MODEL effort=$REQ_EFF"
  exit 0
fi

GATE_STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
i=0; FAILED=0; MISSING=0
for B in "$@"; do
  [ -f "$S/$B" ] || { echo "REFUSED[3] brief not found: stage-b/$B" >&2; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3; }
  LANE="$(basename "$B" .md | tr 'a-z' 'A-Z' | tr -c 'A-Z0-9' '_' | cut -c1-14)"
  TOKEN="${GATE_STAMP}-${i}"
  # R5: the child is launched through the SAME route the qualification exercised.
  LANE_TOKEN="$TOKEN" LANE_INDEX="$i" LANE_ROLE="$ROLE" QUALIFIED="${QUALIFIED:-yes}" \
    LANE_MODEL="$REQ_MODEL" LANE_PROVIDER="$REQ_PROV" LANE_EFFORT="$REQ_EFF" \
    LANE_SANDBOX="${LANE_SANDBOX:-workspace-write}" ROUTE_STYLE="$ROLE_STYLE" ROUTE_CATALOG="$ROUTE_CATALOG" \
    ROUTE_BASE_URL="$ROUTE_BASE_URL" GATE_STUB_EXITS="${GATE_STUB_EXITS:-}" \
    env -u BASH_ENV -u ENV bash "$S/run_lane.sh" "$LANE" "$B" "$OUTSUB"
  C=$?
  echo "CHILD lane=$LANE index=$i exit=$C"
  [ "$C" -eq 0 ] || FAILED=1
  # round-6 M6: existence alone was enough, so an EMPTY file or a forged, wrong-token,
  # wrong-route receipt with child_exit=99 satisfied the gate. The content is validated now.
  RCP="$S/${LANE}_${TOKEN}.receipt"
  if [ ! -f "$RCP" ] || [ ! -s "$RCP" ]; then
    echo "CHILD_RECEIPT_MISSING lane=$LANE token=$TOKEN (absent, or not a non-empty regular file)"; MISSING=1
  elif ! grep -qx "token=$TOKEN" "$RCP" || ! grep -qx "child_exit=0" "$RCP" \
       || ! grep -qx "route=$ROLE_STYLE" "$RCP" || ! grep -qx "lane=$LANE" "$RCP"; then
    echo "CHILD_RECEIPT_INVALID lane=$LANE token=$TOKEN: $(tr '\n' ' ' < "$RCP" | cut -c1-160)"; MISSING=1
  fi
  i=$((i+1))
done

if [ "$FAILED" -ne 0 ] || [ "$MISSING" -ne 0 ]; then
  echo "LANE_SET_FAILED children_ok=$((i-FAILED)) any_child_nonzero=$FAILED missing_receipt=$MISSING model=$REQ_MODEL effort=$REQ_EFF"
  exit 8
fi
echo "LANE_SET_OK lanes=$i model=$REQ_MODEL effort=$REQ_EFF route=$ROLE_STYLE"

exec
"C:\\Users\\user\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\native\\powershell\\pwsh.exe" -Command '$r='"'.hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade'; "'$fs=@('"'verify/ao3/AO_VERDICT_STAGEB_R3.md','verify/ao4/AO_VERDICT_HANDOVER_R4.md','verify/ao5/AO_VERDICT_HANDOVER_R5.md','verify/ao6/AO_VERDICT_HANDOVER_R6.md','verify/ao7/AO7_LANE_FAILURE.md','verify/harness/HARNESS_DEFECT_LOG.md','verify/harness/QUALIFICATION_FINDINGS.md','AO5_RESULT.md'); foreach("'$f in $fs){ Write-Output "DOCUMENT $f"; Get-Content "$r/$f" | ForEach-Object { if($_ -match '"'(?i)credential|token.*secret|\\.env|\\.aws|\\.gitignore'){ '[credential-material reference redacted]' }else{"'$_} } }; Get-Content "$r/verify/harness/run_harness_negative_tests.sh"; Get-Content "$r/verify/harness/run_gate_negative_tests.sh"' in C:\Projects\Agent_Workspace\PIPD\worktrees\s4post-b-wt
