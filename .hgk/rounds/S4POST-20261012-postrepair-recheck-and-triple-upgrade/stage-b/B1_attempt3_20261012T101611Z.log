+                code = B.main(["--source-root", str(env.source), "--ledger", str(ledger_path),
+                               "--source-commit", COMMIT, "--packaging-root", str(env.packaging),
+                               "--out-dir", str(env.out)])
+            printed = captured.getvalue().strip()
+            self.assertEqual(printed,
