178: ck G14b_ROLE_CROSSING_REFUSED 6 "$(gitq LANE_MODEL=opencode-go/deepseek-v4-flash GATE_SKIP_QUALIFY=1)"
179: has G14b_names_the_axis "axis=model role=VERIFY" "$LOGD/G14b.out"
180: OUT=G14c; GARGS=(EXECUTE brief_nt_a.md)
181: ck G14c_PROVIDER_OVERRIDE_REFUSED 6 "$(gitq LANE_PROVIDER=unassigned GATE_SKIP_QUALIFY=1)"
182: has G14c_names_the_axis "axis=provider" "$LOGD/G14c.out"
183: OUT=G14d; GARGS=(EXECUTE brief_nt_a.md)
184: ck G14d_UNDECLARED_EFFORT_REFUSED 6 "$(gitq LANE_EFFORT=minimal GATE_SKIP_QUALIFY=1)"
185: has G14d_names_the_axis "axis=effort" "$LOGD/G14d.out"
186: # positive control: the role's own authorised value is still admitted, so the mechanism is a scope and
187: # not a blanket refusal
188: OUT=G14e; GARGS=(EXECUTE brief_nt_a.md)
189: ck G14e_AUTHORISED_VALUE_STILL_RUNS 0 "$(gitq LANE_MODEL=opencode-go/deepseek-v4-flash LANE_EFFORT=none GATE_SKIP_QUALIFY=1)"
190: has G14e_records_the_axes "axes=[ model effort]" "$LOGD/G14e.out"
191: 
192: echo "### G15 a log directory reached through a Windows junction is refused (round-10)"
193: # Round 10 showed the lexical pwd -P containment test is defeated by a junction; the gate wrote its
194: # log INSIDE the worktree and returned 0.
195: LJ="$LOGD/junction-in"; rm -rf "$LJ"; mkdir -p "$LJ"
196: JUNC="$LJ/j"; JUNC_PY="${GATE_PY:-python}"
197: # Create it with an API that does not go through the shell: `cmd //c mklink //J` returned success and
198: # created nothing here, which made the case pass because the path could not be RESOLVED rather than
199: # because the containment rule caught a junction - a false PASS.
200: "$JUNC_PY" - "$JUNC" "$CLONE" <<'EOPY' >/dev/null 2>&1
201: import os, subprocess, sys
202: link, target = sys.argv[1], sys.argv[2]
203: try:
204:     os.symlink(target, link, target_is_directory=True)
205: except Exception:
206:     r = subprocess.run(["cmd", "/c", "mklink", "/J", link.replace("/", "\\"), target.replace("/", "\\")], capture_output=True)
207:     if r.returncode != 0:
208:         sys.exit(1)
209: sys.exit(0 if os.path.isdir(link) else 1)
210: EOPY
211: if [ -d "$JUNC" ]; then
212:   OUT=G15; GARGS=(EXECUTE brief_nt_a.md)
213:   ck G15_JUNCTION_REFUSED 3 "$(gitq TMPDIR="$JUNC" GATE_SKIP_QUALIFY=1)"
214:   # The refusal must be the containment rule, not an inability to resolve the path.
215:   has G15_names_the_containment "inside the worktree" "$LOGD/G15.out"
216:   hasnot G15_not_a_resolve_failure "cannot resolve worktree/log paths" "$LOGD/G15.out"
217:   if [ -e "$CLONE/hgk-lanes" ]; then echo "FAIL G15_left_a_dir_in_the_worktree"; fail=$((fail+1)); else echo "PASS G15_left_no_dir_in_the_worktree"; pass=$((pass+1)); fi
218: else
219:   echo "SKIP G15_the_junction_could_not_be_created_here (reported, never passed)"
220: fi
221: 
222: echo "### G16 an unroled lane is refused, so an unassigned model cannot slip through (round-11)"
223: OUT=G16
224: env TMPDIR="$LOGD" LANE_WT="$CLONE" CODEX_BIN="$SBL" bash "$S/run_lane.sh" BRIEF_NT_A_ brief_nt_a.md verify/gate-norole >"$LOGD/G16.out" 2>&1; NRC=$?
225: ck G16_UNROLED_LANE_REFUSED 3 "$NRC"
226: has G16_names_the_reason "LANE_ROLE is required" "$LOGD/G16.out"
227: 
228: echo "### G17 a resolver that cannot decide must refuse, not proceed (round-11)"
229: # Round 11 got a gate to qualify while writing through a junction into the clone whenever the OS resolver
230: # failed: an undecided containment was treated as outside.
231: cat > "$LOGD/nopy" <<'EOS'
232: #!/usr/bin/env bash
233: [ "$1" = "-" ] && { echo "resolver failed" >&2; exit 1; }
234: exec python "$@"
235: EOS
236: chmod +x "$LOGD/nopy"
237: OUT=G17; GARGS=(EXECUTE brief_nt_a.md)
238: ck G17_UNDECIDED_CONTAINMENT_REFUSED 3 "$(gitq GATE_PY="$LOGD/nopy" GATE_SKIP_QUALIFY=1)"
239: has G17_names_the_containment "containment undecided" "$LOGD/G17.out"
240: 
241: echo
242: echo "RESULT pass=$pass fail=$fail"
243: [ "$fail" -eq 0 ] || exit 1

FILE verify/harness/run_checker_failover_tests.sh
1: #!/usr/bin/env bash
2: # Negative tests for the owner-declared checker failover (stage-b/run_checker_lane.sh).
3: # The point: the failover must fire on exhaustion ONLY. If it fires on any other failure it becomes a
4: # new fail-open - a model silently swapped in to turn a red lane green.
5: set -u
6: WT="${LANE_WT:-C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt}"
7: REL='.hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade'
8: # Native git does not translate MSYS-style paths on this host: a clone destination given as
9: # /tmp/x is created literally as \tmp\x, so the subsequent cd fails. Use a native path for
10: # anything a native binary must resolve.
11: LOGD="C:/Users/user/AppData/Local/Temp/fo-tests"; rm -rf "$LOGD"; mkdir -p "$LOGD"
12: CLONE="$LOGD/c"; E="$LOGD/lanes"; mkdir -p "$E"
13: export TMPDIR="$E"
14: pass=0; fail=0
15: ck(){ if [ "$2" = "$3" ]; then echo "PASS $1 (exit=$3)"; pass=$((pass+1)); else echo "FAIL $1 expected=$3 actual=$2"; fail=$((fail+1)); fi; }
16: has(){ if grep -qF -- "$2" "$3" 2>/dev/null; then echo "PASS $1"; pass=$((pass+1)); else echo "FAIL $1"; fail=$((fail+1)); fi; }
17: hasnot(){ if grep -qF -- "$2" "$3" 2>/dev/null; then echo "FAIL $1 (found: $2)"; fail=$((fail+1)); else echo "PASS $1"; pass=$((pass+1)); fi; }
18: 
19: cd "$WT" || exit 9
20: git -c safe.directory="$WT" clone -q --no-hardlinks . "$CLONE" >/dev/null 2>&1 || { echo "CLONE_FAILED"; exit 9; }
21: cd "$CLONE" || exit 9
22: git checkout -q "$(git -C "$WT" rev-parse HEAD)" 2>/dev/null
23: git config user.email nt@local.invalid; git config user.name nt
24: [ -f "$CLONE/$REL/stage-b/run_checker_lane.sh" ] || { echo "not in clone"; exit 9; }
25: 
26: # A stub worker: on its first call it reports the message in $1 and exits 1; on the next it succeeds.
27: mkstub(){
28:   cat > "$1" <<'EOS'
29: #!/usr/bin/env bash
30: STATE="$FO_STATE"
31: if [ ! -f "$STATE" ]; then
32:   : > "$STATE"
33:   echo "OpenAI Codex v0.162.0-alpha.17.2"
34:   echo "$FO_MSG"
35:   echo "exec a succeeded in 12ms:"
36:   echo "exec b succeeded in 11ms:"
37:   exit 1
38: fi
39: echo "OpenAI Codex v0.162.0-alpha.17.2"
40: echo "exec a succeeded in 12ms:"
41: echo "exec b succeeded in 11ms:"
42: echo "Q1_OK"; echo "Q2_OK"
43: exit 0
44: EOS
45:   chmod +x "$1"
46: }
47: STB="$LOGD/stub"; mkstub "$STB"
48: run(){ FO_STATE="$LOGD/st$1" FO_MSG="$2" CODEX_BIN="$STB" LANE_WT="$CLONE" bash "$CLONE/$REL/stage-b/run_checker_lane.sh" "FO$1" br_fo.md verify/fo$1 2>&1; }
49: 
50: echo "### A1 a provider content-filter kill must NOT be worked around by a model switch"
51: printf 'x\n' > "$CLONE/$REL/stage-b/br_fo.md"
52: run A "ERROR: This content was flagged for possible cybersecurity risk." > "$LOGD/A.out" 2>&1
53: # The primary's own exit code must be propagated: 1 means "failed", which is the point.
54: ck A1_nonzero_exit "$?" 1
55: has A1_says_not_exhaustion "CHECKER_PRIMARY_FAILED_NOT_EXHAUSTION" "$LOGD/A.out"
56: hasnot A1_did_not_fail_over "CHECKER_FAILOVER_START" "$LOGD/A.out"
57: hasnot A1_no_backup_ok "CHECKER_BACKUP_OK" "$LOGD/A.out"
58: 
59: echo "### A2 a protocol 400 must NOT be worked around by a model switch"
60: run B "Provider error 400: [invalid_request_error] The reasoning_content in the thinking mode must be passed back to the API." > "$LOGD/B.out" 2>&1
61: has B2_says_not_exhaustion "CHECKER_PRIMARY_FAILED_NOT_EXHAUSTION" "$LOGD/B.out"
62: hasnot B2_did_not_fail_over "CHECKER_FAILOVER_START" "$LOGD/B.out"
63: 
64: echo "### A3 an exhaustion signal DOES fail over, and records both models"
65: run C "ERROR: Selected model is at capacity. Please try a different model." > "$LOGD/C.out" 2>&1
66: ck A3_exit_zero "$?" 0
67: has A3_exhaustion_seen "CHECKER_PRIMARY_EXHAUSTED" "$LOGD/C.out"
68: has A3_failover_started "CHECKER_FAILOVER_START" "$LOGD/C.out"
69: has A3_backup_ok "CHECKER_BACKUP_OK" "$LOGD/C.out"
70: has A3_record_names_backup "opencode-go/glm-5.3-flash" "$CLONE/$REL/stage-b/CHECKER_FAILOVER_FOC.md"
71: has A3_record_names_primary "gpt-6.1-sol" "$CLONE/$REL/stage-b/CHECKER_FAILOVER_FOC.md"
72: has A3_record_says_identity_changes "changes the checker's identity" "$CLONE/$REL/stage-b/CHECKER_FAILOVER_FOC.md"
73: hasnot A3_no_record_for_the_killed_lane_unneeded "CHECKER_FAILOVER_START" "$LOGD/A.out"
74: 
75: echo "### A4 a protocol 400 whose text ALSO carries a quota word must NOT fail over (round-10)"
76: # Its own label: the stub consumes one state file per label, so reusing A3's label made the primary
77: # succeed on its first call and the case proved nothing.
78: run E "Provider error 400: [invalid_request_error] The reasoning_content in the thinking mode must be passed back. Service at capacity." > "$LOGD/E.out" 2>&1
79: ck A4_nonzero_exit "$?" 1
80: has A4_says_not_exhaustion "CHECKER_PRIMARY_FAILED_NOT_EXHAUSTION" "$LOGD/E.out"
81: has A4_names_the_hard_failure "hard_failure=[" "$LOGD/E.out"
82: hasnot A4_did_not_fail_over "CHECKER_FAILOVER_START" "$LOGD/E.out"
83: 
