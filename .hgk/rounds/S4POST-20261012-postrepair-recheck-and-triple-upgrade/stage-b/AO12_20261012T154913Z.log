FILE stage-b/run_lane.sh
1: #!/usr/bin/env bash
2: # Governed lane launcher (v3) - fail-closed, with the round-5 fail-open counterexamples closed.
3: #
4: # v1 (round 3): commit harness artifacts before handover; refuse a dirty worktree; log outside the tree.
5: # v2 (round 4): D1 no fail-open on a missing brief or a failed main-log copy; D2 reject postflight dirt;
6: #               D3 round-relative output only; F refuse a log dir inside the worktree.
7: # v3 (round 5) closes five counterexamples an independent officer demonstrated against v2:
8: #   R1 a failed receipt copy still returned 0                     -> receipt copy is checked and fatal
9: #   R2 a FAILED git status was read as "clean" (empty output)     -> a nonzero status query is fatal
10: #   R3 an already staged outside-round file got committed        -> staged paths outside the round are refused
11: #   R4 (gate-side) see run_lanes_gated.sh
12: #   R5 (gate-side) see run_lanes_gated.sh
13: #   A  the manifest was written inside the tree after the clean check, so the handover was dirtied by the
14: #      launcher itself; it is now written outside the tree and copied in at postflight, like the lane log.
15: #
16: # Exit: child's code on full success; 2 dirty/unverifiable preflight; 3 refused input/logdir;
17: #       4 lane log missing or uncopyable; 5 postflight dirty or unverifiable; 6 receipt or commit failed.
18: set -u
19: 
20: # round-6 M7 hygiene: this script must not depend on shell start-up files a caller can seed.
21: unset BASH_ENV ENV
22: 
23: LANE="${1:-}"; BRIEF="${2:-}"; OUTSUB="${3:-}"
24: [ -n "$LANE" ] && [ -n "$BRIEF" ] && [ -n "$OUTSUB" ] || { echo "REFUSED[3] usage: run_lane.sh <LANE> <brief> <round-relative-outsub>" >&2; exit 3; }
25: 
26: WT="${LANE_WT:-C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt}"
27: RELROUND=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"
28: R="$WT/$RELROUND"; S="$R/stage-b"
29: EMAIL="lane-harness@local.invalid"; NAME="hgk lane harness"
30: CODEX="${CODEX_BIN:-/c/Users/user/AppData/Local/OpenAI/Codex/bin/2e5e00daee91c61d/codex.exe}"
31: 
32: die() { echo "REFUSED[$1] $2" >&2; echo "REFUSED_${LANE}_DONE"; exit "$1"; }
33: 
34: # R2: a status query that FAILS must never be read as "clean". Counts, or the literal ERR.
35: status_count() {
36:   local out rc
37:   out="$(git status --porcelain 2>/dev/null)"; rc=$?
38:   [ "$rc" -eq 0 ] || { echo ERR; return; }
39:   printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' '
40: }
41: # R3 + round-6 M2/M3. The old form was
42: #   git diff --cached --name-only | grep -v "^${RELROUND}/"
43: # which had two fail-open holes an independent officer demonstrated:
44: #   * the "." in ".hgk" is a REGEX WILDCARD there, so a staged "Xhgk/rounds/.../outside.txt"
45: #     read as inside the round and was committed;
46: #   * a FAILED "git diff --cached --name-only" produced empty output, which read as "nothing
47: #     is staged outside the round".
48: # Fixed-string prefix matching via case, and the query's own exit status is checked.
49: staged_outside() {
50:   local out rc
51:   out="$(git diff --cached --name-only 2>/dev/null)"; rc=$?
52:   [ "$rc" -eq 0 ] || { echo "__STAGED_QUERY_FAILED__"; return; }
53:   # Two separate holes were demonstrated here, so both are closed explicitly:
54:   #   * a regex prefix ("^${RELROUND}/") treats the "." in ".hgk" as a wildcard;
55:   #   * `grep -v -F -- "${RELROUND}/"` fixes that but searches ANYWHERE in the line, so a staged
56:   #     "prefix/.hgk/rounds/<round>/outside.txt" is admitted and committed while the wrapper
57:   #     returns 0 (independent officer round 8, smallest counterexample).
58:   # A case pattern with a QUOTED variable is a literal, ANCHORED prefix match, which is what this
59:   # check always meant to be. The comment previously claimed "via case" while the code used grep;
60:   # the code now matches the comment.
61:   printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | while IFS= read -r _p; do
62:     case "$_p" in
63:       "$RELROUND"/*) ;;
64:       *) printf '%s\n' "$_p" ;;
65:     esac
66:   done
67: }
68: commit_all() {
