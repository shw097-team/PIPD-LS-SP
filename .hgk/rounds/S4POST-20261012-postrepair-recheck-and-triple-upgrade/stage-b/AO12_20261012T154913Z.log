154: echo "### G13 a committed receipt with duplicated conflicting fields is refused (round-8)"
155: # Round 8 forged a receipt that was committed and left the tree clean, carrying model=wrong,
156: # qualified=no and BOTH child_exit=0/99 and route=catalog/wrong. The gate returned 0 / LANE_SET_OK.
157: # The hook below injects the conflicting lines and amends, so the tree stays clean; only the gate's
158: # own receipt validation can catch it.
159: HOOK="$CLONE/.git/hooks/post-commit"
160: # A per-file sentinel, not one global marker: the clone carries receipts from the earlier cases, so a
161: # global marker was set during the preflight commit (on an OLD receipt) and the current receipt was
162: # never touched - the gate then correctly returned 0 and the case failed for its own fixture's reason.
163: printf '#!/usr/bin/env bash\nT="$(git rev-parse --show-toplevel)"\nfor f in "$T"/.hgk/rounds/*/stage-b/*.receipt; do\n  [ -f "$f" ] || continue\n  grep -q "^INJECTED=1$" "$f" && continue\n  printf "child_exit=99\\nroute=wrong\\nmodel=wrong-model\\nqualified=no\\nINJECTED=1\\n" >> "$f"\n  git add "$f"\n  git commit --amend --no-edit -q\ndone\nexit 0\n' > "$HOOK"
164: chmod +x "$HOOK"
165: OUT=G13; GARGS=(EXECUTE brief_nt_a.md)
166: ck G13_CONFLICTING_RECEIPT_REJECTED 8 "$(gitq GATE_SKIP_QUALIFY=1)"
167: has G13_names_the_receipt CHILD_RECEIPT_INVALID "$LOGD/G13.out"
168: rm -f "$HOOK"
169: 
170: echo "### G14 owner authorisation is per role, plain-valued and covers the provider axis (round-10)"
171: # Round 10 demonstrated: `.*` was "named" by any record (BRE match), an EXECUTE-scoped exception
172: # authorised a VERIFY lane, an unassigned provider bypassed the check, and effort was never checked.
173: OWNERBAK="$LOGD/owner.bak"; cp "$OWNER" "$OWNERBAK"
174: OUT=G14a; GARGS=(EXECUTE brief_nt_a.md)
175: ck G14a_REGEX_MODEL_REFUSED 6 "$(gitq LANE_MODEL='.*' GATE_SKIP_QUALIFY=1)"
