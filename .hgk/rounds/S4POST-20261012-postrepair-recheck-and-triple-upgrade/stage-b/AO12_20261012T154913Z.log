1: #!/usr/bin/env bash
2: # Governed CHECKER lane with the owner-declared failover.
3: #
4: # Primary checker : gpt-6.1-sol, provider openai (OAuth), route openai, reasoning medium  -- as assigned.
5: # Backup checker  : opencode-go/glm-5.3-flash, route catalog, per the owner's ruling of 2026-10-12:
6: #                   "倘若 checker model：GPT 6.1 SOL-MEDIUM(OPEN AI OAuth) 用量耗盡，checker model 就改用
7: #                    備援：GLM-5.3-Flash(OPENCODE GO)"
8: #
9: # Rules this wrapper enforces, so the failover cannot become a convenience:
10: #   * the backup runs ONLY when the primary lane failed AND its log carries an exhaustion signature
11: #     (quota / rate limit / 429 / capacity / usage limit). A content-filter kill, a safety flag, a
12: #     reasoning_content 400, a control-flow bug or any other failure does NOT fail over - it is reported.
13: #   * every failover is written to stage-b/CHECKER_FAILOVER_<LANE>.md with the primary log path, the
14: #     matched signature, both models, both stamps and both exit codes. A verdict produced by the backup
15: #     is a verdict by a DIFFERENT checker model and must disclose that.
16: #   * no silent retry: one primary attempt, at most one backup attempt.
17: #
18: # Exit: 0 only if one of the two attempts succeeded; otherwise the primary's exit code.
19: set -u
20: # A caller-seeded start-up file must not be able to widen this.
21: unset BASH_ENV ENV
22: 
23: LANE="${1:-}"; BRIEF="${2:-}"; OUTSUB="${3:-}"
24: [ -n "$LANE" ] && [ -n "$BRIEF" ] && [ -n "$OUTSUB" ] || { echo "usage: run_checker_lane.sh <LANE> <brief> <round-relative-outsub>" >&2; exit 3; }
25: 
26: S="$(cd "$(dirname "$0")" && pwd)"
27: WT="${LANE_WT:-C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt}"
28: LOGDIR="${TMPDIR:-$LOCALAPPDATA/Temp}/hgk-lanes"
29: CATALOG="${ROUTE_CATALOG:-C:/Users/user/.codex/desktop-model-catalog.json}"
30: BASE_URL="${ROUTE_BASE_URL:-http://127.0.0.1:10102/v1}"
31: 
32: PRIMARY_MODEL="gpt-6.1-sol";           PRIMARY_PROV="openai";     PRIMARY_ROUTE="openai"
33: BACKUP_MODEL="opencode-go/glm-5.3-flash"; BACKUP_PROV="opencode-go"; BACKUP_ROUTE="catalog"
34: 
35: # Only these signatures may trigger the declared failover.
36: EXHAUST_RE='quota|rate.?limit|429|too many requests|usage limit|insufficient|at capacity|capacity|exceeded your current'
37: # `HTTP 400` and `malformed payload` added: round 11 demonstrated a hard failure spelled that way beside an
38: # incidental quota word, which the previous pattern missed and which then switched models and "succeeded".
39: HARD_RE='invalid_request_error|reasoning_content|flagged for possible|cybersecurity|HTTP 4[0-9][0-9]|error 4[0-9][0-9]|status 4[0-9][0-9]|malformed payload'
40: 
41: # Every wrapper outcome leaves a tracked record, so a successful wrapper can never return 0 with an
42: # untracked artefact: the failover record and the no-failover record both go through this.
43: # Path spelling matters: the record can be an MSYS spelling (/tmp/..) while the worktree is native (C:/..),
44: # and a native git cannot be handed the other spelling. Run git from the record's own directory and name it
45: # by basename, and normalise the directory itself.
46: commit_record() { # $1 file, $2 message
47:   local f="$1" d b
48:   d="$(dirname "$f")"; b="$(basename "$f")"
49:   command -v cygpath >/dev/null 2>&1 && d="$(cygpath -m "$d")"
50:   git -C "$d" add -- "$b" 2>/dev/null
51:   if ! git -C "$d" -c user.email=lane-harness@local.invalid -c user.name="hgk lane harness" commit -q -m "$2" 2>/dev/null; then
52:     echo "CHECKER_RECORD_NOT_COMMITTED $b"; return 1
53:   fi
54:   if [ -n "$(git -C "$d" status --porcelain)" ]; then
55:     echo "CHECKER_RECORD_DIRTY $b"; return 1
56:   fi
57:   echo "CHECKER_RECORD_COMMITTED $b"; return 0
58: }
59: 
60: REC="$S/CHECKER_FAILOVER_${LANE}.md"
61: 
62: attempt() { # $1 model  $2 provider  $3 route  -> runs the governed launcher, prints its stdout
63:   local model="$1" prov="$2" route="$3"
64:   if [ "$route" = "catalog" ]; then
65:     LANE_WT="$WT" LANE_ROLE=VERIFY LANE_MODEL="$model" LANE_PROVIDER="$prov" ROUTE_STYLE=catalog \
66:       ROUTE_CATALOG="$CATALOG" ROUTE_BASE_URL="$BASE_URL" \
67:       bash "$S/run_lane.sh" "$LANE" "$BRIEF" "$OUTSUB"
68:   else
69:     LANE_WT="$WT" LANE_ROLE=VERIFY LANE_MODEL="$model" LANE_PROVIDER="$prov" ROUTE_STYLE=openai \
70:       bash "$S/run_lane.sh" "$LANE" "$BRIEF" "$OUTSUB"
71:   fi
72: }
73: 
74: echo "CHECKER_PRIMARY lane=$LANE model=$PRIMARY_MODEL route=$PRIMARY_ROUTE"
75: OUT1="$(attempt "$PRIMARY_MODEL" "$PRIMARY_PROV" "$PRIMARY_ROUTE")"; CODE1=$?
76: printf '%s\n' "$OUT1"
77: LOG1="$(printf '%s\n' "$OUT1" | sed -n 's/.*log=\([^ ]*\).*/\1/p' | tail -1)"
78: STAMP1="$(printf '%s\n' "$OUT1" | sed -n 's/^'"$LANE"'_LANE=\([0-9TZ]*\).*/\1/p' | tail -1)"
79: 
80: if [ "$CODE1" -eq 0 ]; then
81:   echo "CHECKER_PRIMARY_OK lane=$LANE stamp=$STAMP1"
82:   exit 0
83: fi
84: 
85: # The primary failed. Decide whether this is the exhaustion the owner's ruling covers.
86: # The classification must read the PROVIDER's own error channel, not the whole log. Round 11 was a review
87: # lane reading the very sources that quote a 400 and a content-filter notice, so every marker a
88: # whole-log matcher saw came from a quotation, not from the lane's own call - and the same weakness makes
89: # a genuine exhaustion unreachable in a lane that quotes quota text. Read the error lines; if the log has
90: # none, fall back to its last 80 lines, where a terminal provider failure lands.
91: ERRVIEW=""
92: if [ -n "$LOG1" ] && [ -f "$LOG1" ]; then
93:   ERRVIEW="$(mktemp)"
94:   grep -E '^(ERROR|error:|stream error|Codex error)' "$LOG1" > "$ERRVIEW" 2>/dev/null
95:   [ -s "$ERRVIEW" ] || tail -n 80 "$LOG1" > "$ERRVIEW"
96: fi
97: SIG=""
98: if [ -n "$ERRVIEW" ]; then
99:   SIG="$(grep -o -i -E "$EXHAUST_RE" "$ERRVIEW" | sort | uniq -c | sort -rn | head -5 | tr '\n' ';' )"
100: fi
101: HARD=""
102: [ -n "$ERRVIEW" ] && HARD="$(grep -o -i -E "$HARD_RE" "$ERRVIEW" 2>/dev/null | sort -u | tr '\n' ';')"
103: if [ -n "$HARD" ]; then
104:   # A protocol failure (an independent officer demonstrated a 400 invalid_request_error beside an
105:   # incidental quota word) used to switch models and then report success - the "work around a real
106:   # failure by switching models" the owner's ruling forbids. A hard-failure marker vetoes the switch.
107:   RECNF="$S/CHECKER_NOFAILOVER_${LANE}.md"
108:   { echo "# Checker failover NOT applied - $LANE"; echo
109:     echo "The primary lane failed and the failure was classified as NOT exhaustion, so no model was switched."
110:     echo
111:     echo "- lane: $LANE  primary exit: $CODE1  stamp: ${STAMP1:-unknown}"
112:     echo "- hard-failure markers: [$HARD]"
113:     echo "- exhaustion-looking markers: [$SIG]"
114:     echo "- classified from the provider error channel of: $LOG1 (fallback: its last 80 lines)"
115:   } > "$RECNF"
116:   commit_record "$RECNF" "evidence(s4post-b): checker no-failover record for $LANE" || exit 4
117:   echo "CHECKER_PRIMARY_FAILED_NOT_EXHAUSTION lane=$LANE exit=$CODE1 hard_failure=[$HARD] signature=[$SIG] - no failover, this is reported not worked around"
118:   exit "$CODE1"
119: fi
120: if [ -z "$SIG" ]; then
121:   echo "CHECKER_PRIMARY_FAILED_NOT_EXHAUSTION lane=$LANE exit=$CODE1 - no failover, this is reported not worked around"
122:   exit "$CODE1"
123: fi
124: 
125: echo "CHECKER_PRIMARY_EXHAUSTED lane=$LANE exit=$CODE1 signature=[$SIG]"
126: echo "CHECKER_FAILOVER_START lane=$LANE model=$BACKUP_MODEL route=$BACKUP_ROUTE"
127: 
128: OUT2="$(attempt "$BACKUP_MODEL" "$BACKUP_PROV" "$BACKUP_ROUTE")"; CODE2=$?
129: printf '%s\n' "$OUT2"
130: LOG2="$(printf '%s\n' "$OUT2" | sed -n 's/.*log=\([^ ]*\).*/\1/p' | tail -1)"
131: STAMP2="$(printf '%s\n' "$OUT2" | sed -n 's/^'"$LANE"'_LANE=\([0-9TZ]*\).*/\1/p' | tail -1)"
132: 
133: {
134:   echo "# Checker failover record - $LANE"
135:   echo
136:   echo "The owner's ruling of 2026-10-12: if the checker model GPT 6.1 SOL-MEDIUM (OpenAI OAuth) runs out"
137:   echo "of quota, the checker model switches to the declared backup GLM-5.3-Flash (OPENCODE GO)."
138:   echo
139:   echo "| | model | route | stamp | child exit | lane log |"
140:   echo "|---|---|---|---|---|---|"
141:   echo "| primary | \`$PRIMARY_MODEL\` | \`$PRIMARY_ROUTE\` | \`$STAMP1\` | $CODE1 | \`$LOG1\` |"
142:   echo "| backup  | \`$BACKUP_MODEL\` | \`$BACKUP_ROUTE\` | \`$STAMP2\` | $CODE2 | \`$LOG2\` |"
143:   echo
144:   echo "Exhaustion signature matched in the primary log: \`$SIG\`"
145:   echo
146:   echo "**This changes the checker's identity.** Any verdict produced under the backup was produced by a"
147:   echo "different model than the assigned checker, and the verdict document must say so. The failover does"
148:   echo "not transfer, and does not create, any acceptance this round would not otherwise have."
149: } > "$REC"
150: # FCR-006: the record was written after the launcher's own postflight, so the wrapper could return
151: # success while the record stayed untracked. Commit it, then re-read the status, as the launcher does.
152: commit_record "$REC" "evidence(s4post-b): checker failover record for $LANE" || exit 4
153: echo "CHECKER_FAILOVER_RECORD $REC"
154: 
155: if [ "$CODE2" -eq 0 ]; then echo "CHECKER_BACKUP_OK lane=$LANE stamp=$STAMP2"; exit 0; fi
156: echo "CHECKER_BACKUP_FAILED lane=$LANE exit=$CODE2"; exit "$CODE2"

