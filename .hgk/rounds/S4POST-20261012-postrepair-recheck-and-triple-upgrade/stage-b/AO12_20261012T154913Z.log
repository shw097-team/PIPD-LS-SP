234: else
235:   MSG="evidence(s4post-b): ${LANE} lane METADATA ONLY ${STAMP} - no lane log was copied into the tree (child exit ${CODE}); do not read this as a completed lane"
236:   echo "POSTFLIGHT_LOG_COPY_FAILED log=$LOG" >&2
