33: #!/usr/bin/env bash
34: echo "OpenAI Codex v0.162.0-alpha.17.2"
35: echo "exec echo Q1 succeeded in 12ms:"
36: echo "exec echo Q2 succeeded in 11ms:"
37: echo Q1_OK
38: echo Q2_OK
39: exit 0
40: EOF
41: printf '#!/usr/bin/env bash\necho "no qualification"\nexit 9\n' > "$SBQF"
42: SBARGV="$BASE/stub-argv.sh"
