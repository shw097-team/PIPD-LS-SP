125: # recording only the qualification would leave the writer's argv unchecked.
126: ck G9_EXECUTE_RUNS 0 "$(gitq GATE_QUALIFY_RUNS=1 GATE_BIN="$SBARGV" CODEX_BIN="$SBARGV" ARGV_LOG="$ARGV_LOG")"
127: if grep -q 'model=opencode-go/deepseek-v4.1-flash' "$ARGV_LOG"; then echo "PASS G9_child_used_the_catalog_slug"; pass=$((pass+1)); else echo "FAIL G9_child_used_the_catalog_slug"; fail=$((fail+1)); fi
128: if grep -q 'model_provider' "$ARGV_LOG"; then echo "FAIL G9_child_used_a_provider_id"; fail=$((fail+1)); else echo "PASS G9_child_did_not_use_a_provider_id"; pass=$((pass+1)); fi
129: if [ "$(grep -c 'model=opencode-go' "$ARGV_LOG")" -ge 2 ]; then echo "PASS G9_qualification_and_writer_agree"; pass=$((pass+1)); else echo "FAIL G9_qualification_and_writer_agree"; fail=$((fail+1)); fi
130: 
131: echo "### G10 a truncated / empty receipt must not satisfy the gate (M6)"
132: HOOK="$CLONE/.git/hooks/post-commit"
133: printf '#!/usr/bin/env bash\nfor f in "$(git rev-parse --show-toplevel)"/.hgk/rounds/*/stage-b/*.receipt; do : > "$f"; done\n' > "$HOOK"
134: chmod +x "$HOOK"
