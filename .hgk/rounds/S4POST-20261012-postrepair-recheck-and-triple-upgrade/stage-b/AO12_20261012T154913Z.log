44: #!/usr/bin/env bash
45: echo "$*" >> "${ARGV_LOG:-/dev/null}"
46: echo "OpenAI Codex v0.162.0-alpha.17.2"
47: echo "exec echo Q1 succeeded in 12ms:"
48: echo "exec echo Q2 succeeded in 11ms:"
49: echo Q1_OK
50: echo Q2_OK
51: exit 0
52: EOF
53: SBONLY="$BASE/stub-sentinels-only.sh"
