173:   else
174:     die 6 "model mismatch with the assignment and not owner-authorised: env=$MODEL assignment=$A_MODEL"
175:   fi
176:   if [ "$PROV" = "$A_PROV" ]; then
177:     :
178:   elif ! printf '%s' "$PROV" | grep -qE '^[A-Za-z0-9._+-]+$'; then
179:     die 6 "provider is not a plain identifier: env=$PROV"
180:   elif [ -f "$OWNERF" ] && grep -Fqx -- "authorizes_provider: $LANE_ROLE $PROV" "$OWNERF"; then
181:     echo "CHILD_OWNER_AUTHORISED_PROVIDER provider=$PROV assignment=$A_PROV"
182:   else
183:     die 6 "provider mismatch with the assignment and not owner-authorised: env=$PROV assignment=$A_PROV"
184:   fi
185:   if [ "$EFF" = "$A_EFF" ]; then
186:     :
187:   elif ! printf '%s' "$EFF" | grep -qE '^[A-Za-z0-9._+-]+$'; then
188:     die 6 "effort is not a plain identifier: env=$EFF"
189:   elif [ -f "$OWNERF" ] && grep -Fqx -- "authorizes_effort: $LANE_ROLE $EFF" "$OWNERF"; then
190:     echo "CHILD_OWNER_AUTHORISED_EFFORT effort=$EFF assignment_effort=$A_EFF"
191:   else
192:     die 6 "effort mismatch with the assignment and not owner-authorised: env=$EFF assignment=$A_EFF"
193:   fi
194:   if [ "$STYLE" != "$A_STYLE" ]; then
195:     # The route is a fourth axis: the owner's checker ruling runs the backup through the catalog route
196:     # although the VERIFY role is assigned the plain one, so it must be named here like any other axis.
197:     if [ -f "$OWNERF" ] && grep -Fqx -- "authorizes_route: $LANE_ROLE $STYLE" "$OWNERF"; then
198:       echo "CHILD_OWNER_AUTHORISED_ROUTE route=$STYLE assignment=$A_STYLE"
199:     else
200:       die 6 "route mismatch with the assignment and not owner-authorised: env=$STYLE assignment=$A_STYLE"
