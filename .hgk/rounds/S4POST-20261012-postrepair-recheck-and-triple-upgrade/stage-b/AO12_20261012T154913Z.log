150: OUT=G12; GARGS=(EXECUTE brief_nt_a.md)
151: ck G12_SENTINELS_ONLY_REFUSED 7 "$(gitq GATE_QUALIFY_RUNS=1 GATE_BIN="$SBONLY")"
152: has G12_names_qualification QUALIFICATION_FAILED "$LOGD/G12.out"
