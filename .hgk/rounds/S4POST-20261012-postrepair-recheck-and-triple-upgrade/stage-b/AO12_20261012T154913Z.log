1: #!/usr/bin/env bash
2: # Negative tests for the model/effort admission gate (run_lanes_gated.sh).
3: # External clone only; the Codex binary is replaced by stubs, so nothing is launched
4: # and no model call is spent.
5: set -u
6: WT="${LANE_WT:?LANE_WT must be the delivery worktree}"
7: BASE="${NT_BASE:-C:/Users/user/AppData/Local/Temp/nt-gate}"; CLONE="$BASE/clone"; LOGD="$BASE/logs"
8: rm -rf "$BASE"; mkdir -p "$LOGD"
9: SHA="$(git -C "$WT" rev-parse HEAD)" || { echo HEAD_UNRESOLVED; exit 9; }
10: git clone -q --no-hardlinks "$WT" "$CLONE" 2>/dev/null || { echo CLONE_FAILED; exit 9; }
11: git -C "$CLONE" checkout -q "$SHA" || { echo CHECKOUT_FAILED; exit 9; }
12: git -C "$CLONE" config user.email nt@local.invalid; git -C "$CLONE" config user.name nt
13: REL=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"; S="$CLONE/$REL/stage-b"
14: G="$S/run_lanes_gated.sh"; OWNER="$S/OWNER_DECISION_MODEL_DEVIATION.md"
