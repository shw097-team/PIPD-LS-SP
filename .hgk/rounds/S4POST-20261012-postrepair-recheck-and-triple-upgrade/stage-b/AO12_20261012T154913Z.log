76:     return 1
77:   fi
78:   if ! git diff --cached --quiet 2>/dev/null; then
79:     git -c user.email="$EMAIL" -c user.name="$NAME" commit -q -m "$1" >/dev/null 2>&1 || { echo "GIT_COMMIT_FAILED" >&2; return 1; }
80:   fi
81:   return 0
