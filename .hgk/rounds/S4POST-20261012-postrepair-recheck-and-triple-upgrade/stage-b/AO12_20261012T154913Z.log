248: # round-6 M5: a receipt whose write silently failed (for example the destination exists as a
249: # DIRECTORY) was still announced as written, and round-6 M6 showed the gate must also validate
250: # the receipt's CONTENT, so this writes a token-tagged body only when the write is verified.
251: REC="$S/${LANE}_${TOKEN}.receipt"; RECEIPT_WRITE=0
252: if [ "$COPY_OK" -eq 1 ] && [ "$RECEIPT_OK" -eq 1 ] && [ "$MAN_OK" -eq 1 ]; then
253:   if [ -e "$REC" ]; then
254:     echo "RECEIPT_ALREADY_EXISTS_REFUSED $REC" >&2
255: [the credential-material rule (redacted)]
256:         "$LANE" "$STAMP" "$TOKEN" "$CODE" "$MODEL" "${ROUTE_STYLE:-openai}" "${QUALIFIED:-no}" > "$REC" \
257:        && [ -f "$REC" ] && [ -s "$REC" ]; then
258:     RECEIPT_WRITE=1
259:     commit_all "evidence(s4post-b): ${LANE} lane receipt ${TOKEN} (child exit ${CODE})" \
260:       || { echo "RECEIPT_COMMIT_FAILED" >&2; POSTFAIL=1; }
261:   else
262:     echo "RECEIPT_WRITE_FAILED $REC" >&2
263:   fi
264: fi
265: [ "$RECEIPT_WRITE" -eq 1 ] || echo "NO_RECEIPT_WRITTEN" >&2
266: 
267: # round-6 M4: the FINAL status query happens AFTER the receipt commit, and only this result is
268: # reported. Previously the query ran before that commit, so a post-commit hook could leave dirt
269: # while the wrapper still printed the earlier "dirty=0" and returned 0.
270: # round 8: the HEAD read is taken FIRST. It was previously the last command to run, so a caller
271: # who exported a "git" function that writes a file could install dirt AFTER the status query and
272: # still see POSTFLIGHT:dirty=0 and exit 0. Nothing executable now runs after the query.
273: HEADV="$(git rev-parse --short HEAD 2>/dev/null)"; [ -n "$HEADV" ] || HEADV=UNKNOWN
274: DIRTY2="$(status_count)"
275: [ "$DIRTY2" != "ERR" ] || { echo "POSTFLIGHT_STATUS_FAILED" >&2; POSTFAIL=1; }
276: if [ "$DIRTY2" != "ERR" ] && [ "$DIRTY2" -ne 0 ]; then
277:   echo "POSTFLIGHT_DIRTY_REJECTED: $DIRTY2 path(s) still untracked after every commit" >&2; POSTFAIL=1
278: fi
279: echo "POSTFLIGHT:dirty=$DIRTY2 HEAD=$HEADV"
280: echo "${LANE}_LANE_DONE"
281: 
282: [ "$COPY_OK" -eq 1 ] || exit 4
283: [ "$RECEIPT_OK" -eq 1 ] || exit 6
284: [ "$MAN_OK" -eq 1 ] || exit 6
285: [ "$RECEIPT_WRITE" -eq 1 ] || exit 6
286: [ "$POSTFAIL" -eq 0 ] || exit 5
287: exit "$CODE"

FILE stage-b/run_lanes_gated.sh
1: #!/usr/bin/env bash
2: # Governed lane-set launcher with a fail-closed model/effort admission gate (v2).
3: #
4: # Prevention for the FAR finding: the EXECUTE lanes produced candidates on a model other than the
5: # assigned one, and nothing in the harness refused it.
6: #   1. the per-role model AND effort assignment is immutable (ROUND_ASSIGNMENT.json);
7: #   2. a differing model/effort is REFUSED unless an owner-decision record names that exact model;
8: #   3. the lane must survive GATE_QUALIFY_RUNS consecutive two-tool round trips through the SAME route,
9: #      model and effort the writers will use - a single pass proves little when the fault is intermittent;
10: #   4. child exits and per-launch receipts are aggregated; any failure fails the lane set.
11: #
12: # Round-5 repairs (independent officer, ADJUDICATION B "still fails open"):
13: #   R4 GATE_QUALIFY_RUNS=0 printed QUALIFICATION_PASSED with zero attempts -> the count must be a
14: #      positive integer or the gate refuses;
15: #   R5 the gate qualified EXECUTE through the catalog route but launched the writers through the default
16: #      route, i.e. it validated one lane and started another -> the role's route is now exported to the
17: #      children, and a test asserts the child's argv.
18: #
19: # Exit: 3 refused usage/input; 6 model deviation without an owner decision; 7 qualification failed;
20: #       8 the lane set had a failing child or a missing/failed receipt.
21: set -u
22: 
23: unset BASH_ENV ENV   # round-6 M7: do not inherit a caller-seeded shell start-up file
24: 
25: ROLE="${1:-}"; [ -n "$ROLE" ] || { echo "REFUSED[3] usage: run_lanes_gated.sh <EXECUTE|VERIFY> <brief>..." >&2; exit 3; }
26: shift
27: [ "$#" -ge 1 ] || { echo "REFUSED[3] no briefs given" >&2; exit 3; }
28: 
29: WT="${LANE_WT:-C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt}"
30: RELROUND=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"
31: R="$WT/$RELROUND"; S="$R/stage-b"
32: ASSIGN="$S/ROUND_ASSIGNMENT.json"; OWNERFILE="$S/OWNER_DECISION_MODEL_DEVIATION.md"
33: LOGDIR="${TMPDIR:-$LOCALAPPDATA/Temp}/hgk-lanes"
34: # round 8: the launcher refused a log dir inside the worktree but the GATE did not, so a
35: # qualify-only run wrote qualification logs into the tree and still returned 0, and the mkdir
36: # had already created an empty in-tree directory that git does not report. Same rule, before mkdir.
37: nrmg() { { cd "$1" && pwd -P; } 2>/dev/null | tr 'A-Z' 'a-z'; }
38: WTRES="$(nrmg "$WT")"; LGRES="$(nrmg "$(dirname "$LOGDIR")")"
39: [ -n "$WTRES" ] && [ -n "$LGRES" ] || { echo "REFUSED[3] cannot resolve worktree/log paths for the containment check" >&2; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3; }
40: case "$LGRES" in "$WTRES"|"$WTRES"/*) echo "REFUSED[3] gate log dir resolves inside the worktree: $LGRES" >&2; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3 ;; esac
41: mkdir -p "$LOGDIR"
42: # FCR-004: the lexical pwd -P comparison above is defeated by a Windows junction, which let the gate
43: # write its own log INSIDE the worktree and still return 0. Two weaker checks failed first: git's own
44: # status hid the probe because the target directory is ignored, and the shell's resolver does not resolve
45: # a junction at all. The OS resolver does, so the containment test is made against realpath.
46: CONTAIN="${GATE_PY:-python}"
47: INSIDE="$("$CONTAIN" - "$LOGDIR" "$WT" <<'EOPY' 2>/dev/null
48: import os, sys
49: d = os.path.realpath(sys.argv[1]); w = os.path.realpath(sys.argv[2])
50: d = os.path.normcase(d).rstrip(os.sep); w = os.path.normcase(w).rstrip(os.sep)
51: print("INSIDE" if (d == w or d.startswith(w + os.sep)) else "OUTSIDE")
52: EOPY
53: )"
54: case "$INSIDE" in
55:   INSIDE)  echo "REFUSED[3] gate log dir resolves inside the worktree: $LOGDIR" >&2
56:            echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3 ;;
57:   OUTSIDE) : ;;
58:   *)       echo "REFUSED[3] containment undecided by the OS resolver: $LOGDIR" >&2
59:            echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3 ;;
60: esac
61: OUTSUB="${GATE_OUTSUB:-verify/gate}"
62: PDF="${GATE_PY:-python}"
63: 
64: [ -f "$ASSIGN" ] || { echo "REFUSED[3] assignment missing: ROUND_ASSIGNMENT.json" >&2; exit 3; }
65: read_role() { "$PDF" -c "import json,sys;r=json.load(open(sys.argv[1],encoding='utf-8'))['roles'][sys.argv[2]];print($1)" "$ASSIGN" "$ROLE" 2>/dev/null; }
66: READ="$( "$PDF" -c "import json,sys;r=json.load(open(sys.argv[1],encoding='utf-8'))['roles'][sys.argv[2]];print(r['model'],r['provider'],r['reasoning_effort'])" "$ASSIGN" "$ROLE" 2>/dev/null )"
67: [ -n "$READ" ] || { echo "REFUSED[3] role $ROLE is not in the assignment" >&2; exit 3; }
68: read -r A_MODEL A_PROV A_EFF <<< "$READ"
69: ROLE_STYLE="$(read_role "r.get('route',{}).get('style','openai')")"; ROLE_STYLE="${ROLE_STYLE:-openai}"
70: ROUTE_CATALOG="$(read_role "r.get('route',{}).get('catalog','C:/Users/user/.codex/desktop-model-catalog.json')")"
71: ROUTE_BASE_URL="$(read_role "r.get('route',{}).get('base_url','http://127.0.0.1:10102/v1')")"
72: echo "ASSIGNMENT role=$ROLE model=$A_MODEL provider=$A_PROV effort=$A_EFF route=$ROLE_STYLE"
73: 
74: REQ_MODEL="${LANE_MODEL:-$A_MODEL}"; REQ_PROV="${LANE_PROVIDER:-$A_PROV}"; REQ_EFF="${LANE_EFFORT:-$A_EFF}"
75: DEVIATED=0; DEV_AXES=""
76: [ "$REQ_MODEL" = "$A_MODEL" ] || { DEVIATED=1; DEV_AXES="$DEV_AXES model"; }
77: [ "$REQ_EFF" = "$A_EFF" ] || { DEVIATED=1; DEV_AXES="$DEV_AXES effort"; }
78: # FCR-001/002/003: this block used to be a single BRE match on a bare `authorizes:` line, so a request
79: # of `.*` was "named" by any record, an EXECUTE-scoped exception authorised a VERIFY lane, an unassigned
80: # provider bypassed the check entirely, and the effort axis had no check at all. One plain value per
81: # axis, role-qualified, matched as a fixed string.
82: plain_id() { case "$1" in ""|*[!A-Za-z0-9._/-]*) return 1 ;; *) return 0 ;; esac; }
83: owner_named() { plain_id "$2" && grep -Fqx -- "authorizes_$1: $ROLE $2" "$OWNERFILE" 2>/dev/null; }
84: [ "$REQ_PROV" = "$A_PROV" ] || { DEVIATED=1; DEV_AXES="$DEV_AXES provider"; }
85: if [ "$DEVIATED" -eq 1 ]; then
86:   if [ ! -f "$OWNERFILE" ]; then
87:     echo "MODEL_DEVIATION_REQUIRES_OWNER_DECISION requested=$REQ_MODEL/$REQ_EFF/$REQ_PROV assigned=$A_MODEL/$A_EFF/$A_PROV owner_record=MISSING"
88:     echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 6
89:   fi
90:   for ax in $DEV_AXES; do
91:     case "$ax" in model) av="$REQ_MODEL" ;; effort) av="$REQ_EFF" ;; provider) av="$REQ_PROV" ;; esac
92:     if ! owner_named "$ax" "$av"; then
93:       echo "MODEL_DEVIATION_REQUIRES_OWNER_DECISION axis=$ax role=$ROLE requested=$av is not named for this role in the owner decision record"
94:       echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 6
95:     fi
96:   done
97:   echo "OWNER_AUTHORISED_DEVIATION role=$ROLE axes=[$DEV_AXES] model=$REQ_MODEL effort=$REQ_EFF provider=$REQ_PROV assigned=$A_MODEL/$A_EFF/$A_PROV record=OWNER_DECISION_MODEL_DEVIATION.md"
98: fi
99: 
100: BIN="${GATE_BIN:-${CODEX_BIN:-/c/Users/user/AppData/Local/OpenAI/Codex/bin/2e5e00daee91c61d/codex.exe}}"
101: route_inv() {
102:   if [ "$ROLE_STYLE" = "catalog" ]; then
103:     printf '%s\n' -c "model=$REQ_MODEL" -c "model_reasoning_effort=\"$REQ_EFF\"" \
104:       -c "openai_base_url=$ROUTE_BASE_URL" -c "model_catalog_json=$ROUTE_CATALOG"
105:   else
