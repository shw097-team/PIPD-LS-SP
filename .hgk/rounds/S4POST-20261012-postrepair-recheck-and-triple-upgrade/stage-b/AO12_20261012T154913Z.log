141: 
142: echo "### G11 GATE_SKIP_QUALIFY without an acknowledgement is refused (M8)"
143: mv "$S/GATE_SKIP_QUALIFY_ACK.md" "$S/GATE_SKIP_QUALIFY_ACK.md.hidden"
144: OUT=G11; GARGS=(EXECUTE brief_nt_a.md)
145: ck G11_SKIP_UNAUTHORISED_REFUSED 6 "$(gitq GATE_SKIP_QUALIFY=1)"
146: has G11_names_the_ack QUALIFICATION_SKIP_UNAUTHORISED "$LOGD/G11.out"
147: mv "$S/GATE_SKIP_QUALIFY_ACK.md.hidden" "$S/GATE_SKIP_QUALIFY_ACK.md"
148: 
