56: echo Q1_OK
57: echo Q2_OK
58: exit 0
59: EOF
60: chmod +x "$SBL" "$SBQ" "$SBQF" "$SBARGV" "$SBONLY"
61: 
62: pass=0; fail=0
63: ck(){ if [ "$2" = "$3" ]; then echo "PASS $1 (exit=$3)"; pass=$((pass+1)); else echo "FAIL $1 expected=$2 actual=$3"; fail=$((fail+1)); fi; }
64: has(){ if grep -qF -- "$2" "$3" 2>/dev/null; then echo "PASS $1"; pass=$((pass+1)); else echo "FAIL $1"; fail=$((fail+1)); fi; }
65: hasnot(){ if grep -qF -- "$2" "$3" 2>/dev/null; then echo "FAIL $1 (found: $2)"; fail=$((fail+1)); else echo "PASS $1"; pass=$((pass+1)); fi; }
