241: # copied it in, while its documentation claimed a postflight copy. Copy it, and fail if not.
242: if cp "$MAN" "$S/${LANE}_${STAMP}.manifest" 2>/dev/null; then MAN_OK=1; fi
243: [ "$MAN_OK" -eq 1 ] || echo "POSTFLIGHT_MANIFEST_COPY_FAILED manifest=$MAN" >&2
