#!/usr/bin/env bash
# Governed lane-set launcher with a fail-closed model/effort admission gate (v2).
#
# Prevention for the FAR finding: the EXECUTE lanes produced candidates on a model other than the
# assigned one, and nothing in the harness refused it.
#   1. the per-role model AND effort assignment is immutable (ROUND_ASSIGNMENT.json);
#   2. a differing model/effort is REFUSED unless an owner-decision record names that exact model;
#   3. the lane must survive GATE_QUALIFY_RUNS consecutive two-tool round trips through the SAME route,
#      model and effort the writers will use - a single pass proves little when the fault is intermittent;
#   4. child exits and per-launch receipts are aggregated; any failure fails the lane set.
#
# Round-5 repairs (independent officer, ADJUDICATION B "still fails open"):
#   R4 GATE_QUALIFY_RUNS=0 printed QUALIFICATION_PASSED with zero attempts -> the count must be a
#      positive integer or the gate refuses;
#   R5 the gate qualified EXECUTE through the catalog route but launched the writers through the default
#      route, i.e. it validated one lane and started another -> the role's route is now exported to the
#      children, and a test asserts the child's argv.
#
# Exit: 3 refused usage/input; 6 model deviation without an owner decision; 7 qualification failed;
#       8 the lane set had a failing child or a missing/failed receipt.
set -u

ROLE="${1:-}"; [ -n "$ROLE" ] || { echo "REFUSED[3] usage: run_lanes_gated.sh <EXECUTE|VERIFY> <brief>..." >&2; exit 3; }
shift
[ "$#" -ge 1 ] || { echo "REFUSED[3] no briefs given" >&2; exit 3; }

WT="${LANE_WT:-C:/Projects/Agent_Workspace/PIPD/worktrees/s4post-b-wt}"
RELROUND=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"
R="$WT/$RELROUND"; S="$R/stage-b"
ASSIGN="$S/ROUND_ASSIGNMENT.json"; OWNERFILE="$S/OWNER_DECISION_MODEL_DEVIATION.md"
LOGDIR="${TMPDIR:-$LOCALAPPDATA/Temp}/hgk-lanes"; mkdir -p "$LOGDIR"
OUTSUB="${GATE_OUTSUB:-verify/gate}"
PDF="${GATE_PY:-python}"

[ -f "$ASSIGN" ] || { echo "REFUSED[3] assignment missing: ROUND_ASSIGNMENT.json" >&2; exit 3; }
read_role() { "$PDF" -c "import json,sys;r=json.load(open(sys.argv[1],encoding='utf-8'))['roles'][sys.argv[2]];print($1)" "$ASSIGN" "$ROLE" 2>/dev/null; }
READ="$( "$PDF" -c "import json,sys;r=json.load(open(sys.argv[1],encoding='utf-8'))['roles'][sys.argv[2]];print(r['model'],r['provider'],r['reasoning_effort'])" "$ASSIGN" "$ROLE" 2>/dev/null )"
[ -n "$READ" ] || { echo "REFUSED[3] role $ROLE is not in the assignment" >&2; exit 3; }
read -r A_MODEL A_PROV A_EFF <<< "$READ"
ROLE_STYLE="$(read_role "r.get('route',{}).get('style','openai')")"; ROLE_STYLE="${ROLE_STYLE:-openai}"
ROUTE_CATALOG="$(read_role "r.get('route',{}).get('catalog','C:/Users/user/.codex/desktop-model-catalog.json')")"
ROUTE_BASE_URL="$(read_role "r.get('route',{}).get('base_url','http://127.0.0.1:10102/v1')")"
echo "ASSIGNMENT role=$ROLE model=$A_MODEL provider=$A_PROV effort=$A_EFF route=$ROLE_STYLE"

REQ_MODEL="${LANE_MODEL:-$A_MODEL}"; REQ_PROV="${LANE_PROVIDER:-$A_PROV}"; REQ_EFF="${LANE_EFFORT:-$A_EFF}"
DEVIATED=0
[ "$REQ_MODEL" = "$A_MODEL" ] || DEVIATED=1
[ "$REQ_EFF" = "$A_EFF" ] || DEVIATED=1
if [ "$DEVIATED" -eq 1 ]; then
  if [ ! -f "$OWNERFILE" ]; then
    echo "MODEL_DEVIATION_REQUIRES_OWNER_DECISION requested=$REQ_MODEL/$REQ_EFF assigned=$A_MODEL/$A_EFF owner_record=MISSING"
    echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 6
  fi
  if ! grep -qx "authorizes: $REQ_MODEL" "$OWNERFILE"; then
    echo "MODEL_DEVIATION_REQUIRES_OWNER_DECISION requested=$REQ_MODEL is not named in the owner decision record"
    echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 6
  fi
  echo "OWNER_AUTHORISED_DEVIATION model=$REQ_MODEL effort=$REQ_EFF assigned=$A_MODEL/$A_EFF record=OWNER_DECISION_MODEL_DEVIATION.md"
fi

BIN="${GATE_BIN:-${CODEX_BIN:-/c/Users/user/AppData/Local/OpenAI/Codex/bin/2e5e00daee91c61d/codex.exe}}"
route_inv() {
  if [ "$ROLE_STYLE" = "catalog" ]; then
    printf '%s\n' -c "model=$REQ_MODEL" -c "model_reasoning_effort=\"$REQ_EFF\"" \
      -c "openai_base_url=$ROUTE_BASE_URL" -c "model_catalog_json=$ROUTE_CATALOG"
  else
    printf '%s\n' -m "$REQ_MODEL" -c "model_provider=\"$REQ_PROV\"" -c "model_reasoning_effort=\"$REQ_EFF\""
  fi
}
mapfile -t QINV < <(route_inv)

if [ "${GATE_SKIP_QUALIFY:-0}" = "1" ]; then
  echo "QUALIFICATION_SKIPPED_BY_ENV (testing switch; a lane admitted this way is NOT qualified)"
else
  # R4: a configurable count is an input and must be validated.
  RUNS="${GATE_QUALIFY_RUNS:-3}"
  case "$RUNS" in ''|*[!0-9]*) echo "REFUSED[3] GATE_QUALIFY_RUNS must be a positive integer, got: $RUNS"; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3 ;; esac
  [ "$RUNS" -ge 1 ] || { echo "REFUSED[3] GATE_QUALIFY_RUNS must be >= 1, got: $RUNS"; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3; }
  QSAFE="$(printf %s "$REQ_MODEL" | tr -c 'A-Za-z0-9._-' '_')"
  echo "QUALIFICATION_ROUTE style=$ROLE_STYLE model=$REQ_MODEL effort=$REQ_EFF consecutive_runs_required=$RUNS"
  k=0
  while [ "$k" -lt "$RUNS" ]; do
    QLOG="$LOGDIR/qual-$(date -u +%Y%m%dT%H%M%SZ)-$$-${ROLE}-r$((k+1))-${QSAFE}.log"
    timeout 900 "$BIN" "${QINV[@]}" exec --cd "$WT" --sandbox read-only --skip-git-repo-check \
      - < "$S/GATE_QUALIFICATION_BRIEF.md" > "$QLOG" 2>&1
    QC=$?
    if [ "$QC" -ne 0 ] || ! grep -q 'Q1_OK' "$QLOG" || ! grep -q 'Q2_OK' "$QLOG"; then
      echo "QUALIFICATION_FAILED model=$REQ_MODEL effort=$REQ_EFF attempt=$((k+1))/$RUNS exit=$QC log=$QLOG"
      echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 7
    fi
    echo "  qualification attempt $((k+1))/$RUNS PASS"
    k=$((k+1))
  done
  echo "QUALIFICATION_PASSED model=$REQ_MODEL effort=$REQ_EFF consecutive_runs=$RUNS route=$ROLE_STYLE"
fi

if [ "${GATE_QUALIFY_ONLY:-0}" = "1" ]; then
  echo "GATE_QUALIFICATION_ONLY_OK role=$ROLE model=$REQ_MODEL effort=$REQ_EFF"
  exit 0
fi

GATE_STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
i=0; FAILED=0; MISSING=0
for B in "$@"; do
  [ -f "$S/$B" ] || { echo "REFUSED[3] brief not found: stage-b/$B" >&2; echo "GATE_REFUSED_NO_WRITERS_STARTED"; exit 3; }
  LANE="$(basename "$B" .md | tr 'a-z' 'A-Z' | tr -c 'A-Z0-9' '_' | cut -c1-14)"
  TOKEN="${GATE_STAMP}-${i}"
  # R5: the child is launched through the SAME route the qualification exercised.
  LANE_TOKEN="$TOKEN" LANE_INDEX="$i" LANE_MODEL="$REQ_MODEL" LANE_PROVIDER="$REQ_PROV" LANE_EFFORT="$REQ_EFF" \
    LANE_SANDBOX="${LANE_SANDBOX:-workspace-write}" ROUTE_STYLE="$ROLE_STYLE" ROUTE_CATALOG="$ROUTE_CATALOG" \
    ROUTE_BASE_URL="$ROUTE_BASE_URL" GATE_STUB_EXITS="${GATE_STUB_EXITS:-}" \
    bash "$S/run_lane.sh" "$LANE" "$B" "$OUTSUB"
  C=$?
  echo "CHILD lane=$LANE index=$i exit=$C"
  [ "$C" -eq 0 ] || FAILED=1
  # The receipt is per launch, so an older receipt cannot satisfy this check.
  if [ ! -f "$S/${LANE}_${TOKEN}.receipt" ]; then echo "CHILD_RECEIPT_MISSING lane=$LANE token=$TOKEN"; MISSING=1; fi
  i=$((i+1))
done

if [ "$FAILED" -ne 0 ] || [ "$MISSING" -ne 0 ]; then
  echo "LANE_SET_FAILED children_ok=$((i-FAILED)) any_child_nonzero=$FAILED missing_receipt=$MISSING model=$REQ_MODEL effort=$REQ_EFF"
  exit 8
fi
echo "LANE_SET_OK lanes=$i model=$REQ_MODEL effort=$REQ_EFF route=$ROLE_STYLE"
FILE=verify/harness/run_harness_negative_tests.sh
#!/usr/bin/env bash
# Negative + positive tests for the governed lane launcher (v2).
#
# They reproduce the three defects an independent officer demonstrated against v1
# (round 4, verdict PARTIAL) and assert the repaired behaviour, plus the
# successful-run log-copy branch that officer recorded as NOT_EXECUTED.
#
# Everything runs in an EXTERNAL clone checked out at the delivered HEAD; the
# delivery worktree is never modified. The Codex binary is replaced by a stub so
# the tests are deterministic, instant, and cost no model calls.
set -u
WT="${LANE_WT:?LANE_WT must be the delivery worktree}"
# Native forward-slash path on purpose: git and other native binaries do NOT
# translate MSYS paths, so a bare /tmp/... would land under a literal C:\tmp.
BASE="${NT_BASE:-C:/Users/user/AppData/Local/Temp/nt-launcher}"
CLONE="$BASE/clone"; LOGD="$BASE/logs"
rm -rf "$BASE"; mkdir -p "$LOGD"
SHA="$(git -C "$WT" rev-parse HEAD)" || { echo "HEAD_UNRESOLVED"; exit 9; }
git clone -q --no-hardlinks "$WT" "$CLONE" 2>/dev/null || { echo "CLONE_FAILED"; exit 9; }
git -C "$CLONE" checkout -q "$SHA" || { echo "CHECKOUT_FAILED"; exit 9; }
git -C "$CLONE" config user.email nt@local.invalid; git -C "$CLONE" config user.name nt
REL=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"
L="$CLONE/$REL/stage-b/run_lane.sh"
[ -f "$L" ] || { echo "LAUNCHER_NOT_IN_CLONE"; exit 9; }

STUB="$BASE/stub-codex.sh"
cat > "$STUB" <<'STUBEOF'
#!/usr/bin/env bash
echo "stub lane speaking: argv=$*"
if [ "${STUB_DIRT:-0}" = "1" ]; then printf 'injected dirt\n' > "$NT_WT/NT_POST_DIRT.txt"; fi
if [ "${STUB_ESCAPE:-0}" = "1" ]; then printf 'outside the round\n' > "$NT_WT/outside-the-round.txt"; fi
exit "${STUB_EXIT:-0}"
STUBEOF
chmod +x "$STUB"

pass=0; fail=0
ck() { if [ "$2" = "$3" ]; then echo "PASS $1 (exit=$3)"; pass=$((pass+1)); else echo "FAIL $1 expected=$2 actual=$3"; fail=$((fail+1)); fi; }
cknot() { if [ -e "$2" ]; then echo "FAIL $3 (exists: $2)"; fail=$((fail+1)); else echo "PASS $3"; pass=$((pass+1)); fi; }
ckeq() { if [ -e "$2" ]; then echo "PASS $3"; pass=$((pass+1)); else echo "FAIL $3 (missing: $2)"; fail=$((fail+1)); fi; }
has() { if grep -q "$2" "$3" 2>/dev/null; then echo "PASS $1"; pass=$((pass+1)); else echo "FAIL $1"; fail=$((fail+1)); fi; }
run() { TMPDIR="$LOGD" LANE_WT="$CLONE" CODEX_BIN="$STUB" STUB_EXIT="${1:-0}" STUB_DIRT="${2:-0}" STUB_ESCAPE="${3:-0}" NT_WT="$CLONE" bash "$L" "$4" "$5" "$6" >"$LOGD/$4.out" 2>&1; echo $?; }

echo "### T1 dirty preflight is refused (v1 passed this; regression guard)"
touch "$CLONE/NT_DIRT.txt"
ck T1_DIRTY_REFUSED 2 "$(run 0 0 0 NT1 brief_nt.md verify/nt)"
grep -q 'REFUSED\[2\]' "$LOGD/NT1.out" && { echo PASS T1_says_refused; pass=$((pass+1)); } || { echo FAIL T1_says_refused; fail=$((fail+1)); }
rm -f "$CLONE/NT_DIRT.txt"

echo "### T2 missing brief: D1a - refuse BEFORE launch, never fail open"
ck T2_MISSING_BRIEF_REFUSED 3 "$(run 0 0 0 NT2 DOES_NOT_EXIST.md verify/nt)"
if ls "$LOGD"/hgk-lanes/NT2_*.log >/dev/null 2>&1; then echo "FAIL T2_no_lane_log_written"; fail=$((fail+1)); else echo "PASS T2_no_lane_log_written"; pass=$((pass+1)); fi
if grep -q 'stub lane speaking' "$LOGD/NT2.out"; then echo "FAIL T2_child_was_launched"; fail=$((fail+1)); else echo "PASS T2_child_never_launched"; pass=$((pass+1)); fi

echo "### T3 successful run: log really copied in, commit says so, no stray root dir (D3)"
ck T3_STUB_SUCCESS 0 "$(run 0 0 0 NT3 brief_nt.md verify/nt)"
ls "$CLONE/$REL/stage-b/" | grep -q '^NT3_.*\.log$' && { echo PASS T3_log_copied_in; pass=$((pass+1)); } || { echo FAIL T3_log_copied_in; fail=$((fail+1)); }
# v3 makes two postflight commits (lane output, then the per-launch receipt), so the
# assertion must look past the receipt commit rather than only at HEAD.
git -C "$CLONE" log -2 --pretty=%B | grep -qi 'copied in from outside' && { echo PASS T3_commit_states_copy; pass=$((pass+1)); } || { echo FAIL T3_commit_states_copy; fail=$((fail+1)); }
ls "$CLONE/$REL/stage-b/NT3_"*.receipt >/dev/null 2>&1 && { echo PASS T3_per_launch_receipt_written; pass=$((pass+1)); } || { echo FAIL T3_per_launch_receipt_written; fail=$((fail+1)); }
cknot "x" "$CLONE/verify" "D3_no_output_dir_at_repo_root"
ckeq x "$CLONE/$REL/verify/nt" "D3_output_dir_is_round_relative"

echo "### T4 postflight dirt is REJECTED, not merely printed (D2)"
ck T4_POSTFLIGHT_DIRT_REJECTED 5 "$(run 0 1 0 NT4 brief_nt.md verify/nt)"
grep -q 'POSTFLIGHT:dirty=1' "$LOGD/NT4.out" && { echo PASS T4_dirt_was_detected; pass=$((pass+1)); } || { echo FAIL T4_dirt_was_detected; fail=$((fail+1)); }
rm -f "$CLONE/NT_POST_DIRT.txt"; git -C "$CLONE" checkout -q -- . 2>/dev/null; rm -f "$CLONE/outside-the-round.txt"

echo "### T5 a non-zero child is propagated, never advertised as success"
ck T5_CHILD_EXIT_PROPAGATED 7 "$(run 7 0 0 NT5 brief_nt.md verify/nt)"
grep -q 'NT5_LANE_DONE' "$LOGD/NT5.out" && { echo PASS T5_lane_reports_done; pass=$((pass+1)); } || { echo FAIL T5_lane_reports_done; fail=$((fail+1)); }

echo "### T6 TMPDIR resolving inside the worktree is refused (F)"
TMPDIR="$CLONE/tmp-inside" LANE_WT="$CLONE" CODEX_BIN="$STUB" bash "$L" NT6 brief_nt.md verify/nt >"$LOGD/NT6.out" 2>&1; c=$?
ck T6_TMPDIR_INSIDE_REFUSED 3 "$c"

echo "### T7 a failed receipt copy is fatal, not a note (R1)"
(
  cp() { local last="${@: -1}"; case "$last" in *.exit) return 23;; *) command cp "$@";; esac; }
  export -f cp
  env TMPDIR="$LOGD" LANE_WT="$CLONE" CODEX_BIN="$STUB" bash "$L" NT7 brief_nt.md verify/nt
) >"$LOGD/T7.out" 2>&1; c=$?
ck T7_RECEIPT_COPY_FATAL 6 "$c"
has T7_names_the_receipt POSTFLIGHT_RECEIPT_COPY_FAILED "$LOGD/T7.out"

echo "### T8 a FAILED git status is not a clean worktree (R2)"
(
  git() { if [ "${1:-}" = "status" ]; then return 128; fi; command git "$@"; }
  export -f git
  env TMPDIR="$LOGD" LANE_WT="$CLONE" CODEX_BIN="$STUB" bash "$L" NT8 brief_nt.md verify/nt
) >"$LOGD/T8.out" 2>&1; c=$?
ck T8_STATUS_FAILURE_REFUSED 2 "$c"
has T8_says_status_failed "git status failed" "$LOGD/T8.out"
if grep -q "stub lane speaking" "$LOGD/T8.out"; then echo "FAIL T8_child_was_launched"; fail=$((fail+1)); else echo "PASS T8_child_never_launched"; pass=$((pass+1)); fi

echo "### T9 an already staged OUTSIDE-round file is refused (R3)"
echo "outside" > "$CLONE/outside-round-fixture.txt"
git -C "$CLONE" add outside-round-fixture.txt
ck T9_STAGED_OUTSIDE_REFUSED 6 "$(run 0 0 0 NT9 brief_nt.md verify/nt)"
has T9_names_the_outside_path STAGED_OUTSIDE_ROUND_REFUSED "$LOGD/NT9.out"
if git -C "$CLONE" log -1 --pretty=%s | grep -q "outside-round-fixture"; then
  echo "FAIL T9_outside_file_was_committed"; fail=$((fail+1))
else echo "PASS T9_outside_file_was_not_committed"; pass=$((pass+1)); fi
git -C "$CLONE" reset -q 2>/dev/null; rm -f "$CLONE/outside-round-fixture.txt"

echo
echo "RESULT pass=$pass fail=$fail"
[ "$fail" -eq 0 ] || exit 1
FILE=verify/harness/run_gate_negative_tests.sh
#!/usr/bin/env bash
# Negative tests for the model/effort admission gate (run_lanes_gated.sh).
# External clone only; the Codex binary is replaced by stubs, so nothing is launched
# and no model call is spent.
set -u
WT="${LANE_WT:?LANE_WT must be the delivery worktree}"
BASE="${NT_BASE:-C:/Users/user/AppData/Local/Temp/nt-gate}"; CLONE="$BASE/clone"; LOGD="$BASE/logs"
rm -rf "$BASE"; mkdir -p "$LOGD"
SHA="$(git -C "$WT" rev-parse HEAD)" || { echo HEAD_UNRESOLVED; exit 9; }
git clone -q --no-hardlinks "$WT" "$CLONE" 2>/dev/null || { echo CLONE_FAILED; exit 9; }
git -C "$CLONE" checkout -q "$SHA" || { echo CHECKOUT_FAILED; exit 9; }
git -C "$CLONE" config user.email nt@local.invalid; git -C "$CLONE" config user.name nt
REL=".hgk/rounds/S4POST-20261012-postrepair-recheck-and-triple-upgrade"; S="$CLONE/$REL/stage-b"
G="$S/run_lanes_gated.sh"; OWNER="$S/OWNER_DECISION_MODEL_DEVIATION.md"
[ -f "$G" ] || { echo GATE_NOT_IN_CLONE; exit 9; }

SBL="$BASE/stub-lane.sh"; SBQ="$BASE/stub-qualify-ok.sh"; SBQF="$BASE/stub-qualify-fail.sh"
cat > "$SBL" <<'EOF'
#!/usr/bin/env bash
echo "stub lane"
if [ "${GATE_STUB_DELETE_LOG:-0}" = "1" ]; then
  L="$(ls -t "${TMPDIR:-$LOCALAPPDATA/Temp}/hgk-lanes"/*.log 2>/dev/null | head -1)"; [ -n "$L" ] && rm -f "$L"
fi
n="${LANE_INDEX:-0}"; v=0
for x in ${GATE_STUB_EXITS:-0}; do if [ "$n" -eq 0 ]; then v="$x"; break; fi; n=$((n-1)); done
exit "$v"
EOF
printf '#!/usr/bin/env bash\necho Q1_OK\necho Q2_OK\nexit 0\n' > "$SBQ"
printf '#!/usr/bin/env bash\necho "no qualification"\nexit 9\n' > "$SBQF"
SBARGV="$BASE/stub-argv.sh"
printf '#!/usr/bin/env bash\necho "$*" >> "${ARGV_LOG:-/dev/null}"\necho Q1_OK\necho Q2_OK\nexit 0\n' > "$SBARGV"
chmod +x "$SBL" "$SBQ" "$SBQF" "$SBARGV"

pass=0; fail=0
ck(){ if [ "$2" = "$3" ]; then echo "PASS $1 (exit=$3)"; pass=$((pass+1)); else echo "FAIL $1 expected=$2 actual=$3"; fail=$((fail+1)); fi; }
has(){ if grep -q "$2" "$3" 2>/dev/null; then echo "PASS $1"; pass=$((pass+1)); else echo "FAIL $1"; fail=$((fail+1)); fi; }
# env, not a bare "$@": the callers pass extra NAME=VALUE assignments and env accepts
# them before the command, whereas a bare expansion tried to execute them (exit 127).
gitq(){ env TMPDIR="$LOGD" LANE_WT="$CLONE" CODEX_BIN="$SBL" GATE_BIN="$SBQ" "$@" \
         bash "$G" "${GARGS[@]}" >"$LOGD/$OUT.out" 2>&1; echo $?; }

echo "### G1 a deviating model with NO owner record is refused, zero writers"
mv "$OWNER" "$OWNER.hidden"
OUT=G1; GARGS=(EXECUTE brief_nt_a.md)
ck G1_DEVIATION_REFUSED 6 "$(gitq LANE_MODEL=opencode-go/deepseek-v4-flash GATE_SKIP_QUALIFY=1)"
has G1_names_the_decision MODEL_DEVIATION_REQUIRES_OWNER_DECISION "$LOGD/G1.out"
has G1_started_no_writer GATE_REFUSED_NO_WRITERS_STARTED "$LOGD/G1.out"
if ls "$S"/BRIEF_NT_A_*.exit >/dev/null 2>&1; then echo "FAIL G1_a_writer_ran"; fail=$((fail+1)); else echo "PASS G1_no_writer_ran"; pass=$((pass+1)); fi
mv "$OWNER.hidden" "$OWNER"

echo "### G2 the SAME deviating model, now named in the owner record, is admitted"
OUT=G2; GARGS=(EXECUTE brief_nt_a.md)
ck G2_AUTHORISED_DEVIATION_RUNS 0 "$(gitq LANE_MODEL=opencode-go/deepseek-v4-flash GATE_SKIP_QUALIFY=1)"
has G2_records_the_deviation OWNER_AUTHORISED_DEVIATION "$LOGD/G2.out"
has G2_lane_set_ok LANE_SET_OK "$LOGD/G2.out"

echo "### G3 a model that cannot survive qualification is refused before any writer"
OUT=G3; GARGS=(EXECUTE brief_nt_a.md)
ck G3_QUALIFICATION_REFUSED 7 "$(gitq GATE_BIN="$SBQF")"
has G3_names_qualification QUALIFICATION_FAILED "$LOGD/G3.out"
has G3_started_no_writer GATE_REFUSED_NO_WRITERS_STARTED "$LOGD/G3.out"

echo "### G4 children exiting 0,1,0 must aggregate to a failed lane set"
OUT=G4; GARGS=(EXECUTE brief_nt_a.md brief_nt_b.md brief_nt_c.md)
ck G4_LANE_SET_FAILED 8 "$(gitq GATE_SKIP_QUALIFY=1 GATE_STUB_EXITS='0 1 0')"
has G4_says_nonzero LANE_SET_FAILED "$LOGD/G4.out"
has G4_counts_the_failure any_child_nonzero=1 "$LOGD/G4.out"

echo "### G5 a child that loses its run receipt is a failure even if it exited 0"
OUT=G5; # Unique brief names: G4 already committed receipts for A/B in the same clone, so an
# inherited receipt would make this assertion vacuous.
GARGS=(EXECUTE brief_nt_d.md brief_nt_e.md)
ck G5_MISSING_RECEIPT_FAILS 8 "$(gitq GATE_SKIP_QUALIFY=1 GATE_STUB_DELETE_LOG=1)"
has G5_names_missing_receipt CHILD_RECEIPT_MISSING "$LOGD/G5.out"

echo "### G6 an unknown role is refused"
OUT=G6; GARGS=(BOGUS_ROLE brief_nt_a.md)
ck G6_UNKNOWN_ROLE_REFUSED 3 "$(gitq GATE_SKIP_QUALIFY=1)"

echo "### G7 the assignment model with a working qualification passes end to end"
OUT=G7; GARGS=(VERIFY brief_nt_a.md)
ck G7_HAPPY_PATH 0 "$(gitq GATE_BIN="$SBQ")"
has G7_qualification_passed QUALIFICATION_PASSED "$LOGD/G7.out"
has G7_no_deviation_notice LANE_SET_OK "$LOGD/G7.out"

echo "### G8 zero qualification attempts must NOT be advertised as a qualified lane (R4)"
OUT=G8; GARGS=(EXECUTE brief_nt_a.md)
ck G8_ZERO_RUNS_REFUSED 3 "$(gitq GATE_QUALIFY_RUNS=0)"
has G8_says_refused "REFUSED\[3\]" "$LOGD/G8.out"
if grep -q "QUALIFICATION_PASSED" "$LOGD/G8.out"; then echo "FAIL G8_claimed_qualified"; fail=$((fail+1)); else echo "PASS G8_did_not_claim_qualified"; pass=$((pass+1)); fi

echo "### G9 the writer must be launched through the route that was qualified (R5)"
ARGV_LOG="$LOGD/g9-argv.txt"; : > "$ARGV_LOG"
OUT=G9; GARGS=(EXECUTE brief_nt_a.md)
# CODEX_BIN too: the writer lane is launched by run_lane.sh, which uses CODEX_BIN, so
# recording only the qualification would leave the writer's argv unchecked.
ck G9_EXECUTE_RUNS 0 "$(gitq GATE_QUALIFY_RUNS=1 GATE_BIN="$SBARGV" CODEX_BIN="$SBARGV" ARGV_LOG="$ARGV_LOG")"
if grep -q 'model=opencode-go/deepseek-v4.1-flash' "$ARGV_LOG"; then echo "PASS G9_child_used_the_catalog_slug"; pass=$((pass+1)); else echo "FAIL G9_child_used_the_catalog_slug"; fail=$((fail+1)); fi
if grep -q 'model_provider' "$ARGV_LOG"; then echo "FAIL G9_child_used_a_provider_id"; fail=$((fail+1)); else echo "PASS G9_child_did_not_use_a_provider_id"; pass=$((pass+1)); fi
if [ "$(grep -c 'model=opencode-go' "$ARGV_LOG")" -ge 2 ]; then echo "PASS G9_qualification_and_writer_agree"; pass=$((pass+1)); else echo "FAIL G9_qualification_and_writer_agree"; fail=$((fail+1)); fi

echo
echo "RESULT pass=$pass fail=$fail"
[ "$fail" -eq 0 ] || exit 1
FILE=verify/harness/HARNESS_DEFECT_LOG.md
# Harness defect log - round S4POST-20261012

Every defect below was found by running something, not by reading the code. Two of them were found by
the independent officer; two by using the new tools for real; one is a **false positive I produced and
then had to retract**. Kept because a harness that reports its own errors is the only kind worth
trusting, and because the retraction is the most instructive entry here.

## H1 - the handover was dirty by construction (found by the round-3 officer, verdict NOT_CLOSED)

- **Symptom**: every officer was handed a worktree carrying the harness's own brief, runner and lane log.
- **Cause**: the harness wrote its artifacts into the very worktree it then handed to the officer.
- **Fix**: `run_lane.sh` commits harness artifacts first, refuses to launch against a dirty worktree, and
  writes the lane log outside the worktree.
- **Evidence**: the officer independently confirmed the substantive closure (every path in the closure
  commits is under `.hgk/rounds/`, no code path changed) and rejected only the cleanliness promise.

## H2 - the launcher failed open three ways (found by the round-4 officer, verdict PARTIAL)

| ID | Demonstrated defect | Fix | Test |
|---|---|---|---|
| D1 | a missing brief and a failed log copy were masked; the wrapper exited 0 while its own child had failed, and still committed a message claiming the log had been copied in | validate the brief before launch; check the copy; state in the commit message whether a log was really copied; propagate the child status | T2, T5 |
| D2 | postflight detected dirt, printed `POSTFLIGHT:dirty=1`, and still exited 0 | detected dirt is a failure (exit 5) | T4 |
| D3 | `mkdir -p "$WT/$OUTSUB"` created the officer output directory at the **repository root**, outside the round's write set, so the round-relative fallback never ran | round-relative only, and `..`/absolute paths refused | T3 |

It also recorded that `TMPDIR` was never validated against the worktree; now refused (T6).

## H3 - the containment check could not fire (found while testing H2's fix)

- **Symptom**: T6 failed; a log directory inside the worktree was accepted.
- **Cause**: `pwd -W 2>/dev/null || pwd` printed **both** forms on this host - the `-W` form on stdout and
  then, because that form still returned nonzero, the plain form as well. The captured value carried two
  lines, so the `"$WTRES"/*` prefix test could never match.
- **Fix**: one normalising resolver (`cd ... && pwd -P`, lowercased) for both sides, with an explicit
  refusal when either side cannot be resolved.
- **Test**: T6 now passes and would fail again if the resolver regressed.

## H4 - the qualification log overwrote itself (found while using the gate)

- **Symptom**: two qualifications in the same wall-clock second wrote the same path; the second destroyed
  the first one's evidence, which is exactly the evidence I needed.
- **Fix**: the name carries role, sanitised model and pid.
- **Consequence**: the first EXECUTE qualification's raw log is **lost**, and it was not recoverable from
  anywhere else. It is not reconstructed or paraphrased anywhere in this round.

## H5 - the false positive, and the retraction (the important one)

- **What I did**: built the admission gate with the invocation `-m <model> -c model_provider="opencode-go"`.
- **What happened**: `Error: Model provider 'opencode-go' not found`. The gate reported
  `QUALIFICATION_FAILED` and refused, so it looked like the gate had reproduced the original lane failure.
- **What I claimed on that basis**: that the gate independently reproduced the assigned lane's failure,
  and that the assigned model cannot survive a two-tool round trip.
- **Why that claim was wrong**: `opencode-go/...` is a **model catalog slug**, not a provider id. The
  invocation the writers actually used is `-c model=<slug>` together with `openai_base_url` and
  `model_catalog_json`, with no `model_provider`. My gate therefore tested **my own misconfiguration**.
  The refusal was not evidence about the model at all.
- **Correction**: the route is now declared per role in `ROUND_ASSIGNMENT.json`, and both the gate and the
  launcher build the invocation from it, so the qualification and the writers use the identical route.
- **Result after the correction**: the assigned model
  (`opencode-go/deepseek-v4.1-flash`, effort `high`, catalog route) **PASSES** the two-tool round trip -
  `QUALIFICATION_PASSED`, `EXECUTE_QUALIFY_EXIT=0`, transcript at
  `verify/harness/qualification_logs/`.
- **The lesson, stated plainly**: a gate that fails closed on its own misconfiguration is worse than no
  gate, because it manufactures authoritative-looking refusals. Fail-closed protects against a bad lane;
  it does not protect against a bad test. Any refusal must name the exact configuration it refused, and a
  refusal that the operator cannot reproduce by hand is a harness bug until proven otherwise.

### H5 resolution

After the route was corrected the gate was run again requiring three consecutive passes. The assigned
lane passed attempt 1 and was rejected at attempt 2 with the original 400; the checker lane passed 3 of 3.
So the gate refuses the assigned lane, for a reason it measured rather than one it misconfigured - and
Correction 1 in `ACCEPTANCE_RECORD_STAGEB.md` over-corrected in the other direction and is itself
superseded by Correction 2. See `QUALIFICATION_FINDINGS.md`.

## H6 - two test-harness bugs of my own (cosmetic, recorded for completeness)

- the gate test helper built its command with a bare `"$@"` expansion of `NAME=VALUE` assignments, so every
  case exited 127; `env` is required.
- the receipt-isolation case re-used brief names from an earlier case, whose committed receipt made the
