HARD=""
[ -n "$LOG1" ] && [ -f "$LOG1" ] && HARD="$(grep -o -i -E "$HARD_RE" "$LOG1" 2>/dev/null | sort -u | tr '\n' ';')"
if [ -n "$HARD" ]; then
