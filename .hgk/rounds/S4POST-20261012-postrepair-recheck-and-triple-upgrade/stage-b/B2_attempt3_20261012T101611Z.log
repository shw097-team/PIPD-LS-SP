+        pack = self.pack(members, manifest=manifest, name="pack-escape")
+        self.assert_refused(pack, self.td / "escape.md", "PATH_ESCAPE")
+
+    # --------------------------------------------------------------- 9. non-text member
+
+    def test_non_utf8_member_refused(self):
