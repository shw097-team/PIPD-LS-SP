ck T6_TMPDIR_INSIDE_REFUSED 3 "$c"

echo "### T7 a failed receipt copy is fatal, not a note (R1)"
(
  cp() { local last="${@: -1}"; case "$last" in *.exit) return 23;; *) command cp "$@";; esac; }
