+        sentence = m.group(0)
+        self.assertIn("additionally", sentence)
+        self.assertRegex(
+            sentence, r"`project` and `export`\s+\*\*additionally\*\* accept `--root`")
+        for cmd in ("init", "intake", "profile", "compile-pi", "bind-pd",
+                    "compile-ecp", "compile-tqaep", "validate", "doctor"):
+            self.assertIn(
