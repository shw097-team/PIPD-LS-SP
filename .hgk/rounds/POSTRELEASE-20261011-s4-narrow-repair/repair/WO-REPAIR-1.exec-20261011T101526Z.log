+            self.assertNotEqual(same_1["ECP"], other["ECP"],
+                                "ECP digest did not track its PD root binding")
+            self.assertNotEqual(same_1["bundle"], other["bundle"],
+                                "bundle digest did not track its root-bound components")
+
