+                json.dumps(rows, ensure_ascii=False, sort_keys=True,
+                           separators=(",", ":")).encode("utf-8")).hexdigest()
+            return {"PI": pi["content_hash"], "TQAEP": tq["content_hash"],
+                    "PD": pd["content_hash"], "ECP": ecp["content_hash"],
