-  produce identical artefact digests across runs (`digests.json`).
+* The chain is **replay-deterministic for identical rooted inputs**: no timestamp enters a digested
+  field, so the **same intent, the same clause source and the same `RepoContext.root`** produce
+  identical artefact digests across runs (`digests.json`). The determinism is bounded on purpose:
+  PD binds an absolute `RepoContext.root` **by design**, and ECP is derived from PD, so a *different*
+  root legitimately yields different PD and ECP digests while PI and TQAEP stay identical. That is
+  **environment binding, not nondeterminism** — the same inputs at a different root are not the same
+  inputs.
 * Refusals are **typed and non-zero**: a missing source locator is refused `AUTHORITY_UNKNOWN`, and
   a stale `RepoContext` is refused `STALE_PROVIDER`; both are captured verbatim in
   `negative_stale_context.txt`.
diff --git a/tests/test_postrelease_quickstart.py b/tests/test_postrelease_quickstart.py
index be650f2f108a017f5cd3b89f3bc9ba6611532e58..7467c10ebfc9041e17b872dff0981b56057d09df
--- a/tests/test_postrelease_quickstart.py
+++ b/tests/test_postrelease_quickstart.py
@@ -153,5 +153,52 @@
                 )
 
 
+class QuickstartBashFailFast(unittest.TestCase):
+    """R1 (F07): the bash quickstart must fail fast and activate portably.
+
+    On Windows ``.venv/bin/activate`` does not exist, so a bare ``. .venv/bin/activate`` exits
+    non-zero while the unfailed block continues and ``pip install`` lands in the GLOBAL
+    interpreter. The block must therefore (1) start with ``set -e`` so the first failing step
+    aborts it, and (2) activate with a POSIX-or-Windows fallback so it never sources a
+    path that does not exist on the host.
+    """
+
+    def _quickstart_bash(self) -> str:
+        text = _readme_text()
+        block = next(
+            (b for b in _fenced_blocks(text, "bash") if WHEEL in b and SHA256SUMS in b), None)
+        self.assertIsNotNone(block, "no bash block fetches the wheel + SHA256SUMS")
+        return block
+
+    def test_block_starts_with_set_e(self) -> None:
+        lines = self._quickstart_bash().splitlines()
+        self.assertTrue(lines, "bash quickstart block is empty")
+        self.assertTrue(
+            lines[0].startswith("set -e"),
+            f"bash quickstart block must start with `set -e` (fail fast); first line is "
+            f"{lines[0]!r}",
+        )
+
+    def test_block_activates_portably_with_windows_fallback(self) -> None:
+        lines = self._quickstart_bash().splitlines()
+        self.assertTrue(
+            any("||" in ln and ".venv/Scripts/activate" in ln for ln in lines),
+            "bash quickstart block has no line that falls back to `.venv/Scripts/activate` "
+            "(the Windows layout)",
+        )
+
+    def test_no_bare_posix_only_activate(self) -> None:
+        # A bare `. .venv/bin/activate` (no fallback) exits non-zero on Windows and — absent a
+        # failing-fast guard — lets the block continue into a GLOBAL install.
+        for line in self._quickstart_bash().splitlines():
+            code = line.split("#", 1)[0]
+            if ".venv/bin/activate" in code:
+                self.assertIn(
+                    "||",
+                    code,
+                    f"a POSIX-only `.venv/bin/activate` line can fail silently: {line!r}",
+                )
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_postrelease_selfbootstrap.py b/tests/test_postrelease_selfbootstrap.py
index 0ce426e3c3660614efe1ee0f288aa61c60e4289b..a0263847337a9c8c407a9126d201c690b0b4d5f2
--- a/tests/test_postrelease_selfbootstrap.py
+++ b/tests/test_postrelease_selfbootstrap.py
@@ -68,6 +68,57 @@
             self.assertEqual(x["content_hash"], y["content_hash"])
             self.assertEqual(x["subject_id"], y["subject_id"])
 
+    def test_replay_is_root_bound_not_root_independent(self) -> None:
+        """The determinism the example advertises is bounded to identical rooted inputs (F03).
+
+        Same ``RepoContext.root`` -> identical PD/ECP/bundle digests (and everything else).
+        A *different* root -> PD and ECP digests may differ (PD digests the absolute root by
+        design and ECP derives from PD), while PI and TQAEP stay identical. This pins the
+        corrected, weaker claim: environment binding, not nondeterminism.
+        """
+        import hashlib
+        import tempfile
+
+        def slice_at(root):
+            card = pipeline.intake(GOAL, sources=[str(CLAUSE_SOURCE)],
+                                   constraints=["candidate-only, no release"],
+                                   non_goals=["no body copied"])
+            pi = pipeline.compile_pi(card, "LITE")
+            pd = pipeline.bind_pd(pi, {"root": str(root), "writable_scope": "src/**"})
+            ecp = pipeline.compile_ecp(pd, pi)
+            tq = pipeline.compile_tqaep(pi, ecp, maker="HERMES-MAKER",
+                                        checker="GLM-5.3-FLASH-AO-LANE",
+                                        checker_execution_receipt="deleg_example/lane-C")
+            # Bundle digest exactly as the example driver computes it (compute_digests):
+            # sha256 over the sorted per-artefact content hashes.
+            rows = {"intent_card": card["content_hash"], "pi": pi["content_hash"],
+                    "pd": pd["content_hash"], "ecp": ecp["content_hash"],
+                    "tqaep": tq["content_hash"]}
+            bundle = hashlib.sha256(
+                json.dumps(rows, ensure_ascii=False, sort_keys=True,
+                           separators=(",", ":")).encode("utf-8")).hexdigest()
+            return {"PI": pi["content_hash"], "TQAEP": tq["content_hash"],
+                    "PD": pd["content_hash"], "ECP": ecp["content_hash"],
+                    "bundle": bundle}
+
+        with tempfile.TemporaryDirectory(prefix="pipd_root_a_") as ra, tempfile.TemporaryDirectory(
+                prefix="pipd_root_b_") as rb:
+            # (a) same root, twice -> identical everywhere
+            same_1 = slice_at(ra)
+            same_2 = slice_at(ra)
+            self.assertEqual(same_1, same_2, "same-root replay is not deterministic")
+
+            # (b) different roots -> PI/TQAEP identical; PD/ECP (hence bundle) may differ
+            other = slice_at(rb)
+            self.assertEqual(same_1["PI"], other["PI"])
+            self.assertEqual(same_1["TQAEP"], other["TQAEP"])
+            self.assertNotEqual(same_1["PD"], other["PD"],
+                                "PD digest did not bind RepoContext.root")
+            self.assertNotEqual(same_1["ECP"], other["ECP"],
+                                "ECP digest did not track its PD root binding")
+            self.assertNotEqual(same_1["bundle"], other["bundle"],
+                                "bundle digest did not track its root-bound components")
+
     def test_trace_closure_has_no_orphans(self) -> None:
         _, pi, pd, ecp, _, tq = self._slice()
         rep = pipeline.trace_closure({"pi": pi, "pd": pd, "ecp": ecp, "tqaep": tq})

