156	class QuickstartBashFailFast(unittest.TestCase):
157	    """R1 (F07): the bash quickstart must fail fast and activate portably.
158	
159	    On Windows ``.venv/bin/activate`` does not exist, so a bare ``. .venv/bin/activate`` exits
160	    non-zero while the unfailed block continues and ``pip install`` lands in the GLOBAL
161	    interpreter. The block must therefore (1) start with ``set -e`` so the first failing step
162	    aborts it, and (2) activate with a POSIX-or-Windows fallback so it never sources a
163	    path that does not exist on the host.
164	    """
