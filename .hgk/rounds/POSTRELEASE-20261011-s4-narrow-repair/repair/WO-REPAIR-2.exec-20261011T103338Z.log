38	def _download_set(block: str) -> set[str]:
39	    """Files a shell block downloads: curl (any flags, incl. ``-fsSLO``) / Invoke-WebRequest /
40	    ``--output``. The filename is the trailing path segment of the destination."""
41	    names: set[str] = set()
42	    for line in block.splitlines():
43	        if line.strip().startswith("#"):
44	            continue
45	        if re.search(r"\bcurl\b", line):
46	            for match in re.finditer(r"\"([^\"]+)\"", line):
47	                names.add(Path(match.group(1)).name)
48	        for match in re.finditer(r"-OutFile\s+\"?([^\s\"']+)\"?", line):
49	            names.add(Path(match.group(1)).name)
50	        for match in re.finditer(r"--output[= ]\s*\"?([^\s\"']+)\"?", line):
