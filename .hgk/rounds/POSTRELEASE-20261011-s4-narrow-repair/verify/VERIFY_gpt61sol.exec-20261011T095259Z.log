"""Deterministic validation: schema + semantic invariants over the 19 families.

Deterministic only: no LLM judge is consulted here (總藍圖 §5.9.1 responsibility split).
"""
from __future__ import annotations

from pathlib import Path
import re
from typing import Any

from . import registry
from .errors import ValidationFail

CLAIM_LADDER = ["PROMPT_COMPILE_PASS", "HGK_ADMITTED", "RUNTIME_READY", "LOCAL_QUALIFIED",
                "INDEPENDENT_PASS", "PUBLICATION_APPROVED", "RELEASED", "PRODUCTION_VERIFIED"]
RELEASE_BOUND = ("PI-PKG", "PD-PKG", "ECP", "TQAEP", "ConstructionContract")

# CE-2 refinement (checker counterexample CE-CODEX-TRACE-WIDENING). Two DISTINCT concepts that
# used to be conflated into one list: "fields excluded from the body hash" and "fields that are
# not part of the record at all". They overlap only on `_profile_meta`.
#
# HASH_EXCLUDED_FIELDS -- the fields the body hash does NOT cover: the universal identity fields
#   (recomputed after sealing), the derived `trace` relation (it carries the parent hash, so it
#   cannot sit inside the hash it references) and the `_profile_meta` sidecar. This is the
#   HASH-EXCLUSION set ONLY; it says nothing about which fields a schema declares. `_body_hash`
#   and `pipeline._seal` both reference THIS object, so the hash and its recomputation stay one
#   definition and cannot diverge.
HASH_EXCLUDED_FIELDS = ("subject_id", "version", "content_hash", "schema_version", "trace",
                        "_profile_meta")

# NON_RECORD_SIDECARS -- the fields the pipeline emits for the operator/registry that NO schema
#   declares at all. Today that is exactly `_profile_meta`. `validate_record` strips ONLY this
#   set before the schema check, so a field that is hash-excluded but IS declared by the schema
#   (the identity fields, or `trace` on PI-PKG) remains schema-enforced, and an undeclared
#   `trace` on PD-PKG/ECP/TQAEP is again rejected by `additionalProperties: false`, exactly as
#   the published validator behaves.
NON_RECORD_SIDECARS = ("_profile_meta",)


def _validator(schema: dict[str, Any]):
    try:
        from jsonschema import Draft202012Validator
    except ImportError as exc:  # pragma: no cover
        raise ValidationFail(f"jsonschema unavailable: {exc}") from exc
    return Draft202012Validator(schema)


def validate_record(contract: str, record: dict[str, Any], schemas_dir: Path | None = None) -> list[str]:
    """Return a list of deterministic findings; empty list == schema-valid.

    Schema validation runs on a COPY of the record with the genuine non-record sidecars
    (``NON_RECORD_SIDECARS`` - today only ``_profile_meta``) removed, so a bundle assembled from
    the compilers' own stdout (which carries ``_profile_meta``) is held to its declared field set
    instead of tripping ``additionalProperties: false``. This is exactly the "stripped before
    validation" behavior ``pipeline`` already declares.

    ``NON_RECORD_SIDECARS`` is deliberately NOT the same set as ``HASH_EXCLUDED_FIELDS``: a field
    can be excluded from the body hash (``trace``, the identity fields) yet still be part of the
    record's contract, so its presence must remain schema-enforced. Only the genuine non-record
    sidecar ``_profile_meta`` is stripped; the defensive "unless the schema declares it" guard
    keeps that safe even if a future schema chooses to declare a sidecar. This closes CE-2 without
    widening the accepted input.
    """
    schema = registry.load_schema(contract, schemas_dir)
    v = _validator(schema)
    declared = set(schema.get("properties") or {})
    body = {k: val for k, val in record.items()
            if k not in NON_RECORD_SIDECARS or k in declared}
    findings = []
    for err in sorted(v.iter_errors(body), key=lambda e: list(e.absolute_path)):
        pointer = "/" + "/".join(str(x) for x in err.absolute_path)
        findings.append(f"{contract}{pointer}: {err.message}")
    return findings


HEX64 = re.compile(r"^[0-9a-f]{64}$")


def _body_hash(record: dict[str, Any]) -> str:
    """Recompute the record digest over everything EXCEPT the identity fields.

    Lets the validator catch a record whose body was edited without re-issuing its hash.
    """
    import hashlib
    import json
    body = {k: v for k, v in record.items() if k not in HASH_EXCLUDED_FIELDS}
    return hashlib.sha256(json.dumps(body, sort_keys=True, ensure_ascii=False,
                                     separators=(",", ":")).encode()).hexdigest()


def semantic_invariants(contract: str, record: dict[str, Any]) -> list[str]:
    """Semantic invariants that a JSON Schema cannot express."""
    out: list[str] = []
    ident = ("subject_id", "version", "content_hash", "schema_version")
    for field in ident:
        if field not in record:
            out.append(f"{contract}: missing universal identity field {field}")
    # C-5/C-6 repair: presence is not enough. An adversarial lane proved that null identities, a
    # non-hash content_hash and a tampered body all passed the previous presence-only check.
    for field in ident:
        if field in record and not str(record.get(field) or "").strip():
            out.append(f"{contract}: identity field {field} must be a non-empty string")
    ch = str(record.get("content_hash") or "")
    if ch and not HEX64.match(ch):
        out.append(f"{contract}: content_hash must be a 64-char lowercase sha256 hex digest")
    sid = str(record.get("subject_id") or "")
    if sid and len(sid) < 8:
        out.append(f"{contract}: subject_id is implausibly short to be a content id")
    if record.get("recomputed_body_hash_required") is True:
        pass  # explicit opt-out is itself rejected below for release-bound families
    if contract in RELEASE_BOUND and ch and len(record) > 4:
        if ch != _body_hash(record):
            out.append(f"{contract}: content_hash does not match the record body "
                       "(body edited without re-issuing identity)")
    sv = str(record.get("schema_version") or "")
    if sv and not (re.match(r"^[0-9]+\.[0-9]+\.[0-9]+$", sv) or re.match(r"^[A-Za-z0-9_.-]+@[0-9]+$", sv)):
        out.append(f"{contract}: schema_version must be semver or <Token>@<n>")
    if contract == "ClaimCeiling":
        allowed = set(record.get("allowed_claims", []))
        forbidden = set(record.get("forbidden_escalation", []))
        if allowed & forbidden:
            out.append("ClaimCeiling: a claim cannot be both allowed and forbidden")
        # C-8 repair: a maker could previously mint claim_ceiling(['INDEPENDENT_PASS']).
        receipts = record.get("receipts") or record.get("approval_receipt")
        authority = record.get("authority") or record.get("checker_identity")
        above = [c for c in allowed
                 if CLAIM_LADDER.index(c) > CLAIM_LADDER.index("LOCAL_QUALIFIED")]
        if above and not (receipts and authority):
            out.append("ClaimCeiling: claims above LOCAL_QUALIFIED require a bound approval "
                       "receipt AND a checker identity; a maker cannot mint them unilaterally")
    if contract == "TQAEP":
        # C-3 repair. The S0 TQAEP schema declares a fixed field set (additionalProperties=false),
        # so SoD evidence is carried INSIDE the declared `acceptance` field rather than by inventing
        # a 20th family or new top-level keys. An unsigned string comparison is not SoD.
        acc = record.get("acceptance")
        entries = [a for a in acc if isinstance(a, dict)] if isinstance(acc, list) else []
        if not entries:
            out.append("TQAEP: acceptance must carry a structured separation-of-duties entry "
                       "(maker/checker never compared or persisted = unproven independence)")
        for e in entries:
            maker, checker = e.get("maker_identity"), e.get("checker_identity")
            if not (maker and checker):
                out.append("TQAEP: acceptance entry missing maker_identity/checker_identity")
            elif maker == checker or e.get("distinct") is not True:
                out.append("TQAEP: maker and checker must be distinct with distinct=true")
            elif str(e.get("checker_execution_receipt") or "") in ("", "SELF_ATTESTED", "self", "same-process"):
                out.append("TQAEP: acceptance entry needs a checker_execution_receipt that is not "
                           "self-attested (maker cannot attest its own independence)")
    if contract == "WorkOrderCandidate":
        if record.get("candidate_only") is not True:
            out.append("WorkOrderCandidate: candidate_only must be fixed true (never runtime authority)")
    if contract == "GENIEProjectionRef":
        refs = record.get("target_refs")
        want = ("ProductGraph", "Profile", "Bundle", "GENIEArtifact")
        if not isinstance(refs, (list, dict)) or not all(
                any(w in str(x) for x in (refs if isinstance(refs, list) else refs.keys())) for w in want):
            out.append("GENIEProjectionRef: target_refs must cover ProductGraph/Profile/Bundle/GENIEArtifact")
    if contract == "ExecutionBindingRef" and str(record.get("state", "")).upper() == "ACKED":
        if not (record.get("receiver_binding_id") and record.get("receiver_binding_hash")):
            out.append("ExecutionBindingRef: ACK requires a real HGK receiver binding id+hash")
    if contract == "TraceLink":
        for side in ("from", "to"):
            if not (record.get(f"{side}_type") and record.get(f"{side}_id")):
                out.append(f"TraceLink: {side} endpoint incomplete")
    return out


def validate_bundle(bundle: dict[str, dict[str, Any]], schemas_dir: Path | None = None) -> dict[str, Any]:
    findings: list[dict[str, str]] = []
    # C-4 repair: validate_bundle({}) used to return PASS with checked=0. An empty denominator is
    # not a verification result.
    if not bundle:
        return {"verdict": "FAIL", "checked": 0,
                "findings": [{"contract": "*", "kind": "DENOMINATOR",
                              "detail": "empty bundle: zero records checked cannot be a PASS"}]}
    for contract, record in bundle.items():
        if not isinstance(record, dict):
            findings.append({"contract": contract, "kind": "SCHEMA",
                             "detail": "record must be an object"})
            continue
        for f in validate_record(contract, record, schemas_dir):
            findings.append({"contract": contract, "kind": "SCHEMA", "detail": f})
        for f in semantic_invariants(contract, record):
            findings.append({"contract": contract, "kind": "SEMANTIC", "detail": f})
    return {"verdict": "PASS" if not findings else "FAIL",
            "checked": len(bundle), "findings": findings}
"""Profile trio: LITE / STANDARD / ASSURED over one canonical truth (總藍圖 §7.3 #04)."""
from __future__ import annotations

from .errors import ProfileVeto, UnsupportedSurface

# axes -> artifact depth floor, required assurance
PROFILES = {
    "LITE": {"artifact_depth": "L1_SCHEMA_CONTRACT", "assurance": ["deterministic_validator"],
             "target_resolution": "package", "max_axes": 3},
    "STANDARD": {"artifact_depth": "L3_INTEGRATION_RUNTIME",
                 "assurance": ["deterministic_validator", "negative_security"],
                 "target_resolution": "integration", "max_axes": 6},
    "ASSURED": {"artifact_depth": "L4_FAILURE_RECOVERY",
                "assurance": ["deterministic_validator", "negative_security", "adversarial",
                              "independent_checker"],
                "target_resolution": "runtime", "max_axes": 10},
}
AXES = ("intent", "knowledge", "verification", "release", "trust_boundary",
        "preexisting_repo", "profile", "tech_candidates", "host_surface")


def compute_profile(requested: str, *, axes: list[str] | None = None,
                    provider_off_required: bool = False,
                    risk_evidence: dict | None = None) -> dict:
    """Resolve the effective profile over ONE canonical axis list.

    Fail-closed axis handling (D2): a malformed axis set is a typed refusal BEFORE any
    escalation math runs, and the NORMALISED list this function returns is the exact list the
    caller must emit, so the escalation basis (the axis count) and the emitted record can
    never disagree. ``pipeline.profile_record`` consumes ``result["axes"]`` verbatim.

    Risk honesty (D3): there is no per-axis risk score here. ``risk_assessment`` is
    ``"NOT_ASSESSED"`` unless risk evidence is explicitly supplied, and the ladder value
    ``"LOW_RISK_VERIFIED"`` is never emitted - an axis count is not a risk score.
    """
    name = (requested or "").upper()
    if name not in PROFILES:
        raise ProfileVeto(f"unknown profile {requested!r}")
    cfg = PROFILES[name]

    # ---- axis validation: fail closed, before any escalation math ----
    if axes is None:
        used = ["intent"]
    elif not isinstance(axes, (list, tuple)):
        raise ProfileVeto(
            f"axes must be a list of canonical axis names, got {type(axes).__name__}")
    else:
        used = list(axes)
    if not used:
        raise ProfileVeto("axes must be a non-empty list (an empty axis set binds no surface)")
    nonstr = [a for a in used if not isinstance(a, str)]
    if nonstr:
        raise ProfileVeto(f"axes must be strings; non-string entries {nonstr!r} refused")
    unknown = sorted({a for a in used if a not in AXES})
    if unknown:
        raise UnsupportedSurface(f"unknown axes {unknown}")
    dupes = sorted({a for a in used if used.count(a) > 1})
    if dupes:
        raise ProfileVeto(f"duplicated axis/axes refused (double-counted complexity): {dupes}")
    normalised = sorted(set(used))

    override = None
    # safety veto may ESCALATE depth, never reduce it
    if provider_off_required and name == "LITE":
        override = "STANDARD"
    if len(normalised) > cfg["max_axes"]:
        override = "ASSURED" if name != "ASSURED" else override
    effective = override or name

    # D3: state the absent risk assessment honestly. No evidence supplied -> NOT_ASSESSED.
    # Evidence supplied is recorded as UNVERIFIED, never rounded up to LOW_RISK_VERIFIED.
    risk_assessment = "NOT_ASSESSED" if not risk_evidence else "EVIDENCE_SUPPLIED_UNVERIFIED"
    return {"profile": effective,
            "requested_profile": name,
            "escalated": bool(override),
            "escalation_reason": "provider_off_parity" if override == "STANDARD" else
                                 ("axis_complexity" if override == "ASSURED" else None),
            "axes": normalised,
            "risk_assessment": risk_assessment,
            "vetoes": [],
            "artifact_depth": PROFILES[effective]["artifact_depth"],
            "assurance": PROFILES[effective]["assurance"],
            "canonical_truth": "single",  # all three profiles read one canonical truth
            }
#!/usr/bin/env python3
"""Source-constrained self-bootstrap example for PIPD-LS-SP (WO-S4-SELFBOOT-04).

This script proves that THIS repository, as shipped, can be driven from a frozen intent + a
minimal read-only RepoContext through the real compiler chain

    intent -> compile-pi -> bind-pd -> compile-ecp -> compile-tqaep -> validate

into an ISOLATED workspace root (never the repository), and that the result is reproducible
(same inputs -> identical artefact digests).

It is deliberately narrow. What it does NOT prove is stated in ``README.md``.

Usage
-----
    python run_selfbootstrap.py --root <disposable-dir-outside-the-repo>
    python run_selfbootstrap.py --root <disposable-dir> --negative missing-source
    python run_selfbootstrap.py --root <disposable-dir> --negative stale-context

The positive run also exercises both negatives internally and captures their RAW output into
``negative_stale_context.txt`` (never hand-written).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent          # examples/self-bootstrap
REPO = HERE.parents[1]                           # repository root
SRC = REPO / "src"
DEFAULT_INTENT = HERE / "input" / "intent.json"
DEFAULT_REPOCONTEXT = HERE / "input" / "repocontext.json"
CHAIN = ("init", "intake", "compile-pi", "bind-pd", "compile-ecp", "compile-tqaep", "validate")


# --------------------------------------------------------------------------- helpers
def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for block in iter(lambda: fh.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def _child_env() -> dict[str, str]:
    env = dict(os.environ)
    parts = [str(SRC)] + [p for p in env.get("PYTHONPATH", "").split(os.pathsep) if p]
    env["PYTHONPATH"] = os.pathsep.join(parts)
    return env


def cli(root: Path, *args: str) -> subprocess.CompletedProcess:
    """Run the repository's SHIPPED entry point non-interactively, from the repo cwd."""
    return subprocess.run(
        [sys.executable, "-m", "pipd_ls_sp.cli", "--root", str(root), *args],
        cwd=str(REPO), env=_child_env(), capture_output=True, text=True, encoding="utf-8")


def _read_json(path: Path) -> dict:
    return json.loads(Path(path).read_text(encoding="utf-8"))


def _write_json(path: Path, payload: dict) -> None:
    Path(path).write_text(json.dumps(payload, ensure_ascii=False, indent=1, sort_keys=True),
                          encoding="utf-8")


def _guard_root(root: Path) -> None:
    r = root.resolve()
    if str(r) == str(REPO.resolve()) or REPO.resolve() in r.parents:
        raise SystemExit(f"refused: --root {r} is inside the repository; use a disposable dir "
                         f"OUTSIDE {REPO}")


# --------------------------------------------------------------------------- chain
def drive_chain(root: Path, intent: dict, repoctx: dict, transcript: list[str]) -> dict:
    """Drive the documented commands into ``root``; return the collected artefacts + digests."""
    art_dir = root / "artifacts"
    ctx_dir = root / "pd_context"
    for d in (art_dir, ctx_dir):
        d.mkdir(parents=True, exist_ok=True)          # ctx_dir stays EMPTY (pristine context)

    def step(label: str, args: list[str], expect_zero: bool = True) -> dict:
        proc = cli(root, *args)
        transcript.append(f"### {label}")
        transcript.append(f"$ pipd {' '.join(args)}")
        transcript.append(f"[exit {proc.returncode}]")
        if proc.stdout.strip():
            transcript.append(proc.stdout.rstrip())
        if proc.stderr.strip():
            transcript.append("--- stderr ---")
            transcript.append(proc.stderr.rstrip())
        transcript.append("")
        if expect_zero and proc.returncode != 0:
            raise SystemExit(f"step {label} failed with exit {proc.returncode}")
        return json.loads(proc.stdout) if proc.stdout.strip() else {}

    step("init: create the isolated workspace via the CLI", ["init"])

    goal = intent["goal"]
    sources = list(intent.get("sources") or [])
    intake_args = ["intake", "--goal", goal]
    for s in sources:
        intake_args += ["--source", s]
    for c in intent.get("constraints") or []:
        intake_args += ["--constraint", c]
    for n in intent.get("non_goals") or []:
        intake_args += ["--non-goal", n]
    card = step("intake: compile clause-bound atoms into an IntentCard", intake_args)
    card_file = art_dir / "intent.card.json"
    _write_json(card_file, card)

    pi = step("compile-pi: PI package (LITE)",
              ["compile-pi", "--intent", str(card_file), "--profile", "LITE"])
    pi_file = art_dir / "pi.json"
    _write_json(pi_file, pi)

    # bind-pd derives a READ-ONLY RepoContext from the host. Against an EMPTY, pristine context
    # dir the derivation is deterministic (no tracked files, no dirty set), so the PD digest is
    # stable across replays regardless of prior artefact residue in ``root``.
    pd = step("bind-pd: late-bind PD against a read-only RepoContext",
              ["bind-pd", "--pi", str(pi_file), "--repo-root", str(ctx_dir)])
    pd_file = art_dir / "pd.json"
    _write_json(pd_file, pd)

    ecp = step("compile-ecp: execution contract",
               ["compile-ecp", "--pd", str(pd_file), "--pi", str(pi_file)])
    ecp_file = art_dir / "ecp.json"
    _write_json(ecp_file, ecp)

    tqaep = step("compile-tqaep: design-time separation-of-duties record",
                 ["compile-tqaep", "--pi", str(pi_file), "--ecp", str(ecp_file),
                  "--maker", "HERMES-MAKER", "--checker", "GLM-5.3-FLASH-AO-LANE",
                  "--checker-receipt", "deleg_example/lane-C"])
    tqaep_file = art_dir / "tqaep.json"
    _write_json(tqaep_file, tqaep)

    bundle = {"PI-PKG": pi, "PD-PKG": pd, "ECP": ecp, "TQAEP": tqaep}
    bundle_file = art_dir / "bundle.json"
    _write_json(bundle_file, bundle)
    validation = step("validate: schema + semantic invariants over the bundle",
                      ["validate", "--bundle", str(bundle_file)])

    return {"card": card, "pi": pi, "pd": pd, "ecp": ecp, "tqaep": tqaep,
            "validation": validation, "bundle_file": bundle_file,
            "files": {"intent_card": card_file, "pi": pi_file, "pd": pd_file,
                      "ecp": ecp_file, "tqaep": tqaep_file}}


# --------------------------------------------------------------------------- negatives
def neg_missing_source(transcript: list[str]) -> dict:
    """A source locator that does not exist on disk must be refused TYPED (AUTHORITY_UNKNOWN)."""
    from pipd_ls_sp import pipeline
    from pipd_ls_sp.errors import PipdError
    goal = _read_json(DEFAULT_INTENT)["goal"]
    bogus = "examples/self-bootstrap/input/does_not_exist.txt"
    transcript.append("### NEGATIVE: missing source locator")
    transcript.append(f"$ python -c 'pipeline.intake(goal, sources=[{bogus!r}])'")
    try:
        pipeline.intake(goal, sources=[bogus])
        out = {"verdict": "PASS", "code": None, "message": "UNEXPECTED: refused-nothing",
               "exit": 0}
    except PipdError as exc:
        out = {**exc.as_dict(), "exit": 2}
    transcript.append(json.dumps(out, ensure_ascii=False, sort_keys=True))
    transcript.append("")
    return out


def neg_stale_context(art: dict, ctx_dir: Path, transcript: list[str]) -> dict:
    """A RepoContext whose freshness claim does not bind to host truth is refused (STALE_PROVIDER)."""
    from pipd_ls_sp import pipeline
    from pipd_ls_sp import repo_context as repo_probe
    from pipd_ls_sp.errors import PipdError
    pi = art["pi"]
    stale = repo_probe.derive_repo_context(ctx_dir)
    stale["currentness_epoch"] = "0" * 64        # a claim that cannot match the host epoch
    transcript.append("### NEGATIVE: stale RepoContext")
    transcript.append("$ pipeline.bind_pd(pi, {root, currentness_epoch='0'*64, currentness='FRESH'})")
    try:
        pipeline.bind_pd(pi, stale)
        out = {"verdict": "PASS", "code": None, "message": "UNEXPECTED: refused-nothing",
               "exit": 0}
    except PipdError as exc:
        out = {**exc.as_dict(), "exit": 2}
    transcript.append(json.dumps(out, ensure_ascii=False, sort_keys=True))
    transcript.append("")
    return out


# --------------------------------------------------------------------------- digests
def compute_digests(art: dict) -> dict:
    """Deterministic digest record: file sha256 + the artefact's own content-addressed identity."""
    per = {}
    for name, path in art["files"].items():
        rec = None
        if name != "intent_card":
            rec = {"PI-PKG": art["pi"], "PD-PKG": art["pd"], "ECP": art["ecp"],
                   "TQAEP": art["tqaep"]}.get({"pi": "PI-PKG", "pd": "PD-PKG",
                                               "ecp": "ECP", "tqaep": "TQAEP"}[name])
        per[name] = {
            "file_sha256": sha256_file(path),
            "subject_id": (rec or art["card"]).get("subject_id"),
            "content_hash": (rec or art["card"]).get("content_hash"),
        }
    summary_rows = {k: per[k]["content_hash"] for k in per}
    combined = hashlib.sha256(
        json.dumps(summary_rows, ensure_ascii=False, sort_keys=True,
                   separators=(",", ":")).encode("utf-8")).hexdigest()
    return {
        "artifacts": per,
        "bundle_digest": combined,
        "validation": {"verdict": art["validation"].get("verdict"),
                       "checked": art["validation"].get("checked"),
                       "findings": art["validation"].get("findings"),
                       "schema_source": art["validation"].get("schema_source")},
        "note": ("Digests are recomputed from the artefacts of the actual run. No timestamp "
                 "enters any digested field, so the positive run is replay-stable."),
    }


def summary_line(art: dict, digests: dict) -> str:
    a = digests["artifacts"]
    return ("SELFBOOT-SUMMARY verdict=%s checked=%s pi=%s pd=%s ecp=%s tqaep=%s "
            "bundle_digest=%s" % (
                digests["validation"]["verdict"], digests["validation"]["checked"],
                a["pi"]["subject_id"], a["pd"]["subject_id"], a["ecp"]["subject_id"],
                a["tqaep"]["subject_id"], digests["bundle_digest"][:16]))


# --------------------------------------------------------------------------- main
def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="PIPD-LS-SP self-bootstrap example")
    ap.add_argument("--root", required=True, type=Path,
                    help="disposable workspace root OUTSIDE the repository")
    ap.add_argument("--intent", type=Path, default=DEFAULT_INTENT)
    ap.add_argument("--repocontext", type=Path, default=DEFAULT_REPOCONTEXT)
    ap.add_argument("--negative", choices=["missing-source", "stale-context"], default=None)
    args = ap.parse_args(argv)

    sys.path.insert(0, str(SRC))
    root = args.root.resolve()
    _guard_root(root)
    root.mkdir(parents=True, exist_ok=True)
    repoctx = _read_json(args.repocontext)

    transcript: list[str] = []

    if args.negative == "missing-source":
        out = neg_missing_source(transcript)
        print("\n".join(transcript))
        return out["exit"]
    if args.negative == "stale-context":
        art = drive_chain(root, _read_json(args.intent), repoctx, [])   # need a real PI to bind
        out = neg_stale_context(art, root / "pd_context", transcript)
        print("\n".join(transcript))
        return out["exit"]

    # ---- positive run -------------------------------------------------------
    intent = _read_json(args.intent)
    transcript.append("PIPD-LS-SP SELF-BOOTSTRAP TRANSCRIPT")
    transcript.append(f"repo   = {REPO}")
    transcript.append(f"root   = {root}")
    transcript.append(f"chain  = {' -> '.join(CHAIN)}")
    transcript.append("")
    art = drive_chain(root, intent, repoctx, transcript)
    digests = compute_digests(art)
    _write_json(HERE / "digests.json", digests)

    # the two negatives, exercised here so their RAW output is captured for real
    negatives = [neg_missing_source(transcript),
                 neg_stale_context(art, root / "pd_context", transcript)]
    neg_text = ["PIPD-LS-SP SELF-BOOTSTRAP NEGATIVE CASES (raw captured output)",
                f"root = {root}", ""] + transcript
    (HERE / "negative_stale_context.txt").write_text("\n".join(neg_text) + "\n", encoding="utf-8")

    line = summary_line(art, digests)
    transcript.append(line)
    print("\n".join(transcript))

    ok = (art["validation"].get("verdict") == "PASS"
          and all(n["exit"] != 0 and n["code"] for n in negatives))
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
