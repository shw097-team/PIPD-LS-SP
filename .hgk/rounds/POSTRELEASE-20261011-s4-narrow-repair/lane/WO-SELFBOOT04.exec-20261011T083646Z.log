def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="pipd", description=f"PIPD-LS-SP compiler CLI {__version__} (13 commands)")
    p.add_argument("--root", type=Path, default=Path.cwd())
