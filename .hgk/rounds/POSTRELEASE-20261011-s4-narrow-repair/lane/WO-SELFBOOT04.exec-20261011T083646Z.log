WEB_PACK_5 = ["index.html", "app.js", "styles.css", "manifest.webmanifest", "README.md"]


def init_workspace(root: Path) -> dict[str, Any]:
    created = []
    for rel in ("docs", "schemas", "src", "tests", "dist"):
        d = root / rel
        if not d.exists():
            d.mkdir(parents=True, exist_ok=True)
            created.append(rel)
