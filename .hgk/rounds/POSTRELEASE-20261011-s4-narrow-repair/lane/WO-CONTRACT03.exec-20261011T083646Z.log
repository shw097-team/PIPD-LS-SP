+class PositiveBundleTests(unittest.TestCase):
+    """A legal PI/PD/ECP/TQAEP bundle still validates (no over-narrowing)."""
+
+    def test_legal_bundle_still_validates(self) -> None:
+        with tempfile.TemporaryDirectory() as td:
