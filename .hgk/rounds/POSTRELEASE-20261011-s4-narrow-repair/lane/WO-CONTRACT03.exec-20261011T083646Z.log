+class UndeclaredTraceStillRefusedTests(unittest.TestCase):
+    """CE-2 guard restated: an undeclared ``trace`` on PD/ECP/TQAEP is still refused."""
+
+    def test_undeclared_trace_on_pd_ecp_tqaep_is_refused(self) -> None:
