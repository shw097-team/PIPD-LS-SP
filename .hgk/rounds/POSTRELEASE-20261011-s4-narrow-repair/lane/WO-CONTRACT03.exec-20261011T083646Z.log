+    tqaep = pipeline.compile_tqaep(pi, ecp, maker=MAKER, checker=CHECKER,
+                                   checker_execution_receipt=RECEIPT)
+    return {"PI-PKG": pi, "PD-PKG": pd, "ECP": ecp, "TQAEP": tqaep}
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)

