+            bundle = _compilers_bundle(repo)
+            for contract in ("PD-PKG", "ECP", "TQAEP"):
+                self.assertNotIn("trace", bundle[contract])
+                widened = dict(bundle[contract])
+                widened["trace"] = [{"undeclared": True}]
+                findings = _bundle(contract, widened)
+                self.assertTrue(
