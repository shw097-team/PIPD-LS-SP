+        with tempfile.TemporaryDirectory() as td:
+            repo = Path(td) / "repo"
+            _init_git_repo(repo)
+            blob = json.dumps(_compilers_bundle(repo))
+            self.assertNotIn("LOW_RISK_VERIFIED", blob)
+
