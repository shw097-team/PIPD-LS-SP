    "F1 challenge POST-F01"
   ]
  },
  {
   "journey_id": "J3_WEB_MOUNT_FIVE_CASES",
   "required": true,
   "user_goal": "A ChatGPT/Web consumer mounts the single versioned ZIP and gets sourced candidate answers while refusals stay typed.",
   "expected_automatic_behavior": [
    "the dispatcher SKILL.md routes to the references",
    "native upload and manual attachment fallback are described separately"
   ],
   "expected_manual_behavior": [
    "user attaches the ZIP or uploads the skill, depending on account capability"
   ],
   "expected_visible_result": "five recorded cases: positive PI trigger, negative small talk, missing RepoContext refusal, privilege-escalation/self-PASS refusal, first-time mount",
   "negative_behavior": [
    "the pack must not claim tool execution the host does not have"
   ],
   "failure_recovery": [
    "when native upload is unavailable the fallback path is recorded as NOT_SUPPORTED, never as a false PASS"
   ],
