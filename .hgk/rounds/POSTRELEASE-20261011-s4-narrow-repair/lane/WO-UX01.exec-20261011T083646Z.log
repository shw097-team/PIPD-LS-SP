 "journeys": [
  {
   "journey_id": "J1_FRESH_BASH_FIRST_RUN",
   "required": true,
   "user_goal": "In an empty directory outside the repository, a first-time user copies the README bash quickstart verbatim and every line exits 0.",
   "expected_automatic_behavior": [
    "only the listed files are downloaded",
    "the checksum check covers exactly the downloaded set",
    "pipd doctor reports the resolved schema source"
   ],
   "expected_manual_behavior": [
    "user supplies a writable empty directory"
   ],
   "expected_visible_result": "exit 0 per line, the wheel hash matches the published SHA-256, and a mutated byte makes the check exit non-zero",
   "negative_behavior": [
    "a missing asset or a wrong URL must fail loudly, never be skipped"
   ],
   "failure_recovery": [
    "re-running a partial download must not report OK for a file that is absent"
   ],
   "required_capabilities": [
    "CAP_S4POST_QUICKSTART_VERIFY"
   ],
   "source_expectation_ids": [
    "REQ-S4POST-UX-001"
   ],
   "allowed_hitl": [
    "PUBLICATION_APPROVAL"
   ],
   "source_locators": [
    "F0 prompt Gate P1 item 3",
    "F1 challenge §5"
   ]
  },
  {
   "journey_id": "J2_FRESH_POWERSHELL_FIRST_RUN",
