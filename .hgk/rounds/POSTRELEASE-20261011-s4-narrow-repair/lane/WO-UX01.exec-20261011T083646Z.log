   "user_goal": "The same first run succeeds from PowerShell on Windows using Get-FileHash.",
   "expected_automatic_behavior": [
    "the README carries a copy-paste PowerShell block",
    "the hash comparison uses the same published value"
   ],
   "expected_manual_behavior": [
    "user runs the block in a clean directory"
   ],
   "expected_visible_result": "Get-FileHash equals the published SHA-256 and the venv install then doctor succeed",
   "negative_behavior": [
    "no bash-only syntax in the PowerShell block"
   ],
   "failure_recovery": [
    "a wrong Python version is reported, not silently accepted"
   ],
   "required_capabilities": [
