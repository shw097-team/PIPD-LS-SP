+            if "pipd --root" in stripped:
+                # `--root` must be immediately followed by its value, then a subcommand.
+                self.assertRegex(
+                    stripped,
+                    r"pipd --root \S+ \S+",
+                    f"--root is not before the subcommand: {stripped!r}",
+                )
