diff --git a/src/pipd_ls_sp/profiles.py b/src/pipd_ls_sp/profiles.py
index d7ac74d..240174a 100644
--- a/src/pipd_ls_sp/profiles.py
+++ b/src/pipd_ls_sp/profiles.py
@@ -20,28 +20,63 @@ AXES = ("intent", "knowledge", "verification", "release", "trust_boundary",
 
 
 def compute_profile(requested: str, *, axes: list[str] | None = None,
