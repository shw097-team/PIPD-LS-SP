                                  ("axis_complexity" if override == "ASSURED" else None),
-            "axes": used,
+            "axes": normalised,
+            "risk_assessment": risk_assessment,
             "vetoes": [],
             "artifact_depth": PROFILES[effective]["artifact_depth"],
             "assurance": PROFILES[effective]["assurance"],
