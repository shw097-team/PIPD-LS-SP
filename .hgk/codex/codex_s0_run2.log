import copy
import json
import pathlib
from jsonschema import Draft202012Validator

root = pathlib.Path('.')
registry = json.loads((root / 'schemas/registry.json').read_text(encoding='utf-8'))
assert registry['schema'] == 'PIPD-S0-CONTRACT-REGISTRY/1'
rows = [line for line in (root / 'docs/S0_CONTRACT_SPEC.md').read_text(encoding='utf-8').splitlines() if line.startswith('| ') and line.split('|')[1].strip().isdigit()]
assert len(rows) == len(registry['families']) == 19
prose_fields = {
    'PI-PKG': ['stable_semantic_contract', 'trace', 'acceptance'],
    'WorkOrderCandidate': ['candidate_only'],
    'GENIEProjectionRef': ['target_refs'],
    'ExecutionBindingRef': ['receiver_binding_id', 'receiver_binding_version', 'receiver_binding_hash', 'lease', 'state'],
}
identity_fields = ['subject_id', 'version', 'content_hash', 'schema_version']
expected_files = {'registry.json'}
for row, family in zip(rows, registry['families']):
    index, contract, materialization, owner, consumer, field_text = [column.strip() for column in row.split('|')[1:-1]]
    fields = prose_fields.get(contract, field_text.split(', '))
    required = fields + [field for field in identity_fields if field not in fields]
    filename = f'{contract}.schema.json'
    expected_files.add(filename)
    assert family == {
        'index': index,
        'contract': contract,
        'materialization': materialization,
        'owner': owner,
        'consumers': [consumer],
        'required_fields': required,
        'schema_file': f'schemas/{filename}',
    }, contract
    schema = json.loads((root / family['schema_file']).read_text(encoding='utf-8'))
    Draft202012Validator.check_schema(schema)
    assert schema['"'$schema'"'] == 'https://json-schema.org/draft/2020-12/schema'
    assert schema['"'$id'"'] == f'urn:pipd:s0:{contract}:1'
    assert schema['type'] == 'object'
    assert schema['additionalProperties'] is False
    assert f'Owner: {owner}.' in schema['description']
    assert f'Consumer: {consumer}.' in schema['description']
    assert schema['required'] == required
    assert set(schema['properties']) == set(required)
    assert len(required) == len(set(required))
    canonical = lambda value: json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    assert canonical(family['required_fields']) == canonical(schema['required'])
    example = {field: 'example' for field in required}
    if contract == 'WorkOrderCandidate':
        example['candidate_only'] = True
    if contract == 'GENIEProjectionRef':
        example['target_refs'] = {name: 'example-ref' for name in ['ProductGraph', 'Profile', 'Bundle', 'GENIEArtifact']}
    validator = Draft202012Validator(schema)
    validator.validate(example)
    assert not validator.is_valid([])
    assert not validator.is_valid({**example, 'unexpected_field': True})
    for field in required:
        incomplete = copy.deepcopy(example)
        del incomplete[field]
        assert not validator.is_valid(incomplete), (contract, field)
    if contract == 'WorkOrderCandidate':
        assert not validator.is_valid({**example, 'candidate_only': False})
    if contract == 'GENIEProjectionRef':
        for name in example['target_refs']:
            incomplete = copy.deepcopy(example)
            del incomplete['target_refs'][name]
            assert not validator.is_valid(incomplete)
    print(f'PASS {family[\"schema_file\"]}')
assert {path.name for path in (root / 'schemas').iterdir()} == expected_files
