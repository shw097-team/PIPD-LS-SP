{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipd:s0:PI-PKG:1",
  "x-s0": {
    "index": "06",
    "contract": "PI-PKG",
    "materialization": "REQUIRED_NOW",
    "owner": "PIPD",
    "consumers": ["PD binder"]
  },
  "type": "object",
  "description": "Owner: PIPD. Consumer: PD binder.",
  "additionalProperties": false,
  "required": [
    "stable_semantic_contract",
    "trace",
    "acceptance",
    "subject_id",
    "version",
    "content_hash",
    "schema_version"
  ],
  "properties": {
    "stable_semantic_contract": {
      "description": "Stable semantic contract."
    },
    "trace": {
      "description": "Trace links from this PI to its RequirementAtom records. Inlined constraint equivalent to urn:pipd:s0:TraceLink:1 (that $id is NOT resolvable by the pinned harness validator, so a bare $ref / remote resolve is refused); a string, null or object is not an array and is refused.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_type",
          "from_id",
          "from_hash",
          "to_type",
          "to_id",
          "to_hash",
          "rationale",
          "subject_id",
          "version",
          "content_hash",
          "schema_version"
        ]
      }
    },
    "acceptance": {},
    "subject_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
