{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pipd-ls-sp-public-skills",
  "version": "0.1.1",
  "description": "PIPD-LS-SP public Skills-only plugin: the eight fail-closed lifecycle skills, packaged deterministically as an Agent Plugins 1.0 candidate. claim_ceiling=LOCAL_PACKAGER_PASS_ONLY; the vendor's own validator and the Agent Plugins Portal scan are NOT_EXECUTED.",
  "repository": "https://github.com/shw097-team/PIPD-LS-SP",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugins",
    "skills",
    "pipd",
    "lifecycle",
    "fail-closed"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "display_name": "PIPD-LS-SP Public Skills"
      }
    },
    "com.pipd.s4": {
      "schema": "PIPD-PUBLIC-PLUGIN-MANIFEST/1",
      "plugin_id": "pipd-ls-sp-public-skills",
      "display_name": "PIPD-LS-SP Public Skills",
      "version": "0.1.1",
      "license": "Apache-2.0",
      "skills": [
        "pipd-assurance-tqaep",
        "pipd-authority-source",
        "pipd-execution-contract",
        "pipd-package-project",
        "pipd-pd-bind",
        "pipd-pi-compile",
        "pipd-profile-tailor",
        "pipd-route-intake"
      ],
      "official_schema_sha256": "0a4aad95ce337878ad38802ebf0daa3fde76abe3f65400c86bcbb1ec0b3ab883",
      "publisher": {
        "name": "OWNER_INPUT_REQUIRED",
        "identity": "OWNER_INPUT_REQUIRED",
        "identity_sha256": "OWNER_INPUT_REQUIRED"
      },
      "icons": [
        {
          "path": "assets/icon-128.png",
          "sha256": "OWNER_INPUT_REQUIRED",
          "size": 128
        }
      ],
      "release": {
        "claim_ceiling": "LOCAL_PACKAGER_PASS_ONLY",
        "official_portal_verification": "NOT_EXECUTED"
      }
    }
  }
}
